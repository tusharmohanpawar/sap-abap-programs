*----------------------------------------------------------------------*
FORM excelfile .

  DATA: BEGIN OF i_excel OCCURS 5.
          INCLUDE STRUCTURE zsdc000043.
        DATA: END OF i_excel.
  DATA: fechat(10).
  DATA: importet(20).
  FIELD-SYMBOLS: <fs> TYPE any.
  DATA: lv_file TYPE string.
  DATA: lv_path_var TYPE string.


  DATA : lv_file_name LIKE rlgrap-filename.
  DATA : empty(1),
         fcnt       TYPE i,
         fpos       TYPE i,
         cfpos      TYPE i,
         feld(1000).

  DATA: BEGIN OF ldata OCCURS 100.
          INCLUDE STRUCTURE rsaqldata.
        DATA: END OF ldata,
        maxpos TYPE i.
  FIELD-SYMBOLS: <feld>,
                 <cfeld>.
  DATA: l_pos TYPE i.
  DATA: l_length    TYPE i,
        l_number(3) TYPE n,
        l_pos_f     TYPE i.
  DATA: text1 TYPE char100.
  DATA:   li_fcat TYPE slis_t_fieldcat_alv WITH HEADER LINE.
  CONSTANTS: bufferlength TYPE i VALUE 1024.
  CONSTANTS: lc_tab TYPE x VALUE '09'.
  REFRESH ldata.


  CALL FUNCTION 'REUSE_ALV_FIELDCATALOG_MERGE'
    EXPORTING
      i_structure_name   = 'ZSDC000043'
      i_bypassing_buffer = 'X'
    CHANGING
      ct_fieldcat        = li_fcat[].



  LOOP AT i_tabl.



*oonverion moneda
    MOVE-CORRESPONDING i_tabl TO i_excel.
    CLEAR ldata.
    maxpos = 0.
    fcnt = 0.
    LOOP AT  li_fcat INTO ls_fieldcat.
      fcnt = fcnt + 1.
      IF fcnt <> 1.
        l_pos = maxpos + 1.
        IF l_pos > bufferlength.
          APPEND ldata.
          CLEAR ldata.
          maxpos = 0.
        ENDIF.
        maxpos = maxpos + 1.
      ENDIF.

      fpos = ls_fieldcat-col_pos.
      ASSIGN COMPONENT fpos OF STRUCTURE i_excel TO <feld>.
      CASE    ls_fieldcat-datatype.
        WHEN 'CHAR'.
          WRITE <feld> TO feld.
          CALL FUNCTION 'SCP_REPLACE_STRANGE_CHARS'
            EXPORTING
              intext  = feld
            IMPORTING
              outtext = feld.
        WHEN 'DATS'.
          MOVE <feld> TO fechat.
          WRITE fechat TO feld.
        WHEN 'CURR'.
          MOVE <feld> TO feld.
          REPLACE '.' WITH  ',' INTO feld.
        WHEN OTHERS.
          WRITE <feld> TO feld.
      ENDCASE.
      SHIFT feld LEFT DELETING LEADING space.
      l_length = strlen( feld ).
      l_number = l_length.
      l_pos_f = maxpos + l_length + 1.

      IF l_pos > bufferlength.
        APPEND ldata.
        CLEAR ldata.
        maxpos = 0.
      ENDIF.

      IF fcnt = 1.
        ldata =  feld.
      ELSE.
        CONCATENATE ldata feld INTO ldata SEPARATED BY cl_abap_char_utilities=>horizontal_tab.
      ENDIF.
      maxpos = maxpos + strlen( l_number ) + 1 + l_length.
    ENDLOOP.

    APPEND ldata.
    CLEAR ldata.
  ENDLOOP.
  DATA: fecha(14).
  CONCATENATE sy-datum sy-uzeit INTO fecha.
*vemos si hay que montar el nombre del fichero
  MOVE fichero TO  lv_file.
  IF lv_file CS '$'.
    REPLACE '$' WITH fecha INTO lv_file.
  ENDIF.

  lv_file_name = lv_file.


  OPEN DATASET lv_file_name FOR OUTPUT IN TEXT MODE ENCODING NON-UNICODE.
  IF sy-subrc = 0.


    LOOP AT ldata.

      TRANSFER ldata TO lv_file_name.
    ENDLOOP.


    CLOSE DATASET lv_file_name.
  ELSE.

    MESSAGE e222(s_dx_bapi) WITH lv_file_name.
*   Fichero &1 ya había sido abierto

  ENDIF.
ENDFORM.                    " EXCELFILE

