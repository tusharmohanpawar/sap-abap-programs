*&---------------------------------------------------------------------*
*&      Form  OBTENER_CONDICIONES
*&---------------------------------------------------------------------*
*  Se obtienen las condiciones de selección
*----------------------------------------------------------------------*
*      -->PE_LOW                                                       *
*      -->PE_HIGH                                                      *
*      -->PE_OPTION                                                    *
*      -->PE_TEXT                                                      *
*----------------------------------------------------------------------*
FORM obtener_condiciones USING    pe_low
                                  pe_high
                                  pe_option
                                  pe_texto.

  CASE pe_option.
    WHEN 'BT'.
      CONCATENATE pe_texto ' BETWEEN ''' pe_low ''' AND '''
                         pe_high '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'NB'.
      CONCATENATE pe_texto ' NOT BETWEEN ''' pe_low ''' AND '''
                         pe_high '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'EQ'.
      CONCATENATE pe_texto ' = ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'NE'.
      CONCATENATE pe_texto ' <> ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'GE'.
      CONCATENATE pe_texto ' >= ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'LE'.
      CONCATENATE pe_texto ' <= ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'GT'.
      CONCATENATE pe_texto ' > ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'LT'.
      CONCATENATE pe_texto ' < ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'CP'.
      TRANSLATE pe_low USING '*%'.
      CONCATENATE pe_texto ' LIKE ''' pe_low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
    WHEN 'NP'.
      TRANSLATE pe_low USING '*%'.
      CONCATENATE pe_texto ' NOT LIKE ''' s_matnr-low '''' INTO i_tab.
      CONCATENATE d_or i_tab INTO i_tab SEPARATED BY space.
      d_or = 'OR '.
      APPEND i_tab.
  ENDCASE.

