*&---------------------------------------------------------------------*
*&      Form  VALIDAR_ORGANIZACION
*&---------------------------------------------------------------------*
* Se comprueba que la organización de ventas exista
*----------------------------------------------------------------------*
FORM validar_organizacion.

* Valida el centro desde
  SELECT SINGLE * FROM tvko
    WHERE vkorg = s_vkorg-low.

* Error si no existe la organización de ventas
  IF sy-subrc <> 0.
    MESSAGE e037 WITH s_vkorg-low.
  ENDIF.

* Valida el centro hasta
  IF s_vkorg-high <> ''.
    IF s_werks IS INITIAL.
    ELSE.
* Si se indica centro, poner sólo una org.ventas.
      MESSAGE ID 'VL' TYPE 'E' NUMBER '090'.
    ENDIF.
    SELECT SINGLE * FROM tvko
      WHERE vkorg = s_vkorg-high.

* Error si no existe la organización de ventas
    IF sy-subrc <> 0.
      MESSAGE e037 WITH s_vkorg-high.
    ENDIF.
  ENDIF.

ENDFORM.                    "VALIDAR_ORGANIZACION

*&---------------------------------------------------------------------*
*&      Form  VALIDAR_CLIENTE
*&---------------------------------------------------------------------*
* Se comprueba que el cliente exista
*----------------------------------------------------------------------*
FORM validar_cliente.

  SELECT SINGLE * FROM kna1
    WHERE kunnr IN s_kunnr.

* Error si no existe el cliente
  IF sy-subrc <> 0.
    MESSAGE ID 'IM' TYPE 'E' NUMBER '706'.
  ENDIF.

ENDFORM.                    "VALIDAR_CLIENTE

*&---------------------------------------------------------------------*
*&      Form  VALIDAR_CONDICION
*&---------------------------------------------------------------------*
* Se comprueba que la condición de precio exista
*----------------------------------------------------------------------*
FORM validar_condicion.

  DATA:
    l_d_lineas LIKE sy-tabix.
* 1 obtener todas las condicones.
  CLEAR i_kschl.
  REFRESH i_kschl.
  SELECT  * FROM  t685a WHERE kappl = c_kappl_v
                             AND   kschl IN s_kschl
                             AND ( koaid = 'B' OR  koaid = 'A' ) .
    i_kschl = t685a-kschl.
    APPEND i_kschl.
  ENDSELECT.
* Inicio ASM 4.12.2000
*  SELECT SINGLE * FROM A005
*    WHERE KSCHL IN S_KSCHL.
* Obtener las condiciones de precio que cumplen las condiciones de
* selección
* Vamos a dejar tambien sacar la condicion ZPRE de presupuestacion.
  LOOP AT i_kschl.
*  CLEAR I_KSCHL.
*  REFRESH I_KSCHL.
    IF i_kschl NE 'ZPRE'.
* buscamos sus esquemas de precios.
      CLEAR t683v.
      SELECT kalsm FROM t683v
                   INTO t683v-kalsm
                  WHERE vkorg IN s_vkorg.
* buscamos las condiciones de los esquemas de precios.
        CLEAR t683s.
        SELECT SINGLE * FROM t683s
                    WHERE kvewe = c_kvewe_a
                      AND kappl = c_kappl_v
                      AND kalsm = t683v-kalsm
                      AND kschl = i_kschl-kschl.
        IF sy-subrc = 0.
          EXIT.
        ENDIF.
*      IF T683S-KSCHL(1) = 'Z'.
*        I_KSCHL-KSCHL = T683S-KSCHL.
**        APPEND I_KSCHL.
**        CLEAR I_KSCHL.
*      ELSE.
*        CLEAR T685A.
*        SELECT SINGLE * FROM T685A
*                        WHERE KAPPL = C_KAPPL_V
*                          AND KSCHL = T683S-KSCHL
*                          AND KOAID = 'B'.
*        IF SY-SUBRC = 0.
*          I_KSCHL-KSCHL = T683S-KSCHL.
*          APPEND I_KSCHL.
*          CLEAR I_KSCHL.
*        ENDIF.
*      ENDIF.
      ENDSELECT.
      IF sy-subrc NE 0.
        DELETE i_kschl.
      ENDIF.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE i_kschl LINES l_d_lineas.

* Fin ASM 4.12.2000

* Error si no existe la condición del precio
  IF l_d_lineas IS INITIAL AND NOT s_kschl IS INITIAL.
    MESSAGE e148 WITH s_kschl.
  ENDIF.

ENDFORM.                    "VALIDAR_CONDICION

