FORM cal_cambio .
  DATA: d_tipo_cambio TYPE ukurs_curr.
  READ TABLE i_tabl.
  SELECT SINGLE * FROM zmt001w WHERE werks = i_tabl-vkorg.
  LOOP AT i_tabl.
    IF i_tabl-konwa <> zmt001w-waers.
      CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
        EXPORTING
          date             = sy-datum
          foreign_amount   = i_tabl-kbetr
          foreign_currency = i_tabl-konwa
          local_currency   = zmt001w-waers
          type_of_rate     = 'M'
        IMPORTING
          exchange_rate    = d_tipo_cambio
          local_amount     = i_tabl-kbetrc
        EXCEPTIONS
          no_rate_found    = 1
          overflow         = 2
          no_factors_found = 3
          no_spread_found  = 4
          OTHERS           = 5.
      IF sy-subrc <> 0.
        i_tabl-kbetrc = i_tabl-kbetr.
      ELSE.
        i_tabl-konwac = zmt001w-waers.
        i_tabl-rate = d_tipo_cambio.
      ENDIF.

    ELSE.
*COMO LA MONEDA ES LA MISMA SE COPIA
      i_tabl-kbetrc = i_tabl-kbetr.
      i_tabl-konwac = i_tabl-konwa.
    ENDIF.
    MODIFY i_tabl.
  ENDLOOP.
ENDFORM.                    " CAL_CAMBIO
