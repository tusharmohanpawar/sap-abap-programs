FORM f_create_document.
* Rellenamos la tabla bdcdata con los datos para el inventario.
  PERFORM cabecera.

* Incluimos máximo 300 materiales en cada documento, para ello usamos un
* contador.
  CLEAR contador.
  ADD 1 TO contador.
  SORT datos BY werks lgort.
  "Cogemos sólo los registros sin error
  LOOP AT datos
    WHERE error <> 'X'.

*    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*      EXPORTING
*        input  = datos-charg
*      IMPORTING
*        output = datos-char


* ABG Inc 118802 quitamos la conversión para que no meta los ceros delante dependiento dle parámetro de selección 30.10.2018
    IF p_charg IS INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = datos-charg
        IMPORTING
          output = datos-charg.
    ENDIF.
* ABG Fin 118802 30.10.2018



    IF contador GT '300'.
*      Grabamos el documento anterior.
      PERFORM grabar_documento.

      CLEAR bdcdata.
      REFRESH bdcdata.

*      Generamos uno nuevo.
      PERFORM cabecera.

*      Primera posición
      PERFORM anadir_posicion.

      CLEAR contador.
      ADD 1 TO contador.
    ELSE.
      PERFORM anadir_posicion.
      ADD 1 TO contador.
    ENDIF.
    AT END OF lgort.
*      Grabamos el documento anterior.
      PERFORM grabar_documento.

      CLEAR bdcdata.
      REFRESH bdcdata.

*      Generamos uno nuevo.
      PERFORM cabecera.
    ENDAT.
  ENDLOOP.

** Grabamos el último documento
*  PERFORM grabar_documento.
ENDFORM.                    "f_create_document
