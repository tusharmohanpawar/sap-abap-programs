*----------------------------------------------------------------------*
FORM actualizar_marcados.
  DATA: d_linea    LIKE sy-index, " Línea en el listado
        l_d_indice LIKE sy-index.    " Índice de la tabla interna

  LOOP AT i_doc_inven.
    CLEAR i_doc_inven-marca.
    MODIFY i_doc_inven.
  ENDLOOP.

  d_linea = 11.
  DO.
    CLEAR i_doc_inven-marca.
    READ LINE d_linea FIELD VALUE i_doc_inven-marca.
    IF sy-subrc <> 0.
      EXIT.
    ELSE.
      IF i_doc_inven-marca = 'X'.
        l_d_indice = d_linea - 10.
        READ TABLE i_doc_inven INDEX l_d_indice.
        i_doc_inven-marca = 'X'.
        MODIFY i_doc_inven INDEX l_d_indice.
      ENDIF.

      ADD 1 TO d_linea.
    ENDIF.
  ENDDO.

ENDFORM.                    " actualizar_marcados
