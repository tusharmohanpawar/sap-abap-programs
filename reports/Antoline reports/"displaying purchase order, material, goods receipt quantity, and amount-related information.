            IF sy-subrc NE 0.
              IF NOT mchb-sperc IS INITIAL.
                SELECT SINGLE * FROM iseg WHERE
                          matnr = datos-matnr
                    AND   werks = datos-werks
                    AND   lgort = datos-lgort
                    AND   charg = datos-charg
                    AND   bstar = datos-t_stock
                    AND   xdiff = space.
                IF sy-subrc = 0.
                  MOVE-CORRESPONDING datos TO error_datos.
                  MOVE: 'E' TO error_datos-err,
                        TEXT-100 TO error_datos-texto.
                  APPEND error_datos.
                  DELETE datos.
                  CONTINUE.
                ENDIF.
              ENDIF.
            ELSE.
*I would add that if there is no record in MHB, you should check MKOL.
              SELECT SINGLE * FROM mkol
                 WHERE matnr =  datos-werks
                 AND   lgort = datos-lgort
                 AND charg = datos-charg.

              IF sy-subrc NE 0.
                IF NOT mkol-spers IS INITIAL.
                  SELECT SINGLE * FROM iseg WHERE
                            matnr = datos-matnr
                      AND   werks = datos-werks
                      AND   lgort = datos-lgort
                      AND   charg = datos-charg
                      AND   bstar = datos-t_stock
                      AND   xdiff = space.
                  IF sy-subrc = 0.
                    MOVE-CORRESPONDING datos TO error_datos.
                    MOVE: 'E' TO error_datos-err,
                          TEXT-100 TO error_datos-texto.
                    APPEND error_datos.
                    DELETE datos.
                    CONTINUE.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.

          ELSE.
            SELECT SINGLE * FROM mard
                WHERE matnr = datos-matnr
                AND   werks = datos-werks
                AND   lgort = datos-lgort.

*      We store it in an error table.
            IF NOT mard-sperr IS INITIAL.
              SELECT SINGLE * FROM iseg WHERE
                        matnr = datos-matnr
                  AND   werks = datos-werks
                  AND   lgort = datos-lgort
                  AND   bstar = datos-t_stock
                  AND   xdiff = space.
              IF sy-subrc = 0.
                MOVE-CORRESPONDING datos TO error_datos.
                MOVE: 'E' TO error_datos-err,
                      TEXT-100 TO error_datos-texto.
                APPEND error_datos.
                DELETE datos.
                CONTINUE.
              ENDIF.
            ENDIF.
          ENDIF.
*     INVENTARIO STOCK SUBCONTRATISTA O EMB. RETORNABLE EN PROVEEDOR
        WHEN 'O' OR 'M'.
          SELECT SINGLE * FROM mslb
                WHERE matnr = datos-matnr
                AND   werks = datos-werks
                AND   lifnr = p_lifnr
                AND   charg = datos-charg"space
                AND   sobkz = p_tipo.
*       Store it in the error table.
          IF NOT mslb-lbspr IS INITIAL.
            MOVE-CORRESPONDING datos TO error_datos.
            MOVE: 'E' TO error_datos-err,
                  TEXT-100 TO error_datos-texto.
            APPEND error_datos.
            DELETE datos.
            CONTINUE.
          ENDIF.
*Mod. Javi Arce. Jan13. Internal Correction. Vendor Consignment Inventory
*     VENDOR CONSIGNMENT STOCK INVENTORY
        WHEN 'K'.
          SELECT SINGLE * FROM mkol
                WHERE matnr = datos-matnr
                AND   werks = datos-werks
                AND   lifnr = p_lifnr
                AND   charg = datos-charg"space
                AND   sobkz = p_tipo.
*       Store it in the error table.
          IF NOT mkol-spers IS INITIAL.
            MOVE-CORRESPONDING datos TO error_datos.
            MOVE: 'E' TO error_datos-err,
                  TEXT-100 TO error_datos-texto.
            APPEND error_datos.
            DELETE datos.
            CONTINUE.
          ENDIF.
*End Mod. Javi Arce. Jan13.
*     CUSTOMER CONSIGNMENT STOCK INVENTORY / RETURNABLE PACKAGING AT CUSTOMER
        WHEN 'W' OR 'V'.
          SELECT SINGLE * FROM msku
                WHERE matnr = datos-matnr
                AND   werks = datos-werks
                AND   kunnr = p_kunnr
                AND   charg = datos-charg"space
                AND   sobkz = p_tipo.
*       Store it in the error table.
          IF NOT msku-kuspr IS INITIAL.
            MOVE-CORRESPONDING datos TO error_datos.
            MOVE: 'E' TO error_datos-err,
                  TEXT-100 TO error_datos-texto.
            APPEND error_datos.
            DELETE datos.
            CONTINUE.
          ENDIF.

      ENDCASE.
    ENDLOOP.

* Populate the BDCDATA table with the inventory data.
    PERFORM cabecera.

* Include a maximum of 300 materials in each document; for this purpose, use a
* counter.
    CLEAR contador.
    ADD 1 TO contador.
    LOOP AT datos.

      IF contador GT '300'.
*      Save the previous document.
        PERFORM grabar_documento.

        CLEAR bdcdata.
        REFRESH bdcdata.

*      Generate a new one.
        PERFORM cabecera.

*      First item
        PERFORM anadir_posicion.

        CLEAR contador.
        ADD 1 TO contador.
      ELSE.
        PERFORM anadir_posicion.
        ADD 1 TO contador.
      ENDIF.
    ENDLOOP.

* Save the last document.
    PERFORM grabar_documento.
  ENDIF.

