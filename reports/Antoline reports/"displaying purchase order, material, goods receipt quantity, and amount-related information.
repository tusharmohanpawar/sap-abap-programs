FORM mensajes_mi10.
* Guardamos el mensaje obtenido al ejecutar el call.

  DATA: err_n(3) TYPE n.
  DATA: lineas TYPE i.
  DATA: inven LIKE i_doc_inven-cod.


  LOOP AT messtab.
    CLEAR err_n.
    MOVE messtab-msgnr TO err_n.

    CALL FUNCTION 'WRITE_MESSAGE'
      EXPORTING
        msgid  = messtab-msgid
        msgno  = err_n
        msgty  = messtab-msgtyp
        msgv1  = messtab-msgv1
        msgv2  = messtab-msgv2
        msgv3  = messtab-msgv3
        msgv4  = messtab-msgv4
*       MSGV5  = ' '
      IMPORTING
*       ERROR  =
        messg  = r_message
*       MSGLN  =
      EXCEPTIONS
        OTHERS = 1.

    CLEAR error_datos.
    MOVE: messtab-msgtyp    TO error_datos-err,
          r_message-msgtx   TO error_datos-texto.
*    el mensaje con el numero del documento de inventario
    IF messtab-msgtyp EQ 'S'.
*      sera el del ultimo registro metido
      DESCRIBE TABLE i_doc_inven LINES lineas.
      PERFORM coger_inven USING r_message-msgtx
                          CHANGING inven.
      READ TABLE i_doc_inven INDEX lineas.
      i_doc_inven-cod = inven.
      MODIFY i_doc_inven INDEX lineas.
    ENDIF.
    APPEND error_datos.
  ENDLOOP.

ENDFORM.                    " MENSAJES_MI10

