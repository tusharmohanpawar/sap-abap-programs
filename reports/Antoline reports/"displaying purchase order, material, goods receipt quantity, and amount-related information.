*&---------------------------------------------------------------------*
*&      Form  f_check_material
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_check_material.
  DATA: i TYPE i VALUE 0.
  DATA: aux_datos LIKE datos OCCURS 0 WITH HEADER LINE.
  LOOP AT datos.
    i = i + 1.
    datos-posicion = i.
    CONDENSE: datos-matnr,
              datos-lgort,
              datos-werks,
              datos-t_stock,
              datos-erfme.
    TRANSLATE datos-werks TO UPPER CASE.
    TRANSLATE datos-lgort TO UPPER CASE.
    MODIFY datos.
  ENDLOOP.
  DATA: d_lgort(5)   TYPE c.

  aux_datos[] = datos[].
  LOOP AT datos.
    REFRESH datos-color.
    CLEAR ls_color-color-col.
    datos-error = ''.
    datos-icon = '@08@'.
    ls_color-color-col = 3.
    IF d_lgort IS INITIAL.
      d_lgort = datos-lgort.
    ENDIF.
    IF d_lgort <> datos-lgort.
      "Si se ha cambiado de almacén
      d_error = 'X'. datos-error = 'X'.
      datos-icon = '@0A@'.
      ls_color-color-col = 6.
      datos-msgtext = TEXT-e15.
    ELSE.
      " Chequeamos si el material existe
      SELECT SINGLE *
      FROM mara
      WHERE matnr = datos-matnr.
      IF sy-subrc <> 0.
        d_error = 'X'. datos-error = 'X'.
        datos-icon = '@0A@'.
        ls_color-color-col = 6.
        CONCATENATE TEXT-e01 datos-matnr TEXT-e02 INTO datos-msgtext SEPARATED BY space.
      ELSE.
        " Chequeamos si el centro existe
        SELECT SINGLE *
        FROM t001w
        WHERE werks = datos-werks.
        IF sy-subrc <> 0.
          d_error = 'X'. datos-error = 'X'.
          datos-icon = '@0A@'.
          ls_color-color-col = 6.
          CONCATENATE TEXT-e05 datos-werks TEXT-e02 INTO datos-msgtext SEPARATED BY space.
        ELSE.
          "Si no se ha seleccionado stock de tipo especial, o es de consigna de proveedor
          IF p_tipo IS INITIAL OR p_tipo = 'K'.
            " Chequeamos si el almacén existe
            SELECT SINGLE *
            FROM t001l
            WHERE werks = datos-werks
              AND lgort = datos-lgort.
          ENDIF.


          IF sy-subrc <> 0.
            d_error = 'X'. datos-error = 'X'.
            datos-icon = '@0A@'.
            ls_color-color-col = 6.
            CONCATENATE TEXT-e06 datos-lgort TEXT-e02 TEXT-e03 datos-werks INTO datos-msgtext SEPARATED BY space.
          ELSE.
            " Chequeamos si la unidad de medida existe
            IF datos-erfme IS NOT INITIAL.
              SELECT SINGLE msehi INTO datos-msehi
              FROM t006a
              WHERE mseh3 = datos-erfme
                AND spras = sy-langu.
            ENDIF.
            IF sy-subrc <> 0.
              d_error = 'X'. datos-error = 'X'.
              datos-icon = '@0A@'.
              ls_color-color-col = 6.
              CONCATENATE TEXT-e08 datos-erfme TEXT-e02 INTO datos-msgtext SEPARATED BY space.
            ELSE.
              "Chequeamos si el tipo de stock existe (Tipos 1, 2, 3 y 4)
              IF datos-t_stock <> 1 AND datos-t_stock <> 2 AND datos-t_stock <> 3 AND datos-t_stock <> 4.
                d_error = 'X'. datos-error = 'X'.
                datos-icon = '@0A@'.
                ls_color-color-col = 6.
                CONCATENATE TEXT-e07 datos-t_stock TEXT-e02 INTO datos-msgtext SEPARATED BY space.
              ELSE.
                " Chequeamos si el material existe para el centro.
                SELECT SINGLE *
                FROM marc
                WHERE matnr = datos-matnr
                  AND werks = datos-werks.
                IF sy-subrc <> 0.
                  d_error = 'X'. datos-error = 'X'.
                  datos-icon = '@0A@'.
                  ls_color-color-col = 6.
                  CONCATENATE TEXT-e01 datos-matnr TEXT-e02 TEXT-e03 datos-werks INTO datos-msgtext SEPARATED BY space.
                ELSE.
                  "Chequeamos que el material no esté obsoleto
*                IF marc-mmsta = 'ZT'.
*                  d_error = 'X'. datos-error = 'X'.
*                  datos-icon = '@0A@'.
*                  ls_color-color-col = 6.
*                  CONCATENATE text-e01 datos-matnr text-e09 INTO datos-msgtext SEPARATED BY space.
*                ELSE.
*                  "Chequeamos que el material no sea de Consumo Lento
*                  IF marc-mmsta = 'CL'.
*                    d_error = 'X'. datos-error = 'X'.
*                    datos-icon = '@0A@'.
*                    ls_color-color-col = 6.
*                    CONCATENATE text-e01 datos-matnr text-e12 INTO datos-msgtext SEPARATED BY space.
*                  ELSE.
                  "Chequeamos que el material permita la unidad de medida indicada
                  IF datos-msehi IS NOT INITIAL.
                    SELECT SINGLE *
                    FROM marm
                    WHERE matnr = datos-matnr
                      AND meinh = datos-msehi.
                  ENDIF.
                  IF sy-subrc <> 0.
                    d_error = 'X'. datos-error = 'X'.
                    datos-icon = '@0A@'.
                    ls_color-color-col = 6.
                    CONCATENATE TEXT-e01 datos-matnr TEXT-e13 datos-msehi INTO datos-msgtext SEPARATED BY space.
                  ELSE.
                    "Si no se ha seleccionado stock de tipo especial, o es de consigna de proveedor
                    IF p_tipo IS INITIAL OR p_tipo = 'K'.
                      "Chequeamos que el material existe en el almacén
                      IF datos-charg IS NOT INITIAL .
                        SELECT SINGLE * FROM mchb
                                        WHERE matnr = datos-matnr
                                          AND werks = datos-werks
                                          AND lgort = datos-lgort
                                          AND charg = datos-charg.
* ABG CISD254-62 13.02.2025
                        IF sy-subrc NE 0.
                          SELECT SINGLE * FROM mkol
                                          WHERE matnr = datos-matnr
                                            AND werks = datos-werks
                                            AND lgort = datos-lgort
                                            AND charg = datos-charg.
                        ENDIF.
* ABG Fin CISD254-62 13.02.2025
                      ELSE.
                        SELECT SINGLE *
                        FROM mard
                        WHERE matnr = datos-matnr
                          AND werks = datos-werks
                          AND lgort = datos-lgort.
                      ENDIF..
                    ENDIF.
                    IF sy-subrc <> 0.
                      d_error = 'X'. datos-error = 'X'.
                      datos-icon = '@0A@'.
                      ls_color-color-col = 6.
                      CONCATENATE TEXT-e01 datos-matnr TEXT-e02 TEXT-e04 datos-lgort INTO datos-msgtext SEPARATED BY space.
                    ELSE.
                      "Chequeamos si existe un documento de inventario activo
                      CASE p_tipo.
                          "INVENTARIO ALMACEN.
                        WHEN space.
*                          IF NOT mard-sperr IS INITIAl  .
                          IF NOT mard-sperr IS INITIAL OR  ( NOT mchb-sperc IS INITIAL OR NOT mkol-spers IS INITIAL ).
                            SELECT SINGLE *
                            FROM iseg
                            WHERE matnr = datos-matnr
                              AND werks = datos-werks
                              AND lgort = datos-lgort
                              AND charg = datos-charg
                              AND bstar = datos-t_stock
                              AND xdiff = space
                              AND xloek = space.

                            IF sy-subrc = 0.
                              d_error = 'X'. datos-error = 'X'.
                              datos-icon = '@0A@'.
                              ls_color-color-col = 6.
                              CONCATENATE TEXT-e01 datos-matnr TEXT-e10 iseg-iblnr INTO datos-msgtext SEPARATED BY space.
                            ENDIF.
                          ENDIF.
                          "INVENTARIO STOCK SUBCONTRATISTA / EMB.RETORNABLE DE PROVEEDOR
                        WHEN 'O' OR 'M'.
                          SELECT SINGLE *
                          FROM mslb
                          WHERE matnr = datos-matnr
                            AND werks = datos-werks
                            AND lifnr = p_lifnr
                            AND sobkz = p_tipo.
                          IF sy-subrc <> 0.
                            d_error = 'X'. datos-error = 'X'.
                            datos-icon = '@0A@'.
                            ls_color-color-col = 6.
                            CONCATENATE TEXT-e01 datos-matnr TEXT-e14 p_tipo INTO datos-msgtext SEPARATED BY space.
                          ELSE.

                            SELECT SINGLE *
                            FROM mslb
                            WHERE matnr = datos-matnr
                              AND werks = datos-werks
                              AND lifnr = p_lifnr
                              AND charg = datos-charg"space
                              AND sobkz = p_tipo.
                            IF NOT mslb-lbspr IS INITIAL.
                              d_error = 'X'. datos-error = 'X'.
                              datos-icon = '@0A@'.
                              ls_color-color-col = 6.
                              CONCATENATE TEXT-e01 datos-matnr TEXT-e10 iseg-iblnr INTO datos-msgtext SEPARATED BY space.
                            ENDIF.
                          ENDIF.
*Mod.Javi Arce.Ene13.Corr.Interno.Inventario consigna proveedor
                          "INVENTARIO STOCK EN CONSIGNA DE PROVEEDOR
                        WHEN 'K'.
                          SELECT SINGLE *
                          FROM mkol
                          WHERE matnr = datos-matnr
                            AND werks = datos-werks
                            AND lifnr = p_lifnr
                            AND sobkz = p_tipo.
                          IF sy-subrc <> 0.
                            d_error = 'X'. datos-error = 'X'.
                            datos-icon = '@0A@'.
                            ls_color-color-col = 6.
                            CONCATENATE TEXT-e01 datos-matnr TEXT-e14 p_tipo INTO datos-msgtext SEPARATED BY space.
                          ELSE.

                            SELECT SINGLE *
                            FROM mkol
                            WHERE matnr = datos-matnr
                              AND werks = datos-werks
                              AND lifnr = p_lifnr
                              AND charg = datos-charg"space
                              AND sobkz = p_tipo.
                            IF NOT mkol-spers IS INITIAL.
                              SELECT SINGLE *
                            FROM iseg
                            WHERE matnr = datos-matnr
                              AND werks = datos-werks
                              AND lgort = datos-lgort
                              AND bstar = datos-t_stock
                              AND xdiff = space
                              AND xloek = space.
                              IF sy-subrc = 0.
                                d_error = 'X'. datos-error = 'X'.
                                datos-icon = '@0A@'.
                                ls_color-color-col = 6.
                                CONCATENATE TEXT-e01 datos-matnr TEXT-e10 iseg-iblnr INTO datos-msgtext SEPARATED BY space.
                              ENDIF.
                            ENDIF.
                          ENDIF.
*End Mod.Javi Arce.Ene13.
                          "INVENTARIO STOCK EN CONSIGNA DE CLIENTE O EMB.RETORNABLE EN CLIENTE
                        WHEN 'W' OR 'V'.
                          SELECT SINGLE *
                          FROM msku
                          WHERE matnr = datos-matnr
                            AND werks = datos-werks
                            AND kunnr = p_kunnr
                            AND sobkz = p_tipo.
                          IF sy-subrc <> 0.
                            d_error = 'X'. datos-error = 'X'.
                            datos-icon = '@0A@'.
                            ls_color-color-col = 6.
                            CONCATENATE TEXT-e01 datos-matnr TEXT-e14 p_tipo INTO datos-msgtext SEPARATED BY space.
                          ELSE.
                            SELECT SINGLE *
                            FROM msku
                            WHERE matnr = datos-matnr
                              AND werks = datos-werks
                              AND kunnr = p_kunnr
                              AND charg = space
                              AND sobkz = p_tipo.
                            IF NOT msku-kuspr IS INITIAL.
                              d_error = 'X'. datos-error = 'X'.
                              datos-icon = '@0A@'.
                              ls_color-color-col = 6.
                              CONCATENATE TEXT-e01 datos-matnr TEXT-e10 iseg-iblnr INTO datos-msgtext SEPARATED BY space.
                            ENDIF.
                          ENDIF.
                      ENDCASE.

                      IF datos-icon <> '@0A@'. "Si no ha habido error
                        "Chequeamos que no hay duplicados
                        LOOP AT aux_datos
                          WHERE matnr = datos-matnr
                            AND werks = datos-werks
                            AND lgort = datos-lgort
                            AND charg = datos-charg
                            AND t_stock = datos-t_stock
                            AND posicion <> datos-posicion.
                          EXIT.
                        ENDLOOP.
                        IF sy-subrc = 0. "Si hay duplicados
                          d_error = 'X'. datos-error = 'X'.
                          datos-icon = '@0A@'.
                          ls_color-color-col = 6.
                          MOVE TEXT-e11 TO datos-msgtext.
                        ENDIF.
                      ENDIF.
                    ENDIF.
*                  ENDIF.
*                  ENDIF.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
    APPEND ls_color TO datos-color.
    MODIFY datos.
  ENDLOOP.
ENDFORM.                    "f_check_material

