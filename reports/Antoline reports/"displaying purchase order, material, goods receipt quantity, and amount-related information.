FORM cabecera.
  CLEAR bdcdata.
  REFRESH bdcdata.
*CSDPASAPD-1514---06/11/2024.
* We changed the format of the date fields.
  DATA: f_fechad  TYPE char10.
  DATA: f_fechac  TYPE char10.

  WRITE p_fechad TO f_fechad.

  WRITE p_fechac TO f_fechac.

  CLEAR i_doc_inven.
* Home screen.
  PERFORM bdc_dynpro      USING 'SAPMM07I' '0700'.
  PERFORM bdc_field       USING 'BDC_CURSOR'
                                'IKPF-WERKS'.
  PERFORM bdc_field       USING 'BDC_OKCODE'
                                '/00'.
* IF usr01-datfm = '5'.
  PERFORM bdc_field       USING 'RM07I-ZLDAT'
                                 f_fechac.

  PERFORM bdc_field       USING 'RM07I-BLDAT'
                                f_fechad.

  i_doc_inven-p_fechac =  p_fechac.

* ELSE.
*  PERFORM bdc_field       USING 'RM07I-ZLDAT'
*                                p_fechac.

* PERFORM bdc_field       USING 'RM07I-BLDAT'
*                               p_fechad.

* i_doc_inven-p_fechac =  p_fechac.

* ENDIF.
  PERFORM bdc_field       USING 'IKPF-WERKS'
                                datos-werks.
  i_doc_inven-werks =  datos-werks.
* If we do a special stock inventory, we remove the storage.
  IF p_tipo IS INITIAL
    OR p_tipo = 'K'.

    PERFORM bdc_field       USING 'IKPF-LGORT'
                                  datos-lgort.
  ELSE.
    PERFORM bdc_field       USING 'IKPF-LGORT'
                                     ' '.
  ENDIF.

  CASE p_tipo.
    WHEN 'W' OR 'V' OR 'K' OR 'O' OR 'M'.
      PERFORM bdc_field       USING 'IKPF-SOBKZ'
                                      p_tipo.

  ENDCASE.

*    IF usr01-datfm = '5'.
*   MOVE: p_fechad TO aux.
*   CLEAR p_fechad.
*   MOVE: aux(4) TO p_fechad+4(4),
*         aux+4(2) TO p_fechad+2(2),
*         aux+6(2) TO p_fechad(2).
*   CLEAR aux.
*
*   MOVE: p_fechac TO aux.
*   CLEAR p_fechac.
*   MOVE: aux(4) TO p_fechac+4(4),
*         aux+4(2) TO p_fechac+2(2),
*         aux+6(2) TO p_fechac(2).
*   CLEAR aux.
*
*  ENDIF.


  APPEND i_doc_inven.
ENDFORM.                    " cabecera


