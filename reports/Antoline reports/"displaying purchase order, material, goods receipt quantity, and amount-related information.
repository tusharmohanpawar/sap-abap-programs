        MOVE: 'E' TO error_datos-err,
              TEXT-101 TO error_datos-texto.
        APPEND error_datos.
        DELETE datos.
        CONTINUE.
      ENDIF.

* Check whether the material exists for the plant.
      SELECT SINGLE * FROM marc
          WHERE matnr = datos-matnr
          AND   werks = datos-werks.

      IF sy-subrc NE 0.
        MOVE-CORRESPONDING datos TO error_datos.
        MOVE: 'E' TO error_datos-err,
              TEXT-102 TO error_datos-texto.
        APPEND error_datos.
        DELETE datos.
        CONTINUE.
