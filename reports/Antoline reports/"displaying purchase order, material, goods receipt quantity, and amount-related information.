*&---------------------------------------------------------------------*
*&      Form  OBTENER_DATOS_FICHERO
*&---------------------------------------------------------------------*
*   We load the file data into an internal table.
*----------------------------------------------------------------------*
FORM obtener_datos_fichero.
  REFRESH datos.
  CALL FUNCTION 'WS_UPLOAD'
    EXPORTING
      filename                = fichero
      filetype                = 'DAT'
    TABLES
      data_tab                = datos
    EXCEPTIONS
      conversion_error        = 1
      file_open_error         = 2
      file_read_error         = 3
      invalid_table_width     = 4
      invalid_type            = 5
      no_batch                = 6
      unknown_error           = 7
      gui_refuse_filetransfer = 8
      OTHERS                  = 9.

  IF sy-subrc NE 0.
    MESSAGE ID 'PC' TYPE 'E' NUMBER '028'.
  ENDIF.

ENDFORM.                    " OBTENER_DATOS_FICHERO
