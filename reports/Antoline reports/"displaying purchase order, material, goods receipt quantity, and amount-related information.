* Add items to the inventory document.
*----------------------------------------------------------------------*
FORM anadir_posicion.
  DATA: d_cant(16) TYPE p DECIMALS 4.

* Item with material and quantity.
  PERFORM bdc_dynpro      USING 'SAPMM07I' '0731'.
  PERFORM bdc_field       USING 'BDC_CURSOR'
                                'ISEG-ERFMG(01)'.
  PERFORM bdc_field       USING 'BDC_OKCODE'
                                '/00'.

* Depending on the inventory type, populate either the customer or the vendor.
  CASE p_tipo.
    WHEN 'W' OR 'V'.
      PERFORM bdc_field       USING 'ISEGK-KUNNR'
                                   p_kunnr.
    WHEN 'O' OR 'M'.
      PERFORM bdc_field       USING 'ISEGK-LIFNR'
                                    p_lifnr.
*Internal Correction. Vendor Consignment Inventory
    WHEN 'K'.
      PERFORM bdc_field       USING 'ISEGK-LIFNR'
                                    p_lifnr.

  ENDCASE.

  PERFORM bdc_field       USING 'ISEG-MATNR(01)'
                                datos-matnr.

