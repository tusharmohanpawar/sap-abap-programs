*----------------------------------------------------------------------*

FORM coger_inven USING message
                       CHANGING inven.
  DATA: inicio   TYPE i,
        fin      TYPE i,
        total    TYPE i,
        contador TYPE i,
        longitud TYPE i.

  CLEAR inven.
  contador = 0.
  longitud = strlen( message ).
*  WHILE contador < longitud.
*    IF message+contador(1) = '0' OR
*       message+contador(1) = '1' OR
*       message+contador(1) = '2' OR
*       message+contador(1) = '3' OR
*       message+contador(1) = '4' OR
*       message+contador(1) = '5' OR
*       message+contador(1) = '6' OR
*       message+contador(1) = '7' OR
*       message+contador(1) = '8' OR
*       message+contador(1) = '9'.
*      IF inicio IS INITIAL.
*        inicio = contador.
*      ELSE.
*        fin = contador.
*      ENDIF.
*    ENDIF.
*    ADD 1 TO contador.
*  ENDWHILE.
WHILE contador < longitud.
IF message+contador(1) BETWEEN '0' AND '9'.
IF inicio IS INITIAL.
inicio = contador.
ENDIF.
fin = contador.   " # always update fin to the latest digit position
ENDIF.
ADD 1 TO contador.
ENDWHILE.


  total = fin - inicio.
  ADD 1 TO total.
  inven = message+inicio(total).
*Si existe la palabra DYNPRO es que se ha producido un error en el BI
  IF message CP '*dynpro*'.
    CLEAR inven.
  ENDIF.
ENDFORM.                    "COGER_INVEN

