*&      Form  PASAR_ALV
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM pasar_alv.

  SORT i_linea_det ASCENDING BY fecha_inicial DESCENDING lifnr.
  LOOP AT i_linea_det.
    IF i_linea_det-fechar <> 0.
      i_linea_det-fecha_inicial = i_linea_det-fechar.
      MODIFY i_linea_det.
    ENDIF.

*    READ TABLE MOT WITH KEY KZUST = I_LINEA_DET-MODIF.
*    IF SY-SUBRC = 0.
    IF i_linea_det-modif IN motivo.
      IF i_linea_det-precio_prov <> 0 OR ( i_linea_det-precio_prov = 0 AND i_linea_det-repos = ' ' AND emrf = 'X' ).
        CLEAR i_alv.
        REFRESH i_alv-color.

        MOVE-CORRESPONDING i_linea_det TO i_alv.

        IF i_linea_det-proyecto = 'X'.
          i_alv-serie = 'P'.
        ELSE.
          i_alv-serie = 'S'.
        ENDIF.

*       pasamos los datos de la cabecera
        MOVE-CORRESPONDING i_materiales TO i_alv.
*       MOD e sobreescribe el contrato
        i_alv-ebeln = i_linea_det-ebeln.
*       FIN MOD
*       cogemos la descripcion
*        SELECT SINGLE * FROM makt WHERE matnr = i_alv-matnr
*                                  AND spras = sy-langu.
*        IF sy-subrc = 0.
*          i_alv-denominacion = makt-maktx.
*        ENDIF.
*Mod.Javi Arce.Sep15.PS372617.Denominación de material
*        i_alv-denominacion = i_materiales-descripcion.
        READ TABLE i_ekpo
        WITH KEY ebeln = i_alv-ebeln
                 ebelp = i_alv-ebelp.
        IF sy-subrc = 0.
          i_alv-denominacion = i_ekpo-txz01.
        ELSE.
          i_alv-denominacion = i_materiales-descripcion.
        ENDIF.
*End Mod.Javi Arce.Sep15.
*       miramos el color
        IF i_linea_det-fecha_inicial <= sy-datum AND
                   i_linea_det-fecha_fin >= sy-datum AND
                   i_linea_det-bloqueo = space.
*activo
          i_alv-color[] = it_specialcol.
        ELSE.

          REFRESH i_alv-color.

          IF  i_linea_det-bloqueo <> space.
            LOOP AT it_specialcol INTO ls_specialcol.
*bloqueado, ponemos el precio en color
              IF ls_specialcol-fieldname(3) = 'PRE'.
                ls_specialcol-color-col = 6.

                APPEND ls_specialcol TO i_alv-color.
              ENDIF.
            ENDLOOP.
          ELSE.
            REFRESH i_alv-color.
          ENDIF.
        ENDIF.



        IF ahorro = 'X'.

          syaux = sy-tabix + 1.
          READ TABLE i_linea_det INDEX syaux.
          IF sy-subrc = 0.
            i_alv-ahorro = ( i_linea_det-precio_efect -
                              i_alv-precio_efect ) / i_alv-base.
          ELSE.
            i_alv-ahorro = 0.
          ENDIF.

          can = 0.
          SELECT * FROM ekbe                  "#EC CI_ALL_FIELDS_NEEDED
                   WHERE ebeln = i_alv-ebeln AND ebelp = i_alv-ebelp
                     AND budat >= i_alv-fecha_inicial AND bewtp = 'E'.
            IF ekbe-shkzg = 'S'.
              can =  can + ekbe-menge.
            ELSE.
              can =  can - ekbe-menge.
            ENDIF.
          ENDSELECT.

          i_alv-importe = i_alv-ahorro * can.
*         ahorro en moneda local
          IF i_alv-moneda1 <> t001-waers.
            CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
              EXPORTING
                date             = i_alv-fecha_inicial
                foreign_amount   = i_alv-importe
                foreign_currency = i_alv-moneda1
                local_currency   = t001-waers
                type_of_rate     = 'M'
              IMPORTING
                local_amount     = i_alv-importe2
              EXCEPTIONS
                no_rate_found    = 1
                overflow         = 2
                no_factors_found = 3
                no_spread_found  = 4
                OTHERS           = 5.

            IF sy-subrc <> 0.
              i_alv-importe2 = i_alv-importe.
            ENDIF.
          ENDIF.

          i_alv-cantid =  can.

        ENDIF.

*       SOLICITUD DE COMPRA
        IF i_alv-bstyp = 'F'.
          SELECT SINGLE *                     "#EC CI_ALL_FIELDS_NEEDED
            FROM eket
           WHERE ebeln = i_alv-ebeln
             AND ebelp = i_alv-ebelp.
          IF sy-subrc = 0.
            i_alv-banfn = eket-banfn.
            i_alv-bnfpo = eket-bnfpo.
          ENDIF.
        ENDIF.

        IF i_alv-banfn <> ' ' AND i_alv-linea1 = space.
          SELECT SINGLE * FROM eban           "#EC CI_ALL_FIELDS_NEEDED
            WHERE banfn = i_alv-banfn AND bnfpo =
                                                              i_alv-bnfpo.
          IF sy-subrc = 0.
            value = eban-zcompra.

            CALL FUNCTION 'C_DIC_DOMAIN_VALUE_TEXT_READ'
              EXPORTING
                name      = 'ZCOMPRA'
                spras     = sy-langu
                value     = value
              IMPORTING
                text      = text
              EXCEPTIONS
                not_found = 7.
            IF sy-subrc <> 7.

              IF i_alv-bstyp = 'F'.
                CONCATENATE TEXT-220 text INTO i_alv-linea1
                   SEPARATED BY space.
                CONDENSE i_alv-linea1.
              ELSE.
                CONCATENATE TEXT-221 text INTO i_alv-linea1
                   SEPARATED BY space.
                CONDENSE i_alv-linea1.
              ENDIF.

            ENDIF.
          ENDIF.
        ENDIF.
        APPEND i_alv.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " PASAR_ALV

