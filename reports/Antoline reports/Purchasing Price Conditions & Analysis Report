*&---------------------------------------------------------------------*
*&      Form  MONEDA_SOCIEDAD
*&---------------------------------------------------------------------*
*  Buscamos la moneda de la sociedad para los importes de precios      *
* objetivos.
*----------------------------------------------------------------------*
FORM moneda_sociedad.
  LOOP AT i_materiales.
    SELECT SINGLE * FROM t001w WHERE werks = i_materiales-werks.
    IF sy-subrc = 0.
      i_materiales-bwkey = t001w-bwkey.
      SELECT SINGLE * FROM t001k WHERE bwkey = t001w-bwkey.
      IF sy-subrc = 0.
        SELECT SINGLE * FROM t001 WHERE bukrs = t001k-bukrs.
        IF sy-subrc = 0.
          i_materiales-waers = t001-waers.
          MODIFY i_materiales.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                               " MONEDA_SOCIEDAD
