  WRITE: 2 TEXT-005, i_materiales-matnr,
                      60 TEXT-024, 76 i_materiales-mtart, 83 TEXT-077,
93 i_linea_det-matkl.
  WRITE: /2 TEXT-006,17 i_materiales-descripcion,
                    60 TEXT-009, 76 i_materiales-meins.
  WRITE: /2 TEXT-007, i_materiales-vtext, 60 TEXT-010,
   76 i_materiales-zplp1 CURRENCY i_materiales-waers, i_materiales-waers
