*&      Form  USER_COMMAND
*&---------------------------------------------------------------------*

FORM user_command USING r_ucomm LIKE sy-ucomm
                    rs_selfield TYPE slis_selfield.

  DATA: d_answer(1),
        d_inversion TYPE p DECIMALS 4,
        d_fecha_fin LIKE sy-datum,
        d_aho_anu   TYPE p DECIMALS 4,
        d_aho_fin   TYPE p DECIMALS 4,
        d_fecha_has LIKE sy-datum.

*detalle amortizaciones y otros conceptos


  IF r_ucomm = 'ATRA'.
    SUBMIT zpuarcos WITH s_bukrs IN s_bukrs
                    WITH d_centro IN d_centro
                    WITH p_divisi EQ p_divisi
                    WITH p_compra IN s_ekgrp
                    WITH s_materi IN s_materi
                    WITH s_famili IN s_famili
                    WITH s_proved IN s_proved
                    WITH motivo IN motivo
                    WITH r_alv EQ r_alv
                    WITH r_lis EQ r_lis
                    WITH util EQ util
                    WITH c_user EQ c_user
                    WITH ahorro EQ ahorro
                    VIA SELECTION-SCREEN.


  ELSEIF r_ucomm = 'DELTA'.
*   Cogemos los valores.
    PERFORM coger_valores CHANGING d_answer d_inversion d_fecha_fin
                                   d_aho_anu d_aho_fin d_fecha_has.
    IF d_answer = ' '.
*     Calculamos los valores.
      PERFORM calcular_valores USING d_inversion d_fecha_fin
                                   d_aho_anu d_aho_fin d_fecha_has.

*     Añadir los campos
      PERFORM anadir_campos.

*     Mostramos el ALV
      PERFORM reuse_alv.
    ENDIF.


  ELSE.
    READ TABLE i_alv INDEX rs_selfield-tabindex.

    IF rs_selfield-fieldname = 'BANFN'.
      SET PARAMETER ID 'BAN' FIELD i_alv-banfn.
      SET PARAMETER ID 'BAP' FIELD i_alv-bnfpo.
      CALL TRANSACTION 'ME53' AND SKIP FIRST SCREEN.
    ELSE.
      CASE r_ucomm.
        WHEN 'AMO'.
          PERFORM listamor.
        WHEN 'REC'.
          PERFORM listared.
        WHEN OTHERS.
*     VISUALIZAR SC
          IF i_alv-bstyp = 'L'.
            IF i_alv-pstyp <> '2'.
              REFRESH i_bdcdata.
              PERFORM bdc_dynpro      USING 'SAPMM06E' '0205'.
              PERFORM bdc_field       USING 'BDC_CURSOR'
                                      'RM06E-EVRTN'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                      '/00'.
              PERFORM bdc_field       USING 'RM06E-EVRTN'
                                      i_alv-ebeln.
              PERFORM bdc_dynpro      USING 'SAPMM06E' '0220'.
              PERFORM bdc_field       USING 'BDC_CURSOR'
                                      'RM06E-EBELP'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                      '/00'.
              PERFORM bdc_field       USING 'RM06E-EBELP'
                                      i_alv-ebelp.
              PERFORM bdc_dynpro      USING 'SAPMM06E' '0220'.
              PERFORM bdc_field       USING 'BDC_CURSOR'
                                      'RM06E-EVRTP(01)'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                      '=KO'.
              PERFORM bdc_field       USING 'RM06E-EBELP'
                                      i_alv-ebelp.
              PERFORM bdc_field       USING 'RM06E-TCSELFLAG(01)'
                                      'X'.

              DATA: lv_tcode    LIKE sy-tcode,
                    lv_not_auth TYPE c.
              CALL FUNCTION 'ZCHECK_PURCH_AUTHORIZATION'
                EXPORTING
                  p_uname          = sy-uname
*                 P_MATKL          =
                  p_matnr          = i_alv-matnr
                  p_werks          = i_alv-werks
                IMPORTING
                  p_not_authorized = lv_not_auth.
              IF lv_not_auth = 'X'.
                lv_tcode = 'ME33L'.
              ELSE.
                lv_tcode = 'ME32L'.
              ENDIF.

              CALL TRANSACTION lv_tcode USING i_bdcdata MODE 'E'.
            ELSE.
              PERFORM bdc_dynpro      USING 'SAPMM06I' '0100'.
              PERFORM bdc_field       USING 'BDC_CURSOR'
                                            'RM06I-KONSI'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                            '/00'.
              PERFORM bdc_field       USING 'EINA-LIFNR'
                                            i_alv-lifnr.
              PERFORM bdc_field       USING 'EINA-MATNR'
                                            i_alv-matnr.
              PERFORM bdc_field       USING 'EINE-EKORG'
                                            'ira'.
              PERFORM bdc_field       USING 'EINE-WERKS'
                                            i_alv-werks.
              PERFORM bdc_field       USING 'RM06I-KONSI'
                                            'X'.
              PERFORM bdc_dynpro      USING 'SAPMM06I' '0101'.
              PERFORM bdc_field       USING 'BDC_CURSOR'
                                            'EINA-MAHN1'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                            '/00'.
              PERFORM bdc_dynpro      USING 'SAPMM06I' '0102'.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                            '=KO'.
              CALL TRANSACTION 'ME12' USING i_bdcdata MODE 'E'.
            ENDIF.
          ELSE.
            CALL FUNCTION 'ME_DISPLAY_PURCHASE_DOCUMENT'
              EXPORTING
                i_ebeln      = i_alv-ebeln
                i_enjoy      = 'X'
              EXCEPTIONS
                not_found    = 1
                no_authority = 2
                invalid_call = 3
                OTHERS       = 4.

          ENDIF.
      ENDCASE.
    ENDIF.
  ENDIF.
ENDFORM.                    "user_command


