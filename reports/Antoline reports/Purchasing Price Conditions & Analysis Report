*&---------------------------------------------------------------------*
*   Calculo de datos definitivos para la linea de detalle              *
*----------------------------------------------------------------------*
FORM datos_linea.
  REFRESH i_linea_det.
  REFRESH i_bom.
  LOOP AT i_ekpo WHERE matnr  = i_materiales-matnr AND werks =
i_materiales-werks AND bprme = i_materiales-meins.
    CLEAR i_linea_det.
    MOVE-CORRESPONDING i_ekpo TO i_linea_det.
    i_linea_det-lifnr = i_ekpo-lifnr.
*Descripción del proveedor
    SELECT SINGLE *                           "#EC CI_ALL_FIELDS_NEEDED
      FROM lfa1 WHERE lifnr = i_ekpo-lifnr.
    IF sy-subrc = 0.
      i_linea_det-name1 = lfa1-name1.
    ENDIF.
    IF i_ekpo-loekz <> space.
      i_linea_det-bloqueo = '*'.
    ENDIF.
    i_linea_det-observaciones = i_ekpo-observaciones.
*Guardamos el contrato y la posicion para la búsqueda de los
*subcontratados, pero estos datos no se imprimen.
    i_linea_det-ebeln = i_ekpo-ebeln.
    i_linea_det-bstyp = i_ekpo-bstyp.
    i_linea_det-ebelp = i_ekpo-ebelp.
    i_linea_det-pstyp = i_ekpo-pstyp.
    i_linea_det-txz01 = i_ekpo-txz01.
    i_linea_det-idnlf = i_ekpo-idnlf.
    i_linea_det-matkl = i_ekpo-matkl.

    LOOP AT i_condiciones WHERE lifnr = i_ekpo-lifnr
                          AND   ebeln = i_ekpo-ebeln
                          AND   ebelp = i_ekpo-ebelp.

      IF i_condiciones-loekz <> space.
        i_linea_det-bloqueo = '*'.
      ENDIF.
      i_linea_det-knumh = i_condiciones-knumh.
      i_linea_det-fecha_inicial = i_condiciones-fecha_inicial.
      i_linea_det-fecha_fin = i_condiciones-fecha_fin.
      i_linea_det-modif = i_condiciones-modif.
      i_linea_det-linea1 = i_condiciones-linea1.
      i_linea_det-linea2 = i_condiciones-linea2.
      i_linea_det-linea3 = i_condiciones-linea3.
      i_linea_det-linea4 = i_condiciones-linea4.
      i_linea_det-impuesto = i_condiciones-impuesto.
      i_linea_det-reper = i_condiciones-reper.
      i_linea_det-revno = i_condiciones-revno.
      i_linea_det-lccp = i_condiciones-lccp.
      i_linea_det-fechar = i_condiciones-fechar.
      i_linea_det-serie = i_condiciones-serie.
      i_linea_det-proyecto = i_condiciones-proyecto.

      i_linea_det-banfn = i_condiciones-banfn.
      i_linea_det-bnfpo = i_condiciones-bnfpo.
      i_linea_det-zicms = i_condiciones-zicms.
      i_linea_det-kosrt  = i_condiciones-kosrt.

      i_linea_det-base = i_condiciones-base.
      i_linea_det-moneda1 = i_condiciones-moneda1.
      i_linea_det-moneda2 = i_condiciones-moneda1.
      i_linea_det-username = i_condiciones-username.
      i_linea_det-userdate = i_condiciones-userdate.
      i_linea_det-utillaje = i_condiciones-utillaje.
      i_linea_det-monuti = i_condiciones-monuti.
*INCOTERMS
      IF i_condiciones-inco1 <> space.
        i_linea_det-inco1 = i_condiciones-inco1.
        i_linea_det-inco2 = i_condiciones-inco2.
      ELSE.
        i_linea_det-inco1 = i_ekpo-inco1.
        i_linea_det-inco2 = i_ekpo-inco2.
      ENDIF.
*28/06/2022 INC0578242 - AD añadir campo INDEXADO ini
      i_linea_det-indexed = i_condiciones-indexed.

*28/06/2022 INC0578242 - AD añadir campo INDEXADO fin
*Si no se encontró el porcentaje, la fecha aparecerá en blanco.
      i_linea_det-porcent = i_condiciones-porcent.
      IF i_condiciones-fecha_porcent IS INITIAL
         OR i_linea_det-porcent IS INITIAL.
        i_linea_det-fecha_porcent = space.
      ELSE.
        WRITE i_condiciones-fecha_porcent TO
                         i_linea_det-fecha_porcent DD/MM/YYYY.
      ENDIF.
*     IF i_condiciones-unidad_ped <> i_materiales-meins.
*       PERFORM conversion_unidades USING i_materiales-matnr
*                                         i_materiales-meins
*                                         i_condiciones-unidad_ped.
*     ELSE.
      d_factor_conversion = 1.
*     ENDIF.
*Precio en la linea de detalle de acuerdo con las unidades del material
*y del pedido.
      i_linea_det-precio_prov = i_condiciones-precio_prov
                                                  / d_factor_conversion.
      i_linea_det-precio_efect = i_condiciones-precio_efect
                                             / d_factor_conversion.
*Estos precios están en la base del pedido bruto. Si ésta no es mil., se
      i_linea_det-precio_fca = i_condiciones-precio_fca
                                             / d_factor_conversion.
      i_linea_det-precio_log = i_condiciones-precio_log
                                              / d_factor_conversion.
      i_linea_det-zlog = i_condiciones-zlog.
*pasa.
      IF i_condiciones-base <> 1000.
        i_linea_det-precio_prov = ( i_linea_det-precio_prov /
                                     i_condiciones-base ) * 1000.
        i_linea_det-precio_efect = ( i_linea_det-precio_efect /
                                     i_condiciones-base ) * 1000.
        i_linea_det-precio_fca = ( i_linea_det-precio_fca /
                                     i_condiciones-base ) * 1000.
        i_linea_det-precio_log = ( i_linea_det-precio_log /
                                     i_condiciones-base ) * 1000.

        i_linea_det-base = 1000. "incidencia 11728
      ENDIF.

      i_linea_det-nivel = i_condiciones-nivel.
      i_linea_det-repos = i_condiciones-repos.
      APPEND i_linea_det.
      IF i_ekpo-pstyp = '3'.
        PERFORM funcion_bom.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
ENDFORM.                               " DATOS_LINEA
*&---------------------------------------------------------------------*
*&      Form  IMPRIMIR_LINEA
*&---------------------------------------------------------------------*
*    Impresión de la linea de detalle                                  *
*----------------------------------------------------------------------*
FORM imprimir_linea.
  SORT i_linea_det ASCENDING BY fecha_inicial DESCENDING lifnr.
  LOOP AT i_linea_det.
*   Modificacion de JPM para que salgan las lineas con motivos no
*   existentes
*    READ TABLE MOT WITH KEY KZUST = I_LINEA_DET-MODIF.
*    IF SY-SUBRC = 0.
    IF i_linea_det-modif IN motivo.
      IF i_linea_det-precio_prov <> 0.
*        RESALTAMOS LA LINEA
        IF i_linea_det-fecha_inicial <= sy-datum AND
           i_linea_det-fecha_fin >= sy-datum AND
           i_linea_det-bloqueo = space.
          FORMAT COLOR COL_GROUP INTENSIFIED ON.
        ELSE.
          FORMAT COLOR OFF INTENSIFIED ON.
        ENDIF.
        WRITE i_linea_det-fecha_inicial TO
                                     d_fecha_ini_c DD/MM/YYYY.
        d_flag2 = space.
        IF i_linea_det-pstyp = '3' .
          FORMAT COLOR 4 INTENSIFIED ON.
          WRITE: /1 TEXT-031, 13 i_linea_det-txz01, 54 i_linea_det-idnlf.
          FORMAT COLOR OFF INTENSIFIED ON.
        ENDIF.
        WRITE: /1(6) i_linea_det-lifnr, 8(30) i_linea_det-name1,
                39 i_linea_det-nivel, 44 i_linea_det-fecha_inicial,
                55 i_linea_det-modif, 59 i_linea_det-bloqueo,
                62 i_linea_det-precio_prov CURRENCY i_linea_det-moneda1,
                78 i_linea_det-moneda1,
               85 i_linea_det-precio_efect CURRENCY i_linea_det-moneda2,
               100 i_linea_det-moneda2, 104 i_linea_det-fecha_porcent,
                115 i_linea_det-porcent NO-ZERO,
                132 i_linea_det-username(15),
           148 i_linea_det-userdate.
        IF i_linea_det-fecha_fin = 0.
          WRITE:  120 TEXT-220, 160 i_linea_det-base.

        ELSE.
          WRITE:  120 i_linea_det-fecha_fin DD/MM/YYYY,
                     160 i_linea_det-base.
        ENDIF.
        .
        FORMAT COLOR OFF INTENSIFIED ON.

        IF i_linea_det-observaciones <> space.
          d_flag2 = 'X'.
          WRITE: /4 i_linea_det-observaciones.
        ENDIF.
        IF i_linea_det-utillaje <> 0.
          WRITE: /52 TEXT-088, 62 i_linea_det-utillaje,
                78 i_linea_det-monuti.
        ENDIF.

        IF i_linea_det-inco1 <> space OR i_linea_det-inco2 <> space.
          IF d_flag2 = space .
            WRITE: /1 ' '.
          ENDIF.
          WRITE: 100 i_linea_det-inco1, i_linea_det-inco2.
        ENDIF.
*Evita la impresión de la cabecera de datos en una 2ª pág. de ese Matnr.
        d_flag = 'X'.
        IF i_linea_det-pstyp = '3'.
          PERFORM impresion_subcont.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                               " IMPRIMIR_LINEA
*&---------------------------------------------------------------------*
*&      Form  CALCULO_PRECIOS
*&---------------------------------------------------------------------*
*  Se calcula el precio proveedor y el precio efectivo con los datos de*
* KONP, operando con las diferentes clases de condiciones.
*----------------------------------------------------------------------*
FORM calculo_precios USING p_werks LIKE ekpo-werks
                           p_lifnr  LIKE ekko-lifnr
                           p_matnr  LIKE ekpo-matnr.
  DATA: fca LIKE  konp-kbetr.
  DATA: log LIKE  konp-kbetr.
  DATA: t_konp                TYPE TABLE OF konp   WITH HEADER LINE.
*El precio de proveedor es la cantidad con clase de condición Precio
* Bruto PB00, que tenemos en i_condiciones-precio_prov menos un
* porcentaje que viene con la clase de condición de ZICM
  SELECT * FROM konp                          "#EC CI_ALL_FIELDS_NEEDED
    WHERE knumh = i_condiciones-knumh
                     AND kappl = c_kappl
                     AND  kschl = c_clase_por
                     AND loevm_ko = space. "Indicador de borrado
  ENDSELECT.
  IF sy-subrc = 0.
    d_cantidad_por = ( i_condiciones-precio_prov * ( konp-kbetr / 10 )
                     )  / 100.
    i_condiciones-zicms = ( konp-kbetr / 10 ).
    i_condiciones-precio_prov = i_condiciones-precio_prov
                                         + d_cantidad_por.

  ENDIF.
*El precio efectivo es el precio de proveedor más todos los demás
*importes de las clases de condición. Se tiene en cuenta que algunos
*pueden ser porcentajes.
  i_condiciones-precio_efect = i_condiciones-precio_prov.
  i_condiciones-precio_log = i_condiciones-precio_prov.
  SELECT * FROM konp                          "#EC CI_ALL_FIELDS_NEEDED
     WHERE knumh = i_condiciones-knumh
                     AND kappl = c_kappl
                     AND kschl <> c_clase_por
                     AND kschl <> c_clase_con
                     AND kznep = ' '
                     AND loevm_ko = space. "Indicador de borrado
    IF konp-konwa <> '%'.
* Se tiene en cuenta que diferentes condiciones de un mismo material
* puedan venir en diferentes unidades ó base.
      IF konp-kpein <> i_condiciones-base.
* Se pone en la misma base que el precio bruto
        IF konp-kpein <> 0.
          konp-kbetr = konp-kbetr * ( i_condiciones-base / konp-kpein ).
        ENDIF.
      ENDIF.
      IF konp-kmein <> i_condiciones-unidad_ped.
        PERFORM  conversion_unidades USING p_matnr "material de i_ekpo
                                           konp-kmein
                                           i_condiciones-unidad_ped.
        konp-kbetr = konp-kbetr / d_factor_conversion.
      ENDIF.
      IF konp-konwa = i_condiciones-moneda1."Si es la misma moneda
        i_condiciones-precio_efect = i_condiciones-precio_efect
                                   + konp-kbetr.
*Si la moneda de la condición es distinta de la de precio bruto.
      ELSE.
        PERFORM conversion_moneda USING i_condiciones-fecha_inicial
                                        konp-kbetr
                                        konp-konwa
                                        i_condiciones-moneda1.
      ENDIF.
    ELSE.                              "Si es porcentaje
      d_cantidad_por = ( i_condiciones-precio_prov * ( konp-kbetr / 10 )
                                                                )  / 100.
      i_condiciones-precio_efect = i_condiciones-precio_efect
                                           + d_cantidad_por.
    ENDIF.
  ENDSELECT.
********************PRECIO FCA*************************************************************
