*----------------------------------------------------------------------*
FORM datos_condicion_cer TABLES p_ekpo STRUCTURE i_ekpo.
  LOOP AT p_ekpo WHERE bstyp = c_bstyp_pd.
    CLEAR i_condiciones.
*Se toma el precio neto y sus datos de moneda y base
    SELECT * FROM konv                        "#EC CI_ALL_FIELDS_NEEDED
      WHERE knumv = p_ekpo-knumv  "una entrada
        AND   kposn = p_ekpo-ebelp
        AND   ( kschl = c_clase_ped OR kschl = c_clase_con )
        AND   kappl = 'M'.
      i_condiciones-ebeln = p_ekpo-ebeln.
      i_condiciones-ebelp = p_ekpo-ebelp.
      i_condiciones-lifnr = p_ekpo-lifnr.
      i_condiciones-modif = 'NN'.
      i_condiciones-fecha_inicial = p_ekpo-bedat.
      i_condiciones-precio_prov = konv-kbetr.
      i_condiciones-base = konv-kpein.
      i_condiciones-moneda1 = konv-waers.
      i_condiciones-knumh = p_ekpo-knumv.
    ENDSELECT.
*El precio de proveedor es la cantidad con clase de condición Precio
* Bruto PB00, que tenemos en i_condiciones-precio_prov menos un
* porcentaje que viene con la clase de condición de ZICM
    SELECT *                                  "#EC CI_ALL_FIELDS_NEEDED
      FROM konv
     WHERE knumv = p_ekpo-knumv  "una entrada
       AND kposn = p_ekpo-ebelp
       AND kschl = c_clase_por
       AND kappl = 'M'.
    ENDSELECT.
    IF sy-subrc = 0.
      d_cantidad_por = ( i_condiciones-precio_prov * ( konv-kbetr / 10 )
                                                                )  / 100.
      i_condiciones-zicms = ( konv-kbetr / 10 ).

      i_condiciones-precio_prov = i_condiciones-precio_prov
                                           + d_cantidad_por.
    ENDIF.
*El precio efectivo es el precio de proveedor más todos los demás
*importes de las clases de condición. Se tiene en cuenta que algunos
*pueden ser porcentajes.
    i_condiciones-precio_efect = i_condiciones-precio_prov.
    SELECT *                                  "#EC CI_ALL_FIELDS_NEEDED
      FROM konv
      WHERE knumv = p_ekpo-knumv  "una entrada
        AND   kposn = p_ekpo-ebelp
        AND   kschl <> c_clase_por
        AND   kschl <> c_clase_ped
        AND   kschl <>  c_clase_con
        AND   kstat = ' '
        AND   kbetr <> 0
        AND   kpein <> 0
        AND   kappl = 'M'.
      IF konv-krech <> 'A'.            "A es porcentaje
* Se tiene en cuenta que diferentes condiciones de un mismo material
* puedan venir en diferentes unidades ó base.
        IF konv-kpein <> i_condiciones-base.
* Se pone en la misma base que el precio bruto
          konv-kbetr = konv-kbetr * ( i_condiciones-base / konv-kpein ).
        ENDIF.
        IF konv-kmein <> i_condiciones-unidad_ped.
          PERFORM  conversion_unidades USING p_ekpo-matnr
                                             konv-kmein
                                             i_condiciones-unidad_ped.
          konv-kbetr = konv-kbetr / d_factor_conversion.
        ENDIF.
        IF konv-waers = i_condiciones-moneda1."Si es la misma moneda
          i_condiciones-precio_efect = i_condiciones-precio_efect
                                     + konv-kbetr.
*Si la moneda de la condición es distinta de la de precio bruto.
        ELSE.
          PERFORM conversion_moneda USING i_condiciones-fecha_inicial
                                          konv-kbetr
                                          konv-waers
                                          i_condiciones-moneda1.
        ENDIF.
      ELSE.                            "Si es porcentaje
        d_cantidad_por = ( i_condiciones-precio_prov *
                               ( konv-kbetr / 10 ) )  / 100.
        i_condiciones-precio_efect = i_condiciones-precio_efect
                                             + d_cantidad_por.
      ENDIF.
    ENDSELECT.
    IF c_user = 'X'.
*      PERFORM USUARIO USING C_OBJECTCLAS_PED
      PERFORM usuario2 USING c_objectclas_ped
                          i_condiciones-ebeln.
    ENDIF.

*Datos del porcentaje de participación
    SELECT SINGLE * FROM equk WHERE matnr = p_ekpo-matnr
                              AND   werks = p_ekpo-werks
                           AND   bdatu >= i_condiciones-fecha_inicial
*antes fecha inicio
                           AND   vdatu <= i_condiciones-fecha_fin.
    IF sy-subrc = 0.
      i_condiciones-fecha_porcent = equk-vdatu.
      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM equp
       WHERE qunum = equk-qunum
         AND   lifnr = p_ekpo-lifnr.
        i_condiciones-porcent = equp-quote.
      ENDSELECT.
*Si no encuentra por proveedor, lo buscamos por centro suministrador.
      IF sy-subrc <> 0.
        SELECT * FROM equp                    "#EC CI_ALL_FIELDS_NEEDED
          WHERE qunum = equk-qunum
                           AND   bewrk = p_ekpo-werks.
          i_condiciones-porcent = equp-quote.
        ENDSELECT.
      ENDIF.
    ENDIF.
    PERFORM observaciones2 USING p_ekpo-ebeln
                                p_ekpo-ebelp
                                p_ekpo-spras
                         CHANGING p_ekpo-observaciones.

    APPEND i_condiciones.
*Localización de observaciones para segunda linea de detalle.
    PERFORM observaciones USING p_ekpo-ebeln
                                p_ekpo-ebelp
                                p_ekpo-spras
                         CHANGING p_ekpo-observaciones.
    MODIFY p_ekpo.
  ENDLOOP.
