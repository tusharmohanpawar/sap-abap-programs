FORM busca_buyone .

  SELECT * FROM konh INTO TABLE i_konh WHERE revno IN s_revno AND kosrt IN s_iss.
  IF i_konh[] IS NOT INITIAL.
    SELECT * INTO TABLE i_a016
      FROM a016
      FOR ALL ENTRIES IN i_konh                    "#EC CI_NO_TRANSFORM
    WHERE kappl = 'M'
      AND kschl = 'PB00'
      AND knumh = i_konh-knumh.
*      AND evrtn = i_konh-vakey(10). "AND evrtp =  i_konh-vakey+10(5)  " commented by tushar pawar


    SELECT * FROM zekko
      FOR ALL ENTRIES IN i_a016                    "#EC CI_NO_TRANSFORM
      WHERE  matnr IN s_materi
        AND bukrs IN s_bukrs "mod IDE. PS:56344
        AND werks IN d_centro
        AND matkl IN s_famili
        AND lifnr IN s_proved
        AND bstyp <> 'A'
        AND bstyp IN s_bstyp
        AND ebeln = i_a016-evrtn
        AND ebelp = i_a016-evrtp.


*Si loekz distinto de espacio indica que está marcado para borrado
*                      and loekz = space.
      CLEAR i_ekpo.
      CLEAR i_materiales.
      AUTHORITY-CHECK OBJECT 'Z_BO_WERKS'
                            ID 'WERKS' FIELD zekko-werks.
      IF sy-subrc = 0.
*Validamos el parámetro de la pantalla de selección de división con la
*tabla Mara.
        SELECT SINGLE *                       "#EC CI_ALL_FIELDS_NEEDED
          FROM mara
         WHERE matnr = zekko-matnr
           AND spart LIKE d_divisi.
        IF sy-subrc = 0.
          MOVE-CORRESPONDING zekko TO i_ekpo.
          i_ekpo-ebeln = zekko-ebeln.
          i_ekpo-ebelp = zekko-ebelp.
          i_ekpo-loekz = zekko-loekz.
          i_ekpo-matnr = zekko-matnr.
          i_ekpo-inco1 = zekko-inco1.
          i_ekpo-inco2 = zekko-inco2.

          i_ekpo-werks = zekko-werks.
          i_ekpo-matkl = zekko-matkl.
          i_ekpo-txz01 = zekko-txz01.
          i_ekpo-idnlf = zekko-idnlf.
          i_ekpo-bprme = zekko-bprme.
          i_ekpo-pstyp = zekko-pstyp.       "Si = 3, subcontratación
          i_ekpo-retpo = space.
          APPEND i_ekpo.

          i_materiales-ebeln = zekko-ebeln.
          i_materiales-matnr = zekko-matnr.
          i_materiales-werks = zekko-werks.
          i_materiales-mtart = zekko-mtart.
          i_materiales-spart = mara-spart.
          i_materiales-ref_ant = mara-bismt.
          i_materiales-meins = zekko-bprme.
*Mod.Javi Arce.Nov11.PS122712.Añadir Proyecto (ZPIP/ZPFP/ZMD01)
          i_materiales-prdha = mara-prdha.
*End Mod.Javi Arce.Nov11.PS122712.
          i_materiales-descripcion = i_ekpo-txz01.
          APPEND i_materiales.
        ENDIF.
      ENDIF.
    ENDSELECT.

    DELETE ADJACENT DUPLICATES FROM i_ekpo.              "#EC CI_SORTED
    DELETE ADJACENT DUPLICATES FROM i_materiales.        "#EC CI_SORTED
  ENDIF.
