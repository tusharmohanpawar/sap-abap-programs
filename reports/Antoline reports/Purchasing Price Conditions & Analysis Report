************************************************************************
*                  LOGICA DEL PROGRAMA
************************************************************************
*----------------------------------------------------------------------*
* VALIDACIONES DE PARAMETROS
*----------------------------------------------------------------------*
AT SELECTION-SCREEN.
*Validación de Centro.
*  IF P_CENTRO IS INITIAL.
*    D_CENTRO = '%'.
*  ELSE.
*    SELECT SINGLE * FROM T001W WHERE WERKS = P_CENTRO.
*    IF SY-SUBRC <> 0.
*      MESSAGE E001 WITH P_CENTRO.
*    ENDIF.
*    D_CENTRO = P_CENTRO.
*  ENDIF.
*Validación de Division o Sector
  IF p_divisi IS INITIAL.
    d_divisi = '%'.
  ELSE.
    SELECT SINGLE * FROM tspa WHERE spart = p_divisi.
    IF sy-subrc <> 0.
      MESSAGE e019 WITH p_divisi.
    ENDIF.
    d_divisi = p_divisi.
  ENDIF.

*----------------------------------------------------------------------*
* INICIALIZACION ANTES DE PEDIR LOS PARAMETROS
*----------------------------------------------------------------------*
INITIALIZATION.
  REFRESH i_ekko.
  REFRESH i_ekpo.
  REFRESH i_materiales.
  REFRESH i_condiciones.
  REFRESH i_alv.
  CLEAR it_specialcol[].
  DATA: ls_dd03l TYPE dd03l.
  SELECT fieldname INTO ls_dd03l-fieldname FROM dd03l WHERE tabname EQ 'ZPFP_ALV'.
    CLEAR ls_specialcol.
    ls_specialcol-fieldname = ls_dd03l-fieldname.
    ls_specialcol-color-col = 7.
    APPEND ls_specialcol TO it_specialcol.

  ENDSELECT.
*----------------------------------------------------------------------*
* START-OF-SELECTION
*----------------------------------------------------------------------*
START-OF-SELECTION.
  PERFORM contratos.
  PERFORM moneda_sociedad.
  PERFORM cabecera_ficha. "Datos cabecera para cada material
  PERFORM datos_condicion TABLES i_ekpo.  "Planes de entrega : L.
  PERFORM datos_condicion_cer TABLES i_ekpo.    "Pedidos tipo F.
  LOOP AT i_materiales.
    PERFORM datos_linea.
*Mod.Javi Arce.Nov12.PS197628.ZPFP ALV. No calcular subcontratación
    IF r_lis = 'X' AND p_pid IS INITIAL. "MOD IDE. ZPFP RFC
      PERFORM material_subcont.
*End Mod.Javi Arce.Nov12.PS197628.
      PERFORM imprimir_linea.
      d_flag = space.  "Permite sacar la cabecera de datos para el sig..
      NEW-PAGE.                          "...material
    ELSE.
      PERFORM pasar_alv.
    ENDIF.
  ENDLOOP.
  IF r_alv = 'X' AND p_pid IS INITIAL. "Mod IDE. ZPFP RFC
    PERFORM mostrar_alv.
  ENDIF.
  "Mod IDE. ZPFP RFC
  IF p_pid IS NOT INITIAL.
    REFRESH i_rfc.
    LOOP AT i_alv.
      MOVE-CORRESPONDING i_alv TO i_rfc.
      APPEND i_rfc. CLEAR i_rfc.
    ENDLOOP.

    EXPORT i_rfc TO MEMORY ID p_pid.
  ENDIF.
*----------------------------------------------------------------------*
* TOP-OF-PAGE
*----------------------------------------------------------------------*
TOP-OF-PAGE.
  PERFORM cabecera.
  IF d_flag = 'X'.  "Solo imprime la cabecera de la linea de detalle
    PERFORM cabecera_linea.
  ELSE.
    PERFORM cabecera_datos.
    PERFORM cabecera_linea.
  ENDIF.
*----------------------------------------------------------------------*
*                      FORMS - SUBRUTINAS
*----------------------------------------------------------------------*
