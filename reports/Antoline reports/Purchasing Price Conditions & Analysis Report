*&---------------------------------------------------------------------*
*&      Form  IMPRESION_SUBCONT
*&---------------------------------------------------------------------*
* Busqueda e impresion de los materiales subcontratados.
*----------------------------------------------------------------------*
FORM impresion_subcont.
  REFRESH i_linea_sub.
*Se busca en i_bon el/los materiales subcontratados.
  LOOP AT i_bom WHERE ebeln = i_linea_det-ebeln
                  AND ebelp = i_linea_det-ebelp
                  AND fecha = i_linea_det-fecha_inicial.
*   at new matnr.

    LOOP AT i_ekpo_sub WHERE matnr = i_bom-matnr.
*        loop at i_condiciones where ebeln = i_ekpo_sub-ebeln
*                                and ebelp = i_ekpo_sub-ebelp.
      CLEAR i_linea_sub.
      i_linea_sub-matnr = i_bom-matnr.
      i_linea_sub-lifnr = i_ekpo_sub-lifnr.
*Descripción del proveedor
      SELECT SINGLE * FROM lfa1               "#EC CI_ALL_FIELDS_NEEDED
        WHERE lifnr = i_ekpo_sub-lifnr.
      IF sy-subrc = 0.
        i_linea_sub-name1 = lfa1-name1.
      ENDIF.
      IF i_ekpo_sub-loekz <> space.
        i_linea_sub-bloqueo = '*'.
      ENDIF.
      i_linea_sub-inco1 = i_ekpo_sub-inco1.
      i_linea_sub-inco2 = i_ekpo_sub-inco2.
      i_linea_sub-observaciones = i_ekpo_sub-observaciones.
      SORT i_linea_sub BY fecha_fin fecha_inicial.
      LOOP AT i_condiciones WHERE lifnr = i_ekpo_sub-lifnr
                            AND   ebeln = i_ekpo_sub-ebeln
                            AND   ebelp = i_ekpo_sub-ebelp.
        i_linea_sub-fecha_inicial = i_condiciones-fecha_inicial.
        i_linea_sub-fecha_fin = i_condiciones-fecha_fin.
        i_linea_sub-modif = i_condiciones-modif.
        i_linea_sub-moneda1 = i_condiciones-moneda1.
        i_linea_sub-moneda2 = i_condiciones-moneda1.
        i_linea_sub-username = i_condiciones-username.
        i_linea_sub-userdate = i_condiciones-userdate.
*Si no se encontró el porcentaje, la fecha aparecerá en blanco.
        i_linea_sub-porcent = i_condiciones-porcent.
        IF i_condiciones-fecha_porcent IS INITIAL
           OR i_linea_sub-porcent IS INITIAL.
          i_linea_sub-fecha_porcent = space.
        ELSE.
          WRITE i_condiciones-fecha_porcent TO
                           i_linea_sub-fecha_porcent DD/MM/YYYY.
        ENDIF.
        IF i_condiciones-unidad_ped <> i_materiales-meins.
          i_materiales-meins = i_condiciones-unidad_ped.
        ENDIF.
*         PERFORM conversion_unidades USING i_materiales-matnr
*                                           i_materiales-meins
*                                          i_condiciones-unidad_ped.
*       ELSE.
        d_factor_conversion = 1.
*       ENDIF.
*Precio en la linea de detalle de acuerdo con las unidades del material
*y del pedido.
        i_linea_sub-precio_prov = i_condiciones-precio_prov
                                              / d_factor_conversion.
        i_linea_sub-precio_efect = i_condiciones-precio_efect
                                              / d_factor_conversion.
*Estos precios están en la base del pedido bruto. Si ésta no es mil., se
*pasa.
        IF i_condiciones-base <> 1000.
          i_linea_sub-precio_prov = ( i_linea_sub-precio_prov /
                                       i_condiciones-base ) * 1000.
          i_linea_sub-precio_efect = ( i_linea_sub-precio_efect /
                                       i_condiciones-base ) * 1000.

        ENDIF.
        i_linea_sub-nivel = i_condiciones-nivel.
        APPEND i_linea_sub.
      ENDLOOP.

*si el material es de fabricacion
      IF i_ekpo_sub-lifnr = 0.
        APPEND i_linea_sub.
      ENDIF.

    ENDLOOP.
*    endat.
  ENDLOOP.
  PERFORM impresion_detalle_sub.
ENDFORM.                               " IMPRESION_SUBCONT
*&---------------------------------------------------------------------*
*&      Form  IMPRESION_DETALLE_SUB
*&---------------------------------------------------------------------*
* Imnpresión de la linea de detalle de la subcontratación.
*----------------------------------------------------------------------*
FORM impresion_detalle_sub.
  SORT i_linea_sub ASCENDING BY matnr DESCENDING fecha_inicial.
  FORMAT INTENSIFIED OFF.
  LOOP AT i_linea_sub.
    AT NEW matnr.
      SKIP.
      WRITE: /5(18) i_linea_sub-matnr.
*Descripción del material en MAKT
      SELECT SINGLE *                         "#EC CI_ALL_FIELDS_NEEDED
        FROM makt
       WHERE matnr = i_linea_sub-matnr
         AND spras = sy-langu.
      IF sy-subrc = 0.
        WRITE: 30(40) makt-maktx.
      ENDIF.
      NEW-LINE.
      ULINE AT 5(18).
      ULINE AT 30(40).
    ENDAT.
    d_flag2 = space.
    WRITE i_linea_sub-fecha_inicial TO
                                 d_fecha_ini_c DD/MM/YYYY.
    WRITE: /5(5) i_linea_sub-lifnr, 11(25) i_linea_sub-name1,
            37 i_linea_sub-nivel, 42 i_linea_sub-fecha_inicial,
            53 i_linea_sub-modif, 57 i_linea_sub-bloqueo,
            60 i_linea_sub-precio_prov CURRENCY i_linea_sub-moneda1,
            76 i_linea_sub-moneda1,
            83 i_linea_sub-precio_efect CURRENCY i_linea_sub-moneda2,
            98 i_linea_sub-moneda2, 102 i_linea_sub-fecha_porcent,
            113 i_linea_sub-porcent NO-ZERO,
            130 i_linea_sub-username(15),
        148 i_linea_sub-userdate, 118 i_linea_sub-fecha_fin DD/MM/YYYY.
    IF i_linea_sub-observaciones <> space.
      d_flag2 = 'X'.
      WRITE: /4 i_linea_sub-observaciones.
    ENDIF.
    IF i_linea_sub-inco1 <> space OR i_linea_sub-inco2 <> space.
      IF d_flag2 = space.
        WRITE: /1 ' '.
      ENDIF.
      WRITE: 98 i_linea_sub-inco1, i_linea_sub-inco2.
    ENDIF.
  ENDLOOP.
  FORMAT INTENSIFIED ON.
ENDFORM.                               " IMPRESION_DETALLE_SUB

