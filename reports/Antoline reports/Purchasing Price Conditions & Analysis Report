*&---------------------------------------------------------------------*
*&      Form  datos_condicion
*&---------------------------------------------------------------------*
*   Datos de la linea de detalle del listado para planes de entrega.   *
*----------------------------------------------------------------------*
FORM datos_condicion TABLES p_ekpo STRUCTURE i_ekpo.
  LOOP AT p_ekpo WHERE bstyp = c_bstyp.
*  Si hay distintas entradas significa que hay varios condiciones de
* precio para ese documento para distintas fechas. Condiciones por
* posición del documento.
    IF p_ekpo-pstyp <> '2'.
      SELECT * FROM a016 WHERE kappl = c_kappl
                          AND  kschl = c_clase_con
                          AND  evrtn = p_ekpo-ebeln
                          AND  evrtp = p_ekpo-ebelp.
        CLEAR i_condiciones.
        i_condiciones-ebeln = p_ekpo-ebeln.
        i_condiciones-ebelp = p_ekpo-ebelp.
        i_condiciones-lifnr = p_ekpo-lifnr.
        i_condiciones-fecha_inicial = a016-datab.
*fecha fin
        i_condiciones-fecha_fin = a016-datbi.
*
        i_condiciones-knumh = a016-knumh.
        i_condiciones-repos = 'X'.
        APPEND i_condiciones.
      ENDSELECT.

    ELSE.
      SELECT * FROM a017   WHERE kappl = c_kappl
       AND kschl = c_clase_con

                                          AND lifnr = p_ekpo-lifnr
                                          AND matnr = p_ekpo-matnr
                                          AND werks = p_ekpo-werks
                                          AND esokz = '2'.
        CLEAR i_condiciones.
        i_condiciones-ebeln = p_ekpo-ebeln.
        i_condiciones-ebelp = p_ekpo-ebelp.
        i_condiciones-lifnr = p_ekpo-lifnr.
        i_condiciones-fecha_inicial = a017-datab.
*fecha fin
        i_condiciones-fecha_fin = a017-datbi.
*
        i_condiciones-knumh = a017-knumh.
        i_condiciones-repos = 'X'.
        APPEND i_condiciones.

      ENDSELECT.

    ENDIF.

    REFRESH i_condicionesb.
    LOOP AT i_condiciones WHERE ebeln = p_ekpo-ebeln
                          AND   ebelp = p_ekpo-ebelp
                          AND   lifnr = p_ekpo-lifnr.
      indice = sy-tabix.
      SELECT SINGLE * FROM konh WHERE knumh = i_condiciones-knumh
                                AND kappl = c_kappl
                                AND kschl = c_clase_con
                                AND revno IN s_revno
                                AND kosrt IN s_iss.
      IF sy-subrc = 0.                 "Modificación
        i_condiciones-linea1 = konh-linea1.
        i_condiciones-linea2 = konh-linea2.
        i_condiciones-linea3 = konh-linea3.
        i_condiciones-linea4 = konh-linea4.
        i_condiciones-impuesto = konh-impuesto.
        i_condiciones-nivel =  konh-zppniv.
        i_condiciones-revno =  konh-revno.
        i_condiciones-reper = konh-reper.
        i_condiciones-lccp = konh-lccp.
        i_condiciones-kosrt = konh-kosrt.
        IF konh-fechar <> 0.
          i_condiciones-fecha_inicial = konh-fechar.
        ENDIF.
        i_condiciones-fechar = konh-fechar.
        i_condiciones-serie = konh-serie.
        i_condiciones-proyecto = konh-proyecto.


        i_condiciones-banfn  = konh-banfn.
        i_condiciones-bnfpo  = konh-bnfpo.
        IF konh-inco1 <> space.
          i_condiciones-inco1 = konh-inco1.
          i_condiciones-inco2 = konh-inco2.
        ELSE.
          IF i_ekpo-inco1 <> ' '.
            i_condiciones-inco1 = i_ekpo-inco1.
            i_condiciones-inco2 = i_ekpo-inco2.
          ELSE.
            i_condiciones-inco1 = i_ekko-inco1.
            i_condiciones-inco2 = i_ekko-inco2.
          ENDIF.

        ENDIF.




        IF konh-kzust IS INITIAL.
          i_condiciones-modif = 'NN'.
        ELSE.
          i_condiciones-modif = konh-kzust.
        ENDIF.
*28/06/2022 INC0578242 - AD añadir campo INDEXADO ini
        IF konh-serie IS NOT INITIAL.
          i_condiciones-indexed = konh-serie.
        ENDIF.
*28/06/2022 INC0578242 - AD añadir campo INDEXADO fin

*Precio del proveedor para cada condición, moneda, base y unidad
        borra = space.
        SELECT * FROM konp                    "#EC CI_ALL_FIELDS_NEEDED
          WHERE knumh = i_condiciones-knumh
          AND kappl = c_kappl
          AND kschl = c_clase_con.
*
*PARA GUARDAR PLOS PRECIOS BORRADOS
          IF konp-loevm_ko = 'X'.
            borra = 'X'.
          ELSE.
            borra = space.
          ENDIF.
          i_condiciones-loekz = konp-loevm_ko.

          i_condiciones-precio_prov = konp-kbetr.
          i_condiciones-base = konp-kpein.
          i_condiciones-moneda1 = konp-konwa.
          i_condiciones-unidad_ped = konp-kmein.
*Se calculan los precios efectivos y de proveedor.
          PERFORM calculo_precios USING p_ekpo-werks  p_ekpo-lifnr  p_ekpo-matnr.
*Nivel de ingeniería del material
          PERFORM nivel_ingenieria.
*Localización del último usuario que ha cambiado la condición.
          CLEAR i_condiciones-username.
          CLEAR i_condiciones-userdate.
          IF c_user = 'X'.
*        PERFORM USUARIO USING C_OBJECTCLAS
            PERFORM usuario2 USING c_objectclas
                                i_condiciones-knumh.
            IF i_condiciones-username = space.
              PERFORM usuario2 USING c_objectclas_ped
                                       i_condiciones-ebeln.


            ENDIF.
          ENDIF.

*****Datos del porcentaje de participación
* Si estamos tratando el precio vigente a día de hoy, buscamos la
* Cond. vigente a día de hoy.

          IF sy-datum >= i_condiciones-fecha_inicial AND
             sy-datum <= i_condiciones-fecha_fin.
            SELECT SINGLE * FROM equk
                WHERE matnr = p_ekpo-matnr
                AND   werks = p_ekpo-werks
                AND   bdatu >= sy-datum
                AND   vdatu <= sy-datum.

          ELSE.
            SELECT SINGLE * FROM equk
                   WHERE matnr = p_ekpo-matnr
                   AND   werks = p_ekpo-werks
                   AND   bdatu >= i_condiciones-fecha_inicial
*            antes fecha inicio
                   AND   vdatu <= i_condiciones-fecha_fin.
          ENDIF.
          IF sy-subrc = 0.
            i_condiciones-fecha_porcent = equk-vdatu.
            SELECT * FROM equp                "#EC CI_ALL_FIELDS_NEEDED
              WHERE qunum = equk-qunum
                               AND   lifnr = p_ekpo-lifnr.
              i_condiciones-porcent = equp-quote.
            ENDSELECT.

*Si no encuentra por proveedor, lo buscamos por centro suministrador.
            IF sy-subrc <> 0.
              SELECT *                        "#EC CI_ALL_FIELDS_NEEDED
                FROM equp
               WHERE qunum = equk-qunum
                 AND bewrk = p_ekpo-werks.
                i_condiciones-porcent = equp-quote.
              ENDSELECT.
              IF sy-subrc <> 0.
                i_condiciones-porcent = 100.
              ENDIF.
            ENDIF.
          ELSE.
            i_condiciones-porcent = 100.
          ENDIF.
          IF borra = 'X'.
            i_condicionesb = i_condiciones.
            APPEND i_condicionesb.
          ELSE.
            MODIFY i_condiciones.
          ENDIF.

        ENDSELECT.
      ELSE.
        DELETE i_condiciones INDEX indice.
      ENDIF.
    ENDLOOP.

    LOOP AT i_condicionesb.
      i_condiciones = i_condicionesb.
      APPEND i_condiciones.
    ENDLOOP.

*Localización de observaciones para segunda linea de detalle.
    PERFORM observaciones USING p_ekpo-ebeln
                                p_ekpo-ebelp
                                p_ekpo-spras
                         CHANGING p_ekpo-observaciones.
    MODIFY p_ekpo.
  ENDLOOP.
ENDFORM.                               " datos_condicion
*&---------------------------------------------------------------------*
*&      Form  CONVERSION_UNIDADES
*&---------------------------------------------------------------------*
*   Conversión de unidades de medida de KONP de MARA                   *
*----------------------------------------------------------------------*
FORM conversion_unidades USING p_mater LIKE mara-matnr
                             d_unid_ori LIKE bsim-meins
                             d_unid_des LIKE bsim-meins.
  CLEAR d_factor_conversion.
  CALL FUNCTION 'MC_UNIT_CONVERSION'
    EXPORTING
      matnr                = p_mater
      nach_meins           = d_unid_ori
      von_meins            = d_unid_des
    IMPORTING
      umref                = d_factor_conversion
    EXCEPTIONS
      conversion_not_found = 1
      material_not_found   = 2
      nach_meins_missing   = 3
      overflow             = 4
      von_meins_missing    = 5
      OTHERS               = 6.
  IF  d_factor_conversion = 0.
    d_factor_conversion = 1.
  ENDIF.
ENDFORM.                               " CONVERSION_UNIDADES
