*  <--  p2        text
*----------------------------------------------------------------------*
FORM calcular_valores USING p_inversion p_fecha_fin
                            p_aho_anu p_aho_fin p_fecha_has.

  DATA: c_fin_ano LIKE sy-datum.
  DATA: num_dias  TYPE i,
        num_dias2 TYPE i,
        num_dias3 TYPE i.

  LOOP AT i_alv.
    CONCATENATE i_alv-fecha_inicial(4) '1231' INTO c_fin_ano.
    num_dias = p_fecha_fin - i_alv-fecha_inicial.
    num_dias2 = p_fecha_has - i_alv-fecha_inicial.
    num_dias3 = c_fin_ano - i_alv-fecha_inicial.

    i_alv-aho_audit = i_alv-importe - p_inversion /
                      num_dias * num_dias2.
    i_alv-aho_anual = i_alv-aho_audit / num_dias2 * 350.
    i_alv-diferenc  = i_alv-aho_anual - p_aho_anu.
    i_alv-aho_finan = i_alv-aho_audit / num_dias2 * num_dias3.
    i_alv-dif_finan = i_alv-aho_finan - p_aho_fin.
    MODIFY i_alv INDEX sy-tabix.
  ENDLOOP.

ENDFORM.                    " calcular_valores

