  LOOP AT i_alv WHERE matnr = i_alv-matnr AND lifnr = i_alv-lifnr AND werks = i_alv-werks AND bloqueo = ' '.
    SELECT * FROM konp                        "#EC CI_ALL_FIELDS_NEEDED
      WHERE knumh = i_alv-knumh AND kappl = 'M'
    AND loevm_ko = space.
      IF  konp-kschl(3) = 'RA0'.
        precio = i_alv-precio_prov.

*      select single * from a016 where knumh = i_alv-knumh AND kappl = 'M'.

        MOVE-CORRESPONDING i_alv TO i_alv3.
        MOVE-CORRESPONDING a016 TO i_alv3.
        i_alv3-datab = i_alv-fecha_inicial.
        i_alv3-datbi = i_alv-fecha_fin.

        MOVE-CORRESPONDING konp TO i_alv3.

*cantidad escala
        SELECT * FROM konm WHERE knumh = konp-knumh AND kopos = konp-kopos.
          MOVE-CORRESPONDING konm TO i_alv3.
          IF konp-kschl = 'RA01'.
            i_alv3-kbetr =  i_alv3-kbetr / 10.
*calculamos el precio
            i_alv3-precio = i_alv-precio_prov + ( i_alv-precio_prov *   i_alv3-kbetr / 100 ).
            i_alv-precio_prov = i_alv-precio_prov + ( i_alv-precio_prov *   i_alv3-kbetr / 100 ).
          ELSE.
            i_alv3-precio = konm-kbetr.
            i_alv3-kbetr  = ( ( precio - i_alv3-precio ) /  precio ) * 100.
            precio = i_alv3-precio.

          ENDIF.
          APPEND i_alv3.
        ENDSELECT.
*buscamos el valor de la inversión.
      ENDIF.

    ENDSELECT.
  ENDLOOP.
  DESCRIBE TABLE i_alv3 LINES lines.
  IF lines > 1.
    lines = lines + 15.
  ENDIF.
  titulo = i_alv-matnr.
  CONCATENATE titulo i_alv-name1(20) INTO titulo SEPARATED BY '/'.
  CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
    EXPORTING
      i_title               = titulo
      i_zebra               = 'X'
      i_screen_start_column = 10
      i_screen_start_line   = 10
      i_screen_end_column   = 120
      i_screen_end_line     = lines
*     i_checkbox_fieldname  = 'CHECK'
      i_tabname             = 'I_ALV3'
      i_structure_name      = 'ZPFP_ALV3'
    TABLES
      t_outtab              = i_alv3.

ENDFORM.                    "LISTARED
