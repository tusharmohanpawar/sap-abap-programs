FORM conversion_moneda_c USING p_fecha LIKE sy-datum
                             p_kbetr LIKE konp-kbetr
                             p_mon_ex LIKE konp-konwa
                             p_mon_lo LIKE konp-konwa.
  CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
    EXPORTING
      date             = p_fecha
      foreign_amount   = p_kbetr
      foreign_currency = p_mon_ex
      local_currency   = p_mon_lo
*     RATE             = 0
      type_of_rate     = 'M'
    IMPORTING
*     exchange_rate    = d_tipo_cambio
      local_amount     = p_kbetr
    EXCEPTIONS
      no_rate_found    = 1
      overflow         = 2
      no_factors_found = 3
      no_spread_found  = 4
      OTHERS           = 5.
ENDFORM.                               " CONVERSION_MONEDA
