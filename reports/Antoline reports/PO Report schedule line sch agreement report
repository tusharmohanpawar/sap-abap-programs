FORM statuspedido .

  tab-status = space.

*esto para todos los pedidos
  CONCATENATE tab-ebeln '00000000' INTO   wfnum.

*ahora buscamos el wf
  SELECT  * FROM  zhrwfah WHERE wfapli = 'WF_POO' AND  wfnum = wfnum
  ORDER BY aedtm hora_graba ASCENDING.
  ENDSELECT.
  IF sy-subrc = 0.
    CASE zhrwfah-decision.
      WHEN 'CAN'.
        tab-status = '@11@'.
      WHEN 'INI'.
        tab-status = '@0A@'.
*EN CURSO
      WHEN 'APP' OR 'APC'.
        tab-status = '@09@'.
      WHEN 'APT'.
        tab-status = '@08@'.
    ENDCASE.
  ENDIF.

  CASE tab-frgke.
    WHEN'Y'.
      tab-status = '@08@'.
    WHEN 'N'.
      tab-status = '@09@'.

  ENDCASE.
ENDFORM.                    " STATUSPEDIDO
