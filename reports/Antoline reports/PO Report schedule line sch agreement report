FORM  addmuarec.
  READ TABLE tab WITH KEY  aufnr = i_lineas-zinordp idnlf =
  i_lineas-zinordint yeari = muay.
  IF sy-subrc <> 0.
    READ TABLE tab WITH KEY  aufnr = i_lineas-zinordp  yeari = muay.
  ENDIF.
  IF sy-subrc = 0.
*Sum up the totals.
*Check if the currency differs.
    tab-muac = tab-muac + muac.
    tab-muav  = tab-muav + muav.
    MODIFY tab INDEX sy-tabix.
  ELSE.
*Add the line.
*Only add if the amounts are <> 0.
    IF muav <> 0 OR muac <> 0.
      CLEAR: tab.
      tab-muac = muac.
      tab-muav  = muav.
*      IF tab-yeari = 0.
      tab-yeari = muay.
      tab-mesi = '01'.
*     ENDIF.
      tab-bukrs =  i_lineas-bukrs.
      tab-idnlf = i_lineas-zinordint.
      tab-txz01 = i_lineas-zindesc.
      tab-waers = i_lineas-waers.
      tab-aufnr = i_lineas-zinordp.
      tab-waersmua = 'EUR'.
      "tab-zzproyecto  = i_lineas-zinproy.
      CONCATENATE i_lineas-zinproy i_lineas-zinprod
        INTO tab-zzproyecto SEPARATED BY '-'.
      APPEND tab.
    ENDIF.
  ENDIF.
ENDFORM.                    " ADDMUAREC
*&---------------------------------------------------------------------*
*&      Form  COMPLETAR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM completar .
  DATA: BEGIN OF i_cliente OCCURS 0,
          pspid LIKE proj-pspid,
          objnr LIKE ihpa-objnr,
          parnr LIKE ihpa-parnr.
  DATA: END OF i_cliente.

  REFRESH i_zpordenproy.
* ▼  New email column in Report ZME07 ▼
  DATA: BEGIN OF ls_adr6,
          ebeln      TYPE ebeln,
*         lifnr TYPE lifnr,
          persnumber TYPE ad_persnum,
          consnumber TYPE ad_consnum,
          flgdefault TYPE	ad_flgdfad,
          smtp_addr  TYPE ad_smtpadr,
        END OF ls_adr6,
        lt_adr6    LIKE TABLE OF ls_adr6,
        lt_adr6_lf LIKE TABLE OF ls_adr6.
  IF tab[] IS NOT INITIAL.
* ▼ EMAIL FROM CONTRACT, NOT SELLER ▼
    SELECT e~ebeln a~persnumber a~consnumber a~flgdefault a~smtp_addr
    FROM ekko AS e
    INNER JOIN adr6 AS a ON e~adrnr EQ a~addrnumber
    INTO TABLE lt_adr6
    FOR ALL ENTRIES IN tab
    WHERE e~ebeln EQ tab-ebeln.

*    SELECT l~lifnr a~persnumber a~consnumber a~flgdefault a~smtp_addr
*    FROM lfa1 AS l
*    INNER JOIN adr6 AS a ON l~adrnr EQ a~addrnumber
*    INTO TABLE lt_adr6
*    FOR ALL ENTRIES IN tab
*    WHERE l~lifnr EQ tab-lifnr.
* ▲  EMAIL FROM CONTRACT, NOT VENDOR ▲

    SORT lt_adr6 BY ebeln persnumber consnumber.
  ENDIF.
* ▲  New email column in ZME07 Report ▲
  LOOP AT tab.
    indice = sy-tabix.

* ▼  New email column in ZME07 Report ▼
*    READ TABLE lt_adr6 INTO ls_adr6 WITH KEY lifnr = tab-lifnr flgdefault = 'X'.
    READ TABLE lt_adr6 INTO ls_adr6 WITH KEY ebeln = tab-ebeln flgdefault = 'X'.
    IF sy-subrc EQ 0.
      tab-smtp_addr = ls_adr6-smtp_addr.
    ELSE.
      READ TABLE lt_adr6 INTO ls_adr6 WITH KEY ebeln = tab-ebeln.
      IF sy-subrc EQ 0.
        tab-smtp_addr = ls_adr6-smtp_addr.
      ENDIF.
    ENDIF.

    IF tab-smtp_addr IS INITIAL.
      CLEAR lt_adr6_lf[].
      SELECT  a~persnumber a~consnumber a~flgdefault a~smtp_addr
      FROM lfa1 AS lf
      INNER JOIN adr6 AS a ON lf~adrnr EQ a~addrnumber
      INTO CORRESPONDING FIELDS OF TABLE lt_adr6_lf
*      FOR ALL ENTRIES IN tab
      WHERE lf~lifnr = tab-lifnr.
      READ TABLE lt_adr6_lf INDEX 1 INTO ls_adr6.
      IF sy-subrc EQ 0.
        tab-smtp_addr = ls_adr6-smtp_addr.
      ENDIF.
    ENDIF.

* ▲ New email column in Report ZME07 ▲

    IF tab-augru = '998' AND bloque = 'X'.
      DELETE tab INDEX indice.
    ELSE.
      IF tab-zzproyecto = space AND tab-aufnr <> ' '.
        CLEAR i_zpordenproy.
        READ TABLE i_zpordenproy WITH KEY zinordp = tab-aufnr.
        IF sy-subrc = 0.
          CONCATENATE i_zpordenproy-zinproy i_zpordenproy-zinprod
            INTO tab-zzproyecto SEPARATED BY '-'.
        ELSE.
          SELECT SINGLE lin~zinordp inv~zinproy inv~zinprod
            INTO (i_zpordenproy-zinordp,
                  i_zpordenproy-zinproy,
                  i_zpordenproy-zinprod)
            FROM zpsiplin AS lin
            INNER JOIN zpsipinvan AS inv
            ON lin~ziniden = inv~ziniden
            WHERE lin~zinordp = tab-aufnr
              AND lin~bukrs = tab-bukrs.
          IF sy-subrc = 0.
            CONCATENATE i_zpordenproy-zinproy i_zpordenproy-zinprod
                    INTO tab-zzproyecto SEPARATED BY '-'.
            APPEND i_zpordenproy.
          ELSE.
*     If you don't find it, we will stick with the draft order.
            CONCATENATE tab-aufnr+1(2) '/' tab-aufnr+3(4)
              INTO tab-zzproyecto.
          ENDIF.
        ENDIF.
      ENDIF.

      IF tab-zzproyecto <> space.
        SELECT SINGLE * FROM proj WHERE pspid = tab-zzproyecto.
        IF sy-subrc = 0.
          tab-post1 = proj-post1..
        ENDIF.
      ENDIF.
**********
      SELECT SINGLE * FROM t001 WHERE bukrs = tab-bukrs.
      tab-butxt = t001-butxt.
      tab-waers  = t001-waers.

      IF p_zindic IS NOT INITIAL.
        CLEAR ls_zgiemp.
        ls_zgiemp-bukrs = tab-bukrs.
        ls_zgiemp-werks = tab-werks.
        ls_zgiemp-giano = bldat-low(4).
        ls_zgiemp-gimes = bldat-low+4(2).
        ls_zgiemp-zindic = p_zindic.
        ls_zgiemp-zgitip = 'R'.
        ls_zgiemp-valor = tab-valfac.
        ls_zgiemp-dmbtr = tab-valfac.
        ls_zgiemp-waers = t001-waers.
        ls_zgiemp-zprog = sy-repid.
        ls_zgiemp-ernam = sy-uname.
        ls_zgiemp-laeda = sy-datlo.
        ls_zgiemp-cputm = sy-timlo.
        COLLECT ls_zgiemp INTO lt_zgiemp.
      ENDIF.
********
*currency exchange
      IF monpan <> ' '.
        IF tab-waers <> monpan.
          importe = tab-preis.
          PERFORM cambio USING importe tab-waers.
          tab-preis = importe.

          importe = tab-valped.
          PERFORM cambio USING importe tab-waers.
          tab-valped = importe.

          importe = tab-valfac.
          PERFORM cambio USING importe tab-waers.
          tab-valfac = importe.

          importe = tab-diffac.
          PERFORM cambio USING importe tab-waers.
          tab-diffac = importe.

          importe = tab-valfacc.
          PERFORM cambio USING importe tab-waers.
          tab-valfacc = importe.
          tab-waers =  monpan.
        ENDIF.

        IF monpan <> tab-waersmua.
**buy *
          IF tab-muac <> 0.
            importe = tab-muac.
            PERFORM cambiopre USING importe tab-waersmua.
            tab-muac = importe.
          ENDIF.
          IF tab-muav <> 0.
            importe = tab-muav.
            PERFORM cambiopre USING importe tab-waersmua.
            tab-muav = importe.
          ENDIF.
          tab-waersmua =  monpan.

        ENDIF.
*sell
        IF monpan <> tab-waerk.
          importe = tab-netwrv.
          PERFORM cambio USING importe tab-waerk.
          tab-netwrv = importe.

          importe = tab-totinv.
          PERFORM cambio USING importe tab-waerk.
          tab-totinv = importe.

          importe = tab-totinvc.
          PERFORM cambio USING importe tab-waerk.
          tab-totinvc = importe.
          tab-waerk = monpan.
        ENDIF.

      ENDIF.
*customer
      IF tab-kunnr = ' ' AND tab-aufnr <> ' '.

        DATA: d_posid  LIKE proj-pspid,
              t_proj   TYPE TABLE OF prps WITH HEADER LINE,
              lv_pspnr LIKE prps-pspnr,
              i_ihpa   TYPE TABLE OF ihpa WITH HEADER LINE.

        d_posid = tab-aufnr+1(6).

        READ TABLE i_cliente WITH KEY pspid = d_posid.
        IF sy-subrc = 0.
          tab-kunnr = i_cliente-parnr.
        ELSE.
          SELECT SINGLE pspnr
          FROM proj
          INTO lv_pspnr
          WHERE pspid = d_posid.
          IF sy-subrc = 0.
            SELECT posid objnr INTO CORRESPONDING FIELDS OF TABLE t_proj
              FROM prps
              WHERE stufe EQ 1
                AND psphi EQ lv_pspnr.
            IF sy-subrc = 0.
              SELECT *
                FROM ihpa INTO TABLE i_ihpa
                FOR ALL ENTRIES IN t_proj
                WHERE objnr = t_proj-objnr
                  AND ( parvw = 'SP'
                     OR parvw = '1A' ).
              IF sy-subrc = 0.
*Sort in descending order so that the AG partner remains in the
*first position, since it takes precedence over partner 1A.
                SORT i_ihpa BY parvw DESCENDING.
                READ TABLE i_ihpa INDEX 1.
                IF sy-subrc = 0.
                  tab-kunnr = i_ihpa-parnr.
                  i_cliente-pspid = d_posid.
                  i_cliente-objnr = i_ihpa-objnr.
                  i_cliente-parnr = i_ihpa-parnr.
                  APPEND i_cliente.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
* End SDR 1487 04.11.2014
      ENDIF.
*Closed purchase order status
      IF tab-bstyp = 'F'.
        PERFORM statuspedido.
      ENDIF.
      MODIFY tab INDEX indice.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " COMPLETAR
