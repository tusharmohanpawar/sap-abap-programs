  LOOP AT ct_fieldcat INTO ls_fcat.
    CASE ls_fcat-fieldname.
      WHEN 'KOSTL' OR 'SAKTO'.
        ls_fcat-tech       = ''.
        ls_fcat-no_out     = ''.
