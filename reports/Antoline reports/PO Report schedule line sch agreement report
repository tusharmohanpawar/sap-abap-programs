*      -->WAERS      text
*----------------------------------------------------------------------*
FORM cambiopre  USING importe LIKE ekbe-dmbtr
                   waers   LIKE ekbe-waers.

  DATA: fecpre LIKE sy-datum.
  fecpre(4) = tab-yeari - 1.
  fecpre+4(4) = '1231'.

  DATA: d_rate(16) TYPE p DECIMALS 4,
        d_tratex   TYPE p DECIMALS 10.

*We calculate the exchange rate as of the end of the financial year.
  READ TABLE pre_rates
    WITH KEY tcurr = waers
             date  = fecpan.
  IF sy-subrc = 0.
    d_rate = pre_rates-rate.
    d_tratex = pre_rates-tratex.
  ELSE.

    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING
        date             = fecpre
        foreign_amount   = 1
        foreign_currency = waers
        local_currency   = monpan
        type_of_rate     = 'PLAN'
      IMPORTING
*       EXCHANGE_RATE    =
*       FOREIGN_FACTOR   =
        local_amount     = d_rate
*       LOCAL_FACTOR     =
        exchange_ratex   = d_tratex
*       FIXED_RATE       =
*       DERIVED_RATE_TYPE       =
      EXCEPTIONS
        no_rate_found    = 1
        overflow         = 2
        no_factors_found = 3
        no_spread_found  = 4
        derived_2_times  = 5
        OTHERS           = 6.
    IF sy-subrc NE 0.
      d_tratex = 1.
      d_rate = 1.
    ELSE.
      CLEAR i_exchange_rates.
      pre_rates-tcurr = waers.
      pre_rates-rate = d_rate.
*  The conversion factor must be divided by 10.
      d_tratex = d_tratex / 10.
      pre_rates-tratex = d_tratex.
      pre_rates-date = fecpan.
      APPEND pre_rates.
    ENDIF.


  ENDIF.

  importe = importe *  d_tratex.
ENDFORM.                    " CAMBIO
