FORM wfhistorico .
  DATA: BEGIN OF tabs OCCURS 0.
          INCLUDE STRUCTURE zbapifirmasx.
        DATA: END OF tabs.
  CONCATENATE tab-ebeln '00000000' INTO wfnum.
  SELECT * FROM zhrwfa WHERE wfapli = 'WF_POO' AND wfnum = wfnum.
    .
    SELECT SINGLE * FROM pa0002 WHERE pernr = zhrwfa-pernr  AND begda <=
    sy-datum AND endda >= sy-datum.
    IF sy-subrc = 0.
      CONCATENATE pa0002-vorna  pa0002-nachn pa0002-nach2 INTO
      tabs-name1 SEPARATED BY space.
    ELSE.
      DATA: usr033 LIKE usr03.
      usr033-bname = zhrwfa-tipo+8(12).
      CALL FUNCTION 'SUSR_USER_ADDRESS_READ'
        EXPORTING
          user_name              = usr033-bname
          read_db_directly       = ' '
        IMPORTING
          user_usr03             = usr033
        EXCEPTIONS
          user_address_not_found = 1
          OTHERS                 = 2.

      CONCATENATE usr033-name1  usr033-name2 INTO   tabs-name1
                      SEPARATED BY space.

    ENDIF.
    SELECT * FROM zhrwfah  WHERE wfapli = 'WF_POO' AND wfnum = wfnum AND pernr = zhrwfa-pernr ORDER BY aedtm DESCENDING
    hora_graba DESCENDING.
      EXIT.
    ENDSELECT.
    IF sy-subrc = 0.
      MOVE-CORRESPONDING zhrwfah TO tabs.
      APPEND tabs.
    ELSE.
      MOVE-CORRESPONDING zhrwfa TO tabs.
      tabs-decision = 'PEN'.
      APPEND tabs.
    ENDIF.
  ENDSELECT.

  CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
