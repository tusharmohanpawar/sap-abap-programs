  ENDLOOP.

* 3. (Optional) If the fields were missing, add them manually
  READ TABLE ct_fieldcat WITH KEY fieldname = 'KOSTL' TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    CLEAR ls_fcat.
    ls_fcat-fieldname = 'KOSTL'.
    ls_fcat-tabname   = 'TAB'.
    ls_fcat-seltext_l = 'Cost Center'.
    ls_fcat-outputlen = 12.
    APPEND ls_fcat TO ct_fieldcat.
  ENDIF.

  READ TABLE ct_fieldcat WITH KEY fieldname = 'SAKTO' TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    CLEAR ls_fcat.
    ls_fcat-fieldname = 'SAKTO'.
    ls_fcat-tabname   = 'TAB'.
    ls_fcat-seltext_l = 'G/L Account'.
    ls_fcat-outputlen = 12.
    APPEND ls_fcat TO ct_fieldcat.
  ENDIF.

* 4. Existing field tweaks (hotspots)
