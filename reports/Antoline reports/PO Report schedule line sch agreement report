            tab-mesi = vbkd-fkdat+4(2).
            tab-kunnr = vbak-kunnr.
            tab-arktx = vbap-arktx.
            tab-kdmat = vbap-kdmat.
            IF tab-aufnr = ' '.
              tab-aufnr = vbap-aufnr.
            ENDIF.
            tab-netwrv = vbap-netwr + tab-netwrv.
            tab-waerk = vbak-waerk.
            MODIFY tab INDEX sy-tabix.
          ENDIF.

        ENDSELECT.
      ELSE.
        SELECT *
          FROM vbap
          WHERE vbeln = vbak-vbeln
            AND aufnr IN aufnr
            AND werks IN rg_werks
            AND abgru <> '70'.
          IF vbap-shkzg = 'X'.
            vbap-netwr =  vbap-netwr * -1.
          ENDIF.
          READ TABLE tab WITH KEY  vbeln = vbap-vbeln vbelp =
          vbap-posnr.
          IF sy-subrc <> 0.
            CLEAR tab.
*If not found, add it.
            tab-yeari = vbkd-fkdat(4).
            tab-mesi = vbkd-fkdat+4(2).
            tab-bstkd = vbkd-bstkd.
            tab-bukrs = vbak-vkorg.
            SELECT SINGLE * FROM t001 WHERE bukrs = tab-bukrs.
            tab-butxt = t001-butxt.
            tab-land1 = t001-land1.

            tab-augru = vbak-augru.
            tab-faksk = vbak-faksk.
            tab-werks = vbap-werks.
            tab-vbeln = vbap-vbeln.
            tab-vbelp = vbap-posnr.
            tab-kunnr = vbak-kunnr.
            tab-txz01 = vbap-arktx.
            tab-arktx = vbap-arktx.
            tab-aufnr = vbap-aufnr.
            tab-netwrv = vbap-netwr.
            tab-waerk = vbak-waerk.
            APPEND tab.
          ELSE.
            tab-yeari = vbkd-fkdat(4).
            tab-bstkd = vbkd-bstkd.
            tab-mesi = vbkd-fkdat+4(2).
            tab-kunnr = vbak-kunnr.
            tab-arktx = vbap-arktx.
            tab-kdmat = vbap-kdmat.
            IF tab-aufnr = ' '.
              tab-aufnr = vbap-aufnr.
            ENDIF.
            tab-netwrv = vbap-netwr.
            tab-waerk = vbak-waerk.
            MODIFY tab INDEX sy-tabix.

          ENDIF.

        ENDSELECT.
      ENDIF.
    ENDIF.
  ENDSELECT.


  tabaux[] = tab[].
  SORT tabaux BY vbeln vbelp.
  LOOP AT tabaux WHERE vbeln IS NOT INITIAL.
    con = 0.
*For all purchase orders linked to the sales order.
    LOOP AT tab
      WHERE vbeln = tabaux-vbeln
        AND vbelp = tabaux-vbelp.
      indice = sy-tabix.
      SELECT SINGLE name1 INTO tab-namec
        FROM kna1
        WHERE kunnr = tab-kunnr.
      SELECT SINGLE  zterm  fkdat
        INTO (tab-ztermc, tab-fechav)
        FROM vbkd
        WHERE vbeln = tab-vbeln
          AND posnr = '000000'.
      SELECT SINGLE *
        FROM vbap
        WHERE vbeln = tab-vbeln
          AND posnr = tab-vbelp
          AND abgru <> '70'.
      IF vbap-shkzg = 'X'.
        vbap-netwr =  vbap-netwr * -1.
      ENDIF.
      IF con = 0.
        tab-totinv = 0.
        tab-totinvc = 0.
*Customer invoices.
        SELECT *
          FROM vbfa
          WHERE vbelv = tab-vbeln
            AND posnv = tab-vbelp
            AND fktyp <> ' '.

          SELECT SINGLE *
            FROM vbrk
            WHERE vbeln = vbfa-vbeln AND fkdat IN bldat.
          IF sy-subrc = 0.
            tab-fkdat = vbrk-fkdat.
            SELECT *
              FROM vbrp
              WHERE vbeln = vbfa-vbeln
                AND posnr = vbfa-posnn.

              IF vbrp-shkzg = 'X'.
                vbrp-kzwi1 = vbrp-kzwi1 * -1.
                vbrp-netwr = vbrp-netwr * -1.
              ENDIF.
*For India, we take the amount excluding tax.
              IF tab-land1 = 'IN'.
                tab-totinv = tab-totinv + vbrp-kzwi1.
              ELSE.
                tab-totinv = tab-totinv + vbrp-netwr.
              ENDIF.

*Search for the financial document to check if it has been cleared.
              SELECT SINGLE *
                FROM bkpf
                WHERE bukrs = vbrk-bukrs
                  AND gjahr = vbrk-fkdat(4)
                  AND bstat = ' '
                  AND awkey = vbfa-vbeln
                  AND awtyp = 'VBRK'
                  AND budat IN bldat.
              IF sy-subrc = 0.
*Update fiscal year with the invoice date.
                tab-yeari = bkpf-budat(4).
                tab-mesi  = bkpf-budat+4(2).

                SELECT SINGLE *
                  FROM bseg
                  WHERE bukrs = vbrk-bukrs
                    AND gjahr = bkpf-gjahr
                    AND belnr = bkpf-belnr
                    AND koart = 'D'.
                IF bseg-augbl <> 0 AND sy-subrc = 0.
                  IF tab-land1 = 'IN'.
                    tab-totinvc = tab-totinvc + vbrp-kzwi1.
                  ELSE.
                    tab-totinvc = tab-totinvc + vbrp-netwr.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDSELECT.
          ENDIF.
        ENDSELECT.
        con = con + 1.
      ELSE.
        tab-totinv = 0.
        tab-totinvc = 0.
        tab-netwrv = 0.
      ENDIF.

      MODIFY tab INDEX indice.
    ENDLOOP.

  ENDLOOP.


ENDFORM.                    " VENTAUTIL
*&---------------------------------------------------------------------*
*&      Form  MUADATA
*&---------------------------------------------------------------------*
*       Text
*----------------------------------------------------------------------*
*  -->  p1        Text
*  <--  p2        Text
*----------------------------------------------------------------------*
FORM muadata .
  DATA: numc LIKE sy-tabix.
  READ TABLE p_ano.
  IF p_ano-low = ' '.
    p_ano-low = sy-datum(4).
  ENDIF.
  IF p_ano-high = ' '.
    p_ano-high = sy-datum(4).
  ENDIF.
  IF sy-subrc <> 0.
    p_ano-sign   = 'I'.
    p_ano-option = 'EQ'.
    APPEND p_ano.
  ELSE.
    MODIFY p_ano INDEX sy-tabix.
  ENDIF.
*First, retrieve the REP version.
  IF i_lineas[] IS INITIAL.
    SUBMIT zpsipl002 WITH s_ano =  p_ano[]
                     WITH s_bukrs IN rg_bukrs
                     WITH k_mua = 'X'
                     WITH k_rep = 'X'
                     WITH k_amp = 'X '
                     WITH r_apr = ' '
                     WITH r_tod = 'X'
                     WITH k_inc = 'X'
                     WITH util  = 'X' AND RETURN.
  ENDIF.
  IMPORT i_lineas FROM MEMORY ID 'ZME07UTIL'.
  anoact = sy-datum(4).
*For the current year and previous years, retrieve REP; for future years, retrieve MUA.
*Delete records that do not match.
  DESCRIBE TABLE tabc LINES numc.
  LOOP AT i_lineas.
    indice = sy-tabix.
    IF ( i_lineas-zinordp+7(1) <> 'K' AND  i_lineas-zinordp+7(1) <> 'Q' )
       OR i_lineas-zinordp NOT IN aufnr OR i_lineas-zinordint NOT IN idnlf.
      DELETE i_lineas INDEX indice.
    ELSE.
      IF numc > 0.
        READ TABLE tabc WITH KEY aufnr = i_lineas-zinordp.
        IF sy-subrc <> 0.
*          delete i_lineas index indice.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
*For the current year or previous years, only use values from the REP version.
*REP
  LOOP AT i_lineas  WHERE zinver = 'REP'.
*For each year, create one record.
    IF i_lineas-zinordint IN idnlf AND i_lineas-zinordp IN aufnr.
*Only records corresponding to the orders or codes selected on the
*initial selection screen.
*Year 1
      IF i_lineas-zinano0 > anoact.
        muay = i_lineas-zinano0.
        muac = i_lineas-zinimp0_eur.
        muav  = i_lineas-zining0_eur.

        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano1 > anoact.
        muay = i_lineas-zinano1.
        muac = i_lineas-zinimp1_eur.
        muav  = i_lineas-zining1_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano2 > anoact.
        muay = i_lineas-zinano2.
        muac = i_lineas-zinimp2_eur.
        muav  = i_lineas-zining2_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano3 > anoact.
        muay = i_lineas-zinano3.
        muac = i_lineas-zinimp3_eur.
        muav  = i_lineas-zining3_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano4 > anoact.
        muay = i_lineas-zinano4.
        muac = i_lineas-zinimp4_eur.
        muav  = i_lineas-zining4_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano5 > anoact.
        muay = i_lineas-zinano5.
        muac = i_lineas-zinimp5_eur.
        muav  = i_lineas-zining5_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano6 > anoact.
        muay = i_lineas-zinano6.
        muac = i_lineas-zinimp6_eur.
        muav  = i_lineas-zining6_eur.
        PERFORM addmuarec.

      ENDIF.

      IF i_lineas-zinano7 > anoact.
        muay = i_lineas-zinano7.
        muac = i_lineas-zinimp7_eur.
        muav  = i_lineas-zining7_eur.
        PERFORM addmuarec.
      ENDIF.

      IF i_lineas-zinano8 > anoact.
        muay = i_lineas-zinano8.
        muac = i_lineas-zinimp8_eur.
        muav  = i_lineas-zining8_eur.
        PERFORM addmuarec.
      ENDIF.

    ENDIF.
  ENDLOOP.
*we deduct duplicated investments.
  REFRESH tabx.

  LOOP AT i_lineas.
    tabx-bukrs = i_lineas-bukrs.
    tabx-aufnr = i_lineas-zinordp.
    IF i_lineas-zinver = 'REP'.
      i_lineas-zinimp0 = i_lineas-zinimp0 * -1.
      i_lineas-zining0 = i_lineas-zining0 * -1.
      i_lineas-zinimp1 = i_lineas-zinimp1 * -1.
      i_lineas-zining1 = i_lineas-zining1 * -1.
      i_lineas-zinimp2 = i_lineas-zinimp2 * -1.
      i_lineas-zining2 = i_lineas-zining2 * -1.
      i_lineas-zinimp3 = i_lineas-zinimp3 * -1.
      i_lineas-zining3 = i_lineas-zining3 * -1.
      i_lineas-zinimp4 = i_lineas-zinimp4 * -1.
      i_lineas-zining4 = i_lineas-zining4 * -1.
      i_lineas-zinimp5 = i_lineas-zinimp5 * -1.
      i_lineas-zining5 = i_lineas-zining5 * -1.
      i_lineas-zinimp6 = i_lineas-zinimp6 * -1.
      i_lineas-zining6 = i_lineas-zining6 * -1.
      i_lineas-zinimp7 = i_lineas-zinimp7 * -1.
      i_lineas-zining7 = i_lineas-zining7 * -1.
      i_lineas-zinimp8 = i_lineas-zinimp8 * -1.
      i_lineas-zining8 = i_lineas-zining8 * -1.
    ENDIF.
    tabx-muac = i_lineas-zinimp0.
    tabx-muav = i_lineas-zining0.
    tabx-yeari = i_lineas-zinano0.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp1.
    tabx-muav = i_lineas-zining1.
    tabx-yeari = i_lineas-zinano1.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp2.
    tabx-muav = i_lineas-zining2.
    tabx-yeari = i_lineas-zinano2.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp3.
    tabx-muav = i_lineas-zining3.
    tabx-yeari = i_lineas-zinano3.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp4.
    tabx-muav = i_lineas-zining4.
    tabx-yeari = i_lineas-zinano4.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp5.
    tabx-muav = i_lineas-zining5.
    tabx-yeari = i_lineas-zinano5.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp6.
    tabx-muav = i_lineas-zining6.
    tabx-yeari = i_lineas-zinano6.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp7.
    tabx-muav = i_lineas-zining7.
    tabx-yeari = i_lineas-zinano7.
    COLLECT tabx.
    tabx-muac = i_lineas-zinimp8.
    tabx-muav = i_lineas-zining8.
    tabx-yeari = i_lineas-zinano8.
    COLLECT tabx.
  ENDLOOP.
  DELETE tabx WHERE muac = 0 AND muav = 0.
  DELETE tabx WHERE yeari > anoact.
  SORT tabx.
  REFRESH tabxx.
  LOOP AT tabx.
    MOVE-CORRESPONDING tabx TO tabxx.
    COLLECT tabxx.
  ENDLOOP.

*iterate through all orders and calculate the difference between MUA and REP
  LOOP AT tabxx.
*once the difference for each order has been calculated


    LOOP AT tab
      WHERE bukrs = tab-bukrs
        AND aufnr = tabxx-aufnr
        AND yeari > anoact
        AND ( muac <> 0 OR muav <> 0 ).
      indice = sy-tabix.

      tab-muac = tab-muac + tabxx-muac.
      tab-muav = tab-muav + tabxx-muav.
*      if tab-muac < 0.
      tabxx-muac = tabxx-muac - tab-muac.
      IF tab-muac < 0.
        tab-muac = 0.
      ENDIF.

      tabxx-muav = tabxx-muav - tab-muav.
      IF tab-muav < 0.
        tab-muav = 0.
      ENDIF.
      MODIFY tab INDEX indice.
      EXIT.
    ENDLOOP.

  ENDLOOP.

ENDFORM.                    " MUADATA
