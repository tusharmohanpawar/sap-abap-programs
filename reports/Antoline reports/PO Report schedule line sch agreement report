*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM buscaorden .
  SUBMIT zpsipl002 WITH s_ano =  p_ano[]
                    WITH s_bukrs IN rg_bukrs
                    WITH k_mua = 'X'
                    WITH k_rep = 'X'
                    WITH k_amp = 'X '
                    WITH r_apr = ' '
                    WITH r_tod = 'X'
                    WITH k_inc = 'X'
                    WITH util  = 'X' AND RETURN.

  IMPORT i_lineas FROM MEMORY ID 'ZME07UTIL'.
  REFRESH tabc.
  LOOP AT i_lineas.
    indice = sy-tabix.
    IF ( i_lineas-zinordp+7(1) <> 'K' AND  i_lineas-zinordp+7(1) <> 'Q' )
       OR i_lineas-zinordp NOT IN aufnr OR i_lineas-zinordint NOT IN idnlf.
      DELETE i_lineas INDEX indice.
    ELSE.
      tabc-aufnr = i_lineas-zinordp.
      APPEND tabc.
    ENDIF.
  ENDLOOP.
  SORT tabc.
  DELETE ADJACENT DUPLICATES FROM tabc.

  IF tabc[] IS NOT INITIAL.
    SELECT ebeln
      INTO CORRESPONDING FIELDS OF TABLE tabi
      FROM ekkn
        FOR ALL ENTRIES IN tabc
      WHERE aufnr = tabc-aufnr
        AND kostl IN kostl
        AND ebeln IN ebeln.
  ELSE.
    SELECT ebeln
      INTO CORRESPONDING FIELDS OF TABLE tabi
      FROM ekkn
      WHERE aufnr IN aufnr
      AND kostl IN kostl
        AND ebeln IN ebeln.
  ENDIF.
  IF tabi[] IS NOT INITIAL.
    SELECT ko~ebeln INTO tabp-ebeln
    FROM ekpo AS po
    INNER JOIN ekko AS ko
    ON po~ebeln = ko~ebeln
      FOR ALL ENTRIES IN tabi
    WHERE ( po~werks IN rg_werks
      AND po~matkl IN matkl
      AND po~matkl IN rg_matkl
      AND po~matnr IN matnr
      AND po~ean11 IN ean11
      AND po~bednr IN bednr
      AND po~idnlf IN idnlf
      AND po~knttp IN knttp
      AND po~bstyp IN bstyp
      AND po~retpo IN retpo
      AND ko~bukrs IN rg_bukrs
      AND ko~aedat IN aedat
      AND ko~bstyp IN bstyp
      AND ko~ernam IN ernam
      AND ko~lifnr IN lifnr
      AND ko~bedat IN bedat
      AND ko~ekgrp IN ekgr )
      AND ko~ebeln = tabi-ebeln.
      COLLECT tabp.
    ENDSELECT.
  ENDIF.
ENDFORM.                    " BUSCAORDEN
