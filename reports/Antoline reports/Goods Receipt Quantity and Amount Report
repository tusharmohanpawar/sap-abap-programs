FORM precio.
  DATA: w_ekpo LIKE ekpo.
  tab-precio = 0.
  SELECT SINGLE * FROM a016 WHERE kappl = 'M'
                      AND  kschl = 'PB00'
                      AND  evrtn =  tab-ebeln
                      AND  evrtp =  tab-ebelp
                      AND  datab <= tab-budat
                      AND datbi  >= tab-budat.

  IF sy-subrc = 0.
    SELECT * FROM konp WHERE knumh = a016-knumh
                  AND kappl = 'M'
                  AND  kschl = 'PB00'
                  AND loevm_ko = space. "Deletion indicator
    ENDSELECT.

    tab-precio = ( konp-kbetr / konp-kpein ).
  ENDIF.
  IF tab-precio IS INITIAL.
    SELECT SINGLE * FROM ekpo INTO w_ekpo
      WHERE ebeln = tab-ebeln
        AND ebelp = tab-ebelp.
    IF w_ekpo-bstyp = 'F'.
      tab-precio = w_ekpo-netpr / w_ekpo-peinh.
    ENDIF.
  ENDIF.
ENDFORM.                    "precio
