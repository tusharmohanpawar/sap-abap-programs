FORM print USING pv_getpdf
                 pv_lifnr.

  DATA: lv_fm_name              TYPE rs38l_fnam,
        ls_control_parameters   TYPE ssfctrlop,
        ls_output_options       TYPE ssfcompop,
        lt_error_tab            TYPE tsferror,
        "LS_TCATALOG             TYPE TCATALOG,
        ls_document_output_info	TYPE ssfcrespd,
        ls_job_output_options   TYPE ssfcresop,
        lv_rspoptype            TYPE rspoptype,
*        LT_OUTTAB1              LIKE GT_OUTTAB1,
*        LS_OUTTAB1              LIKE LINE OF LT_OUTTAB1,
*        LS_WERKS_LIFNR          LIKE LINE OF  GT_WERKS_LIFNR,
*        LS_GLBE_HD              LIKE LINE OF  PT_GLBE_HD,
*        gs_job_output_info      TYPE ssfcrescl,
        bezei                   TYPE i,
        w_lfa1                  LIKE lfa1.


  CONCATENATE p_fotrn werks-low INTO p_fotrn.


*  LS_OUTPUT_SSFO_HD-TDOBJECT  = P_FOTRO.
*  LS_OUTPUT_SSFO_HD-TDNAME    = P_FOTRN.
*  LS_OUTPUT_SSFO_HD-TDID      = P_FOTRI.
*  LS_OUTPUT_SSFO_HD-TDSPRAS   = P_FOTRL.
*  "LS_OUTPUT_SSFO_HD-LOGO1     = P_LOGO.
*  LS_OUTPUT_SSFO_HD-BUDAT1    = sy-datlo.
*  LS_OUTPUT_SSFO_HD-BUDAT2    = sy-datlo.

