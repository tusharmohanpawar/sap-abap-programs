        internal_error       = 2
        send_error           = 3
        user_canceled        = 4
        OTHERS               = 5.
    IF sy-subrc <> 0.
*       Smart Forms: Lesen der Fehlertabelle nach Aufruf
      CALL FUNCTION 'SSF_READ_ERRORS'
        IMPORTING
          errortab = lt_error_tab.

    ENDIF.
*    ENDLOOP.
  ENDIF.

