        e_devtype     = lv_rspoptype.

    ls_output_options-tdprinter     = lv_rspoptype.
    ls_control_parameters-no_dialog = 'X'.
    ls_control_parameters-getotf    = 'X'.
  ELSE.
    ls_control_parameters-no_dialog = sy-batch.
    ls_output_options-tddest        = p_prtna.
    ls_output_options-tdimmed       = 'X'.

  ENDIF.



  lv_fm_name = space.

  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      formname           = p_formn
    IMPORTING
      fm_name            = lv_fm_name
    EXCEPTIONS
      no_form            = 1
      no_function_module = 2
      OTHERS             = 3.




  IF sy-subrc EQ 0 AND lv_fm_name NE space.
    CLEAR bezei.
    REFRESH lt_output_ssfo.
    LOOP AT tab3 WHERE lifnr = pv_lifnr.
      ADD 1 TO bezei.
      ls_output_ssfo-bezei = bezei.
      ls_output_ssfo-lifex = tab3-xblnr.
      ls_output_ssfo-budat = tab3-budat.
      ls_output_ssfo-bldat = tab3-bldat.
      ls_output_ssfo-matnr = tab3-matnr.
      ls_output_ssfo-sgtxt = tab3-txz01.
      ls_output_ssfo-menge = tab3-menge.
      ls_output_ssfo-meins = tab3-meins.
      ls_output_ssfo-charg = tab3-lichn.
      ls_output_ssfo-belnr = tab3-belnr.
*      ls_output_ssfo_hd-test = gv_test_run.
*      ls_output_ssfo_hd-ohne_ort_erhalt = p_fpara1.

      APPEND ls_output_ssfo TO lt_output_ssfo.

    ENDLOOP.
    ls_output_ssfo_hd-werks = tab3-werks.
    ls_output_ssfo_hd-erdat = sy-datlo."tab2-budat.
    ls_output_ssfo_hd-tdid = p_fotri.
    ls_output_ssfo_hd-tdspras = p_fotrl.
    ls_output_ssfo_hd-tdname = p_fotrn.
    ls_output_ssfo_hd-tdobject = p_fotro.
    ls_output_ssfo_hd-ohne_ort_erhalt = 'X'.
    ls_output_ssfo_hd-budat1 = budat-low.
    ls_output_ssfo_hd-budat2 = budat-high.
    ls_output_ssfo_hd-parnr = tab3-lifnr.

    CHECK lt_output_ssfo[] IS NOT INITIAL.

    CLEAR: gs_job_output_info, ls_document_output_info, ls_job_output_options.
*
    CLEAR w_lfa1.
    SELECT SINGLE * FROM lfa1 INTO w_lfa1 WHERE lifnr = tab3-lifnr.
    IF sy-subrc EQ 0 AND w_lfa1-spras IS NOT INITIAL.
      ls_control_parameters-langu = w_lfa1-spras.
      SET LANGUAGE w_lfa1-spras.
    ENDIF.

    CALL FUNCTION lv_fm_name
      EXPORTING
        control_parameters   = ls_control_parameters
        output_options       = ls_output_options
        user_settings        = space
        is_header1           = ls_output_ssfo_hd
      IMPORTING
        document_output_info = ls_document_output_info
        job_output_info      = gs_job_output_info
        job_output_options   = ls_job_output_options
      TABLES
        it_item1             = lt_output_ssfo
      EXCEPTIONS
