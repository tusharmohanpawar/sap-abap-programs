FORM p_print .
  REFRESH: tab2,tab3.
  CLEAR: tab2,tab3.
  LOOP AT tab WHERE xselp = 'X'.
    tab2 = tab.
    APPEND tab2.
    tab3 = tab.
    APPEND tab3.
  ENDLOOP.

  SORT tab2 BY lifnr ASCENDING ebeln ASCENDING.
  DELETE ADJACENT DUPLICATES FROM tab2 COMPARING lifnr.

* Table for sending attachments sorted by date
  SORT tab3 BY lifnr ASCENDING budat ASCENDING.
  LOOP AT tab2.

    PERFORM print USING '' tab2-lifnr.
  ENDLOOP.

ENDFORM.
