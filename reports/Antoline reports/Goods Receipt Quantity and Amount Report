FORM preciohq.
  DATA: dif TYPE p DECIMALS 2.
  DATA: difa TYPE p DECIMALS 2.

  tab-precio = 0.
  SELECT SINGLE * FROM a016 WHERE kappl = 'M'
                      AND  kschl = 'PB00'
                      AND  evrtn =  tab-ebeln_hq
                      AND  evrtp =  tab-ebelp_hq
                      AND  datab <= tab-budat
                      AND datbi  >= tab-budat.

  IF sy-subrc = 0.
    SELECT * FROM konp WHERE knumh = a016-knumh
                  AND kappl = 'M'
                  AND  kschl = 'PB00'
                  AND loevm_ko = space. "Deletion indicator
    ENDSELECT.

    tab-precio = ( konp-kbetr / konp-kpein ).

  ENDIF.

*Perform currency conversion
  dif = tab-netpr - tab-precio .
  IF dif < 0.
    dif = dif * -1.
  ENDIF.

  difa = 10  / 100.

  tab-imported = tab-menge * ( tab-netpr - tab-precio ).

  IF dif > difa.
*RED
    tab-icon = '@0A@'.

  ELSE.
    IF dif = 0.
*VERDE.
      tab-icon = '@08@'.
      tab-imported = 0.
    ELSE.
*YELLOW
      tab-icon = '@09@'.
    ENDIF.
  ENDIF.
ENDFORM.                    " PRECIO

FORM textos_posicion USING p_id LIKE thead-tdid.
  REFRESH i_lines.
  CLEAR i_lines.
  CLEAR i_fact-textp.
  CONCATENATE tab-ebeln tab-ebelp INTO d_name.
  CALL FUNCTION 'READ_TEXT'
    EXPORTING
*     CLIENT   = SY-MANDT
      id       = p_id
      language = d_spras
      name     = d_name
      object   = c_obj_pos
*     ARCHIVE_HANDLE          = 0
    IMPORTING
      header   = r_header
    TABLES
      lines    = i_lines
                 EXCEPTIONS
                 id
                 language
                 name
                 not_found
                 object
                 reference_check
                 wrong_access_to_archive.
  IF sy-subrc = 0.
    CLEAR tab-textp.
    LOOP AT i_lines.
      CONCATENATE i_fact-textp i_lines-tdline INTO i_fact-textp SEPARATED BY space.
