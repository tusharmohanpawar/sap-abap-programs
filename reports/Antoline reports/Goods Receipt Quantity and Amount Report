FORM mail.
  TYPE-POOLS: truxs.

  DATA:
    lv_bin_file         TYPE xstring,
    lt_lines            TYPE TABLE OF tline,
    lv_bin_filesize     TYPE i,
*        LT_OUTTAB1            LIKE GT_OUTTAB1,
*        LS_OUTTAB1            LIKE LINE OF LT_OUTTAB1,
    "LS_WERKS_LIFNR        LIKE LINE OF GT_WERKS_LIFNR,
*        LS_GLBE_HD            LIKE LINE OF GT_GLBE_HD,
    lv_subject          TYPE so_obj_des,  " Subject / Betreff
    lv_objdes_pdf       TYPE sood-objdes, " PDF Filename
    lv_objdes_txt       TYPE sood-objdes, " TXT Filename
*        LT_OUTPUT_TXT         TYPE TABLE OF TT_OUTPUT_TXT,
*        LS_OUTPUT_TXT         LIKE LINE OF LT_OUTPUT_TXT,
    lt_outtab_txt_sting TYPE truxs_t_text_data,
    ls_outtab_txt_sting LIKE LINE OF lt_outtab_txt_sting,
    lt_att_content_text TYPE soli_tab,
    ls_att_content_text LIKE LINE OF lt_att_content_text,
    lv_subject_periode  TYPE char10,
    lv_subject_partner  TYPE char10,
    gv_sep              VALUE cl_abap_char_utilities=>horizontal_tab,
    bezei               TYPE i,
    lv_adrnr            LIKE ekko-adrnr,
    t_addr              TYPE szadr_addr1_complete,
    t_adsmtp_tab        TYPE szadr_adsmtp_line,
    lv_persnumber       LIKE usr21-persnumber,
    lv_addrnumber       LIKE usr21-addrnumber,
    lv_rec1             LIKE adr6-smtp_addr,
    lv_rec2             LIKE adr6-smtp_addr.

*        LV_REC1               LIKE GV_SEL_SMTPA,
*        LV_REC2               LIKE GV_SEL_SMTPA,
*        LT_GLBE_HD            LIKE GT_GLBE_HD,
*        LV_DOCNUM     TYPE TT_OUTPUT_SSFO_HD-DOCNUM.

  DATA: lv_text       TYPE string,
        lv_date       TYPE string,
        lv_budat_low  TYPE string,
        lv_budat_high TYPE string
        .

  REFRESH: tab2,tab3.
  CLEAR: tab2,tab3.
  LOOP AT tab WHERE xselp = 'X'.
    tab2 = tab.
    APPEND tab2.
    tab3 = tab.
    APPEND tab3.

  ENDLOOP.

* INI - ECOIS23 14/09/2023
  SORT tab2 BY lifnr ASCENDING ebeln ASCENDING.
  DELETE ADJACENT DUPLICATES FROM tab2 COMPARING lifnr.
*  DELETE ADJACENT DUPLICATES FROM tab2 COMPARING ebeln.

* Table for sending attachments sorted by date
  SORT tab3 BY lifnr ASCENDING budat ASCENDING.

  CLEAR: lv_budat_low,lv_budat_high,lv_date,lv_text.
  REFRESH gt_mail_body.
  CONCATENATE budat-low+6(2) budat-low+4(2) budat-low(4) INTO lv_budat_low SEPARATED BY '.'.
  CONCATENATE budat-high+6(2) budat-high+4(2) budat-high(4) INTO lv_budat_high SEPARATED BY '.'.

  CONCATENATE 'Please find attached Goods receipt detail from' lv_budat_low 'to' lv_budat_high INTO lv_date SEPARATED BY space.

  CONCATENATE 'Dear Vendor,' cl_abap_char_utilities=>newline
              lv_date cl_abap_char_utilities=>newline
              'Request you to verify the receipts with your sales data & confirm all are in line as per records.'
              cl_abap_char_utilities=>newline
              'If you found missing Invoices, incorrect prices etc. please report us within 3 days on receipt of this communication.'
              'Delayed response will not be accepted beyond 3 days.'
              cl_abap_char_utilities=>newline
              'Thank you' INTO lv_text SEPARATED BY cl_abap_char_utilities=>newline.

* Assign the line to the table to be sent
  CALL FUNCTION 'SCMS_STRING_TO_FTEXT'
    EXPORTING
      text      = lv_text
    TABLES
      ftext_tab = gt_mail_body.
* FIN - ECOIS23-473 14/09/2023

  DATA l_index TYPE sy-tabix.
  DATA send_request  TYPE REF TO cl_bcs.
  DATA document      TYPE REF TO cl_document_bcs.
  DATA recipient     TYPE REF TO if_recipient_bcs.
  DATA lv_length     TYPE i.
  DATA lv_werks3     TYPE char3.

  LOOP AT tab2.

    CLEAR lv_length.

    l_index = sy-tabix.

    lv_length = strlen( tab2-werks ).
    IF lv_length EQ '3'.
      MOVE tab2-werks TO lv_werks3.
      CONCATENATE 'Goods Receipt–SPR AUTO INTERIOR' space lv_werks3 '–' lv_budat_low space 'to' space lv_budat_high INTO lv_subject RESPECTING BLANKS.
    ELSE.
      CONCATENATE 'Goods Receipt–SPR AUTO INTERIOR' space tab2-werks '–' lv_budat_low space 'to' space lv_budat_high INTO lv_subject RESPECTING BLANKS.
    ENDIF.

    "CONCATENATE 'Goods Receipt–Antolin' space tab2-werks '–' lv_budat_low space 'to' space lv_budat_high INTO lv_subject RESPECTING BLANKS.

*    PERFORM print USING 'X' tab2-ebeln.
    PERFORM print USING 'X' tab2-lifnr.

    CALL FUNCTION 'CONVERT_OTF'
      EXPORTING
        format       = 'PDF'
      IMPORTING
        bin_filesize = lv_bin_filesize
        bin_file     = lv_bin_file
      TABLES
        otf          = gs_job_output_info-otfdata
        lines        = lt_lines
      EXCEPTIONS
        OTHERS       = 1.

    CLEAR lv_adrnr.

    SELECT SINGLE adrnr FROM ekko INTO lv_adrnr WHERE ebeln = tab2-ebeln.

    IF lv_adrnr IS INITIAL.
      SELECT SINGLE adrnr FROM lfa1 INTO lv_adrnr WHERE lifnr = tab2-lifnr.
    ENDIF.

    CLEAR t_addr.

    CALL FUNCTION 'ADDR_GET_COMPLETE'
      EXPORTING
        addrnumber              = lv_adrnr
*       ADDRHANDLE              =
*       ARCHIVE_HANDLE          =
*       IV_CURRENT_COMM_DATA    = 'X'
*       BLK_EXCPT               =
      IMPORTING
        addr1_complete          = t_addr
      EXCEPTIONS
        parameter_error         = 1
        address_not_exist       = 2
        internal_error          = 3
        wrong_access_to_archive = 4
        address_blocked         = 5
        OTHERS                  = 6.

    CLEAR lv_rec1.
    READ TABLE t_addr-adsmtp_tab INTO t_adsmtp_tab WITH KEY adsmtp-flgdefault = 'X'.
    IF sy-subrc = 0.
      lv_rec1 = t_adsmtp_tab-adsmtp-smtp_addr.
    ENDIF.

* Now get the email of the user executing it
    CLEAR: lv_persnumber, lv_addrnumber.

    SELECT SINGLE persnumber addrnumber FROM usr21 INTO (lv_persnumber, lv_addrnumber)
      WHERE bname = sy-uname.

    SELECT SINGLE smtp_addr FROM adr6 INTO lv_rec2
      WHERE addrnumber = lv_addrnumber
        AND persnumber = lv_persnumber.

    PERFORM output_email_create TABLES lt_att_content_text " Text Attachment
                                 USING lv_bin_file         " PDF Attachment
                                       lv_bin_filesize     " PDF File Size
                                       lv_subject          " Mail Subject
                                       lv_objdes_pdf       " PDF Filename
                                       lv_objdes_txt       " TXT Filename
                                       lv_rec1             " Mail Empfänger 1
                                       lv_rec2             " Mail Empfänger 2
                                       tab2-lifnr.

  ENDLOOP.
ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  OUTPUT_EMAIL_CREATE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_ATT_CONTENT_TEXT  text
*      -->P_LV_BIN_FILE  text
*      -->P_LV_BIN_FILESIZE  text
*      -->P_LV_SUBJECT  text
*      -->P_LV_OBJDES_PDF  text
*      -->P_LV_OBJDES_TXT  text
*      -->P_LV_REC1  text
*      -->P_LV_REC2  text
*----------------------------------------------------------------------*
FORM output_email_create TABLES pt_attach_txt         STRUCTURE soli
                         USING  pv_bin_file_pdf       TYPE xstring
                                pv_bin_filesize_pdf   TYPE i
                                pv_subject            TYPE so_obj_des
                                pv_objdes_pdf         TYPE sood-objdes
                                pv_objdes_txt         TYPE sood-objdes
                                pv_rec1               LIKE adr6-smtp_addr
                                pv_rec2               LIKE adr6-smtp_addr
                                pv_lifnr              TYPE lifnr.

  DATA: lt_attach_txt TYPE soli_tab,
        ls_attach_txt LIKE LINE OF lt_attach_txt,
        lt_attach_xls TYPE soli_tab,
        ls_attach_xls LIKE LINE OF lt_attach_txt,
        lt_att_head   TYPE soli_tab,
        ls_att_head   LIKE LINE OF lt_att_head.

  lt_attach_txt[] = pt_attach_txt[].


  DATA send_request  TYPE REF TO cl_bcs.
  DATA document      TYPE REF TO cl_document_bcs.
  DATA recipient     TYPE REF TO if_recipient_bcs.
  DATA bcs_exception TYPE REF TO cx_bcs.
  DATA sent_to_all   TYPE os_boolean.
  DATA pdf_size      TYPE so_obj_len.
  DATA pdf_content   TYPE solix_tab.
  DATA pdf_xstring   TYPE xstring.
  DATA: dec_menge    TYPE p DECIMALS 2,
        dec_netpr    TYPE p DECIMALS 2,
        dec_precio   TYPE  p DECIMALS 2,
        dec_wrbtr    TYPE  p DECIMALS 2,
        txt_menge    TYPE string,
        txt_netpr    TYPE string,
        txt_precio   TYPE string,
        txt_wrbtr    TYPE string,
        txt_budat    TYPE string,
        txt_bldat    TYPE string,
        txt_werks(3).

  CONSTANTS:
    lc_tab  TYPE c VALUE cl_bcs_convert=>gc_tab,
    lc_crlf TYPE abap_cr_lf VALUE cl_abap_char_utilities=>cr_lf.

  DATA: lv_line           TYPE string,
        lv_binary_content TYPE solix_tab,
        lv_size           TYPE so_obj_len.

*     -------- create persistent send request ------------------------
  send_request = cl_bcs=>create_persistent( ).


*     create the document with attachments
*     main document
  document = cl_document_bcs=>create_document(
                            i_type    = 'RAW'
                            i_text    = gt_mail_body
                            i_subject = pv_subject ).

  " PDF Attachment
  pdf_content = cl_document_bcs=>xstring_to_solix( pv_bin_file_pdf ).
  pdf_size    = pv_bin_filesize_pdf.

  document->add_attachment( i_attachment_type    = 'PDF'
                            i_attachment_subject = pv_objdes_pdf
                            i_attachment_size    = pdf_size
                            i_att_content_hex    = pdf_content ).

  " CSV Attachment
  CONCATENATE
  'PLANT' lc_tab
  'MOVEMENT TYPE' lc_tab
  'DOC. DATE' lc_tab
  'REFERENCE' lc_tab
  'MATERIAL DOCUMENT' lc_tab
  'POSTING DATE' lc_tab
  'MATERIAL' lc_tab
  'DESCRIPTION' lc_tab
  'GR QTY' lc_tab
  'UNIT' lc_tab
  'PURCHASE DOC' lc_tab
  'UNIT PRICE' lc_tab
  'PURCHASE PRICE' lc_tab
  'AMOUNT' lc_tab
  'CURRENCY' lc_tab
  lc_crlf
  INTO lv_line.


  LOOP AT tab3 WHERE xselp = 'X' AND lifnr = pv_lifnr.
    txt_werks  = tab3-werks.

    dec_menge  = tab3-menge.
    dec_netpr  = tab3-netpr.
    dec_precio = tab3-precio.
    dec_wrbtr  = tab3-wrbtr.

    MOVE dec_menge TO txt_menge.
    MOVE dec_netpr TO txt_netpr.
    MOVE dec_precio TO txt_precio.
    MOVE dec_wrbtr TO txt_wrbtr.

*    INI - ECOIS23-473 14/09/2023 Date format dd-mm-yyyy
    CLEAR: txt_bldat,txt_budat.
    CONCATENATE tab3-bldat+6(2) tab3-bldat+4(2) tab3-bldat(4) INTO txt_bldat SEPARATED BY '-'.
    CONCATENATE tab3-budat+6(2) tab3-budat+4(2) tab3-budat(4) INTO txt_budat SEPARATED BY '-'.
*    FIN - ECOIS23-473 14/09/2023 Date format dd-mm-yyyy

    CONCATENATE lv_line txt_werks lc_tab tab3-bwart lc_tab txt_bldat lc_tab tab3-xblnr lc_tab tab3-belnr lc_tab txt_budat lc_tab
    tab3-matnr lc_tab tab3-txz01 lc_tab txt_menge lc_tab tab3-meins lc_tab tab3-ebeln lc_tab txt_netpr lc_tab txt_precio lc_tab
    txt_wrbtr lc_tab tab3-waers lc_tab lc_crlf INTO lv_line.

  ENDLOOP.

  TRY.
      cl_bcs_convert=>string_to_solix(
        EXPORTING
          iv_string   = lv_line
          iv_codepage = '4103'  "suitable for MS Excel, leave empty
          iv_add_bom  = 'X'     "for other doc types
        IMPORTING
          et_solix  = lv_binary_content
          ev_size   = lv_size ).
    CATCH cx_bcs.
      MESSAGE e445(so).
  ENDTRY.

*     add the spread sheet as attachment to document object
  document->add_attachment(
    i_attachment_type    = 'XLS'
    i_attachment_subject = pv_objdes_txt
    i_attachment_size    = lv_size
    i_att_content_hex    = lv_binary_content ).


*     add document object to send request
  send_request->set_document( document ).

*     --------- add recipient (e-mail address) -----------------------
  IF pv_rec1 IS NOT INITIAL.
*       create recipient object
    recipient = cl_cam_address_bcs=>create_internet_address( pv_rec1 ).
*       add recipient object to send request
    send_request->add_recipient( recipient ).
  ENDIF.
  IF pv_rec2 IS NOT INITIAL.
*       create recipient object
    recipient = cl_cam_address_bcs=>create_internet_address( pv_rec2 ).
*       add recipient object to send request
    send_request->add_recipient( recipient ).
  ENDIF.

*     ---------- send document ---------------------------------------
  sent_to_all = send_request->send( i_with_error_screen = 'X' ).

  COMMIT WORK.

  IF sent_to_all IS INITIAL.
    MESSAGE i500(sbcoms) WITH pv_rec1.
  ELSE.
    MESSAGE s022(so).
  ENDIF.
ENDFORM.
