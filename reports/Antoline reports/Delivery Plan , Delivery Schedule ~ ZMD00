*&---------------------------------------------------------------------*
*&      Form  user_command
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->R_UCOMM      text
*      -->RS_SELFIELD  text
*----------------------------------------------------------------------*
FORM user_command USING r_ucomm LIKE sy-ucomm
                        rs_selfield TYPE slis_selfield .

  rs_selfield-refresh    = 'X'.
  rs_selfield-col_stable = 'X'.
  rs_selfield-row_stable = 'X'.
  READ TABLE i_linea INDEX rs_selfield-tabindex.
  IF sy-subrc = 0.
    i_linea-xselp = 'X'.
    MODIFY i_linea INDEX sy-tabix.
  ENDIF.
  i_linea2[] = i_linea[].
  SORT i_linea2.
  IF  r_ucomm <> 'ENVIA'.
    LOOP AT i_linea2 WHERE xselp = 'X'.
      AT NEW ebeln.
        r_ekko-ebeln = i_linea2-ebeln.

        READ TABLE i_linea INDEX rs_selfield-tabindex.
        IF i_linea-memory = ' '.
          CASE r_ucomm.
            WHEN 'AUT' OR 'NEW'.
              PERFORM seleccion_datos_impresion.
          ENDCASE.
          CASE r_ucomm.
            WHEN  'AUT'.
              PERFORM liberapedido.
            WHEN 'CANC'.
              PERFORM cancelar.
            WHEN 'ANUL'.
              PERFORM anulacion.
            WHEN 'FILE'.
              PERFORM anexar.
            WHEN  'NEW'.
              PERFORM impresion_new.
            WHEN  OTHERS.
              READ TABLE i_linea INDEX rs_selfield-tabindex.
              CASE rs_selfield-fieldname.
                WHEN 'EBELN'.
                  IF i_linea-bstyp = 'L'.
                    PERFORM modifica.
                  ELSE.
                    PERFORM modificac.
                  ENDIF.
                WHEN 'STATUS'.
                  PERFORM wfhistorico.

              ENDCASE.
          ENDCASE.
        ELSE.

          MESSAGE e045(mepo) WITH i_linea-ebeln.
*   El pedido & no se ha completado aún

        ENDIF.
      ENDAT.
    ENDLOOP.
    PERFORM statuspedido.
  ELSE.
    PERFORM enviapre.
  ENDIF.
*----------------------------------------------------------------------*

ENDFORM.                    "user_command
