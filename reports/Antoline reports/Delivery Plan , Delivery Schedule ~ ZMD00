FORM avisobmw.

  DATA: sw(1).
  sw = 0.
  LOOP AT i_detalle WHERE banfn <> space.
    SELECT SINGLE * FROM eban WHERE banfn = i_detalle-banfn AND bnfpo = i_detalle-bnfpo.
    IF sy-subrc = 0.
      SELECT SINGLE * FROM zpuautp WHERE zzproyecto = eban-zzproyecto.
      IF sy-subrc = 0.
        IF zpuautp-kunnr = '17' AND i_detalle-impuesto = 'X' AND sw = 0.
          MESSAGE i703(ra) WITH TEXT-004.
          sw = 1.
          CONTINUE.
        ENDIF.

      ENDIF.
    ENDIF.
  ENDLOOP.

ENDFORM.                    " AVISOBW
