*  <--  p2        text
*----------------------------------------------------------------------*
FORM anexar .
  DATA: manager TYPE REF TO cl_gos_manager,
        obj     TYPE borident,
        ok_code TYPE sy-ucomm.

  CLEAR obj.

  obj-objkey =   i_linea-ebeln.

  CASE i_linea-bstyp.
    WHEN 'L'.
      obj-objtype = 'BUS2013'.
    WHEN 'F'.
      obj-objtype = 'BUS2012'.
    WHEN 'A'.
      obj-objtype = 'BUS2011'.
  ENDCASE.

  CREATE OBJECT manager
    EXPORTING
      ip_no_commit = 'R'
    EXCEPTIONS
      OTHERS       = 1.

  CALL METHOD manager->start_service_direct
    EXPORTING
      ip_service       = 'PCATTA_CREA'
      is_object        = obj
    EXCEPTIONS
      no_object        = 1
      object_invalid   = 2
      execution_failed = 3
      OTHERS           = 4.

ENDFORM.                    " ANEXAR
