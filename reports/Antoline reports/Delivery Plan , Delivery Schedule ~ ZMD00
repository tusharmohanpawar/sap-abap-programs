*&      Form  WFHISTORICO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM wfhistorico .
  DATA: BEGIN OF tabs OCCURS 0.
          INCLUDE STRUCTURE zbapifirmasx.
        DATA: END OF tabs,
        ls_usr03 TYPE usr03.
  DATA(lo_wfpo) = NEW z_mm_wf_po( crear = abap_false
                                  wfapli = CONV #( 'WF_POO' )
                                  wfnum = CONV #( i_linea-wfnum )
                                ).
  DATA: lt_agentes TYPE TABLE OF zhrwfa,
        lt_firmas  TYPE TABLE OF zhrwfah.
  lo_wfpo->get_agentes( IMPORTING agentes = lt_agentes ).
  lo_wfpo->get_firmas( IMPORTING firmas = lt_firmas ).

  CLEAR tabs[].
  LOOP AT lt_agentes INTO DATA(ls_agente).
    CLEAR tabs.
    MOVE-CORRESPONDING ls_agente TO tabs.
    SELECT SINGLE * INTO @DATA(ls_p0002)
      FROM pa0002
     WHERE pernr = @ls_agente-pernr
       AND begda <= @sy-datum
       AND endda >= @sy-datum.
    IF sy-subrc = 0.
      tabs-name1 = |{ ls_p0002-vorna } { ls_p0002-nachn } | &&
                   |{ ls_p0002-nach2 }|.
    ELSE. "buscamos por usuario.
      ls_usr03-bname = ls_agente-tipo+8(12).
      CALL FUNCTION 'SUSR_USER_ADDRESS_READ'
        EXPORTING
          user_name              = ls_usr03-bname
          read_db_directly       = ' '
        IMPORTING
          user_usr03             = ls_usr03
        EXCEPTIONS
          user_address_not_found = 1
          OTHERS                 = 2.
      IF sy-subrc = 0.
        tabs-name1 = |{ ls_usr03-name1 } { ls_usr03-name2 }|.
      ENDIF.
    ENDIF.

    tabs-decision = 'PEN'.
    ASSIGN lt_firmas[ pernr = ls_agente-pernr ] TO FIELD-SYMBOL(<lf_firma>).
    IF <lf_firma> IS ASSIGNED.
      MOVE-CORRESPONDING <lf_firma> TO tabs.
    ENDIF.
    UNASSIGN <lf_firma>.

    APPEND tabs.
  ENDLOOP.
*  SELECT * FROM zhrwfa WHERE wfapli = 'WF_POO' AND wfnum = i_linea-wfnum
*  .
