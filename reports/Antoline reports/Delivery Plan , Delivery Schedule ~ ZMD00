FORM liberapedido .
  DATA: codea LIKE sy-subrc.
  DATA: msg LIKE massmsg.
  READ TABLE i_detalle INDEX 1.
  SELECT SINGLE * FROM ekko INTO CORRESPONDING FIELDS OF  cekko
    WHERE ebeln = i_detalle-ebeln.


  LOOP AT i_detalle.
    MOVE-CORRESPONDING i_detalle TO t_ebelp.
    APPEND t_ebelp.
    MOVE-CORRESPONDING i_detalle TO t_a016.
    t_a016-evrtn = i_detalle-ebeln.
    t_a016-evrtp = i_detalle-ebelp.
    APPEND t_a016.
  ENDLOOP.

  DELETE ADJACENT DUPLICATES FROM t_ebelp.
  DELETE ADJACENT DUPLICATES FROM t_a016.
*solicitamos autorizacion para el pedido y versión.
*cada una de las posiciones de la a016 ya están marcadas con la versión
*correspondiente
  PERFORM avisobmw.
  CALL FUNCTION 'ZBAPI_PO_REQUEST'
    EXPORTING
      t_ekko = cekko
*     NOFIRMAS                 =
    IMPORTING
      msg    = msg
      code   = codea
    TABLES
      t_ekpo = t_ebelp
      t_a016 = t_a016.
  IF codea <> 99.

*ACTUALIZAMOS LA VERSIÓN
    IF sy-subrc = 0.
      SELECT SINGLE * FROM ekko INTO CORRESPONDING FIELDS OF  cekko
         WHERE ebeln = i_detalle-ebeln.

      LOOP AT t_a016.
        READ TABLE i_linea WITH KEY knumh = t_a016-knumh ebeln =
        t_a016-evrtn ebelp = t_a016-evrtp.
        IF sy-subrc = 0.
          i_linea-revno = cekko-revno.
          MODIFY i_linea INDEX sy-tabix.
        ENDIF.
      ENDLOOP.
    ENDIF.
    IF msg IS NOT INITIAL.
*ACTUALIZAMOS LISTADO.
      CONCATENATE msg-msgv2(10)  msg-msgv2+10(8) INTO msg-msgv2 SEPARATED
      BY '/'.
      MESSAGE i200(kpep) WITH '@08@' msg-msgv1 msg-msgv2 msg-msgv3.
    ENDIF.
    PERFORM enviapre.
  ELSE.
    MESSAGE i200(kpep) WITH '@0A@' msg-msgv1 msg-msgv2 msg-msgv3.

  ENDIF.

ENDFORM.                    " LIBERAPEDIDO
