*&      Form  SELECCION_CONDICIONES
*&---------------------------------------------------------------------*
* Selección de las condiciones de las posiciones para plan de entrega  *
*----------------------------------------------------------------------*
FORM seleccion_condiciones.
  REFRESH i_condiciones.
  LOOP AT i_ekpo.
    REFRESH i_aux_cond.
    IF i_ekpo-pstyp NE '2'.
      SELECT * FROM a016 WHERE kappl = c_kappl
                          AND  kschl = c_clase_con
                          AND  evrtn = r_ekko-ebeln
                          AND  evrtp = i_ekpo-ebelp.
        CLEAR i_aux_cond.
        i_aux_cond-ebelp = i_ekpo-ebelp.
        i_aux_cond-datab = a016-datab.
        i_aux_cond-datbi = a016-datbi.
        i_aux_cond-knumh = a016-knumh.
        APPEND i_aux_cond.
      ENDSELECT.
      IF sy-subrc <> 0 AND r_ekko-bstyp = 'A'.
        i_aux_cond-ebelp = i_ekpo-ebelp.
        APPEND i_aux_cond.
      ENDIF.
      d_flag = space.
      PERFORM validacion_fecha.
*   Consigna.
    ELSE.
      SELECT SINGLE * FROM ekko
               WHERE ebeln = i_ekpo-ebeln.
      SELECT * FROM a017   WHERE kappl = c_kappl
                           AND kschl = c_clase_con
                           AND lifnr = ekko-lifnr
                           AND matnr = i_ekpo-matnr
                           AND werks = i_ekpo-werks
                           AND esokz = '2'.
        CLEAR i_aux_cond.
        i_aux_cond-ebelp = i_ekpo-ebelp.
        i_aux_cond-datab = a017-datab.
        i_aux_cond-datbi = a017-datbi.
        i_aux_cond-knumh = a017-knumh.
        APPEND i_aux_cond.
      ENDSELECT.
      d_flag = space.
      PERFORM validacion_fecha.


    ENDIF.
  ENDLOOP.
  LOOP AT i_condiciones.
*Precio Bruto del proveedor para cada condición, moneda y base
    SELECT * FROM konp WHERE knumh = i_condiciones-knumh
                       AND  kschl = c_clase_con
                       AND loevm_ko = space. "Indicador de borrado
      IF i_ekpo-retpo = 'X'.
        i_condiciones-precio_prov = konp-kbetr * - 1.

      ELSE.
        i_condiciones-precio_prov = konp-kbetr.
      ENDIF.
      SELECT SINGLE * FROM tcurx WHERE currkey = konp-konwa.
      IF sy-subrc = 0.
        IF tcurx-currdec = 0.
          "Ejemplo: El yen (JYP) hay que multiplicarlo por 100
          i_condiciones-precio_prov = i_condiciones-precio_prov * 100 .
        ELSEIF tcurx-currdec = 1.
          i_condiciones-precio_prov = i_condiciones-precio_prov / 10 .
        ENDIF.
      ENDIF.
      i_condiciones-base = konp-kpein.
      i_condiciones-moneda = konp-konwa.
    ENDSELECT.
    IF  i_condiciones-precio_prov = 0.
      SELECT * FROM konp WHERE knumh = i_condiciones-knumh
                         AND  kschl = 'UTIL'
                         AND loevm_ko = space. "Indicador de borrado
        i_condiciones-precio_prov = konp-kbetr.
        IF konp-kpein = 0.
          konp-kpein = 1.
        ENDIF.
        i_condiciones-base = konp-kpein.
        i_condiciones-moneda = konp-konwa.
      ENDSELECT.
    ENDIF.
*incoterms
    SELECT SINGLE * FROM konh WHERE knumh = i_condiciones-knumh
                               AND kappl = c_kappl
                               AND kschl = c_clase_con.
    IF sy-subrc = 0.
*****************************************************
      IF konh-revno <> space.
        i_condiciones-revno = konh-revno.
      ENDIF.
*****************************************************
      IF konh-inco1 <> space.
        i_condiciones-inco1 = konh-inco1.
        i_condiciones-inco2 = konh-inco2.
      ENDIF.
      i_condiciones-banfn = konh-banfn.
      i_condiciones-bnfpo = konh-bnfpo.

      i_condiciones-impuesto = konh-impuesto.

    ENDIF.

    i_ekpo-aedat = konh-erdat.
*Condición del precio ZIND
    SELECT * FROM konp WHERE knumh = i_condiciones-knumh
                       AND  kschl = c_clase_ind
                       AND loevm_ko = space. "Indicador de borrado
      i_condiciones-cant_zind = konp-kbetr.
      i_condiciones-base_zind = konp-kpein.
      i_condiciones-mond_zind = konp-konwa.
    ENDSELECT.
    IF num <> 0.
      indice = sy-tabix.
      READ TABLE tabs WITH KEY banfn = i_condiciones-banfn bnfpo =
i_condiciones-bnfpo.
      IF sy-subrc <> 0.
        DELETE i_condiciones INDEX indice.
      ELSE.
        MODIFY i_condiciones.
        APPEND i_condiciones TO i_condiciones_tot.

      ENDIF.
    ELSE.
      MODIFY i_condiciones.
      APPEND i_condiciones TO i_condiciones_tot.
    ENDIF.
  ENDLOOP.
ENDFORM.                               " SELECCION_CONDICIONES
*&---------------------------------------------------------------------*
*&      Form  VALIDACION_FECHA
*&---------------------------------------------------------------------*
*  Validación de la fecha de vigencia indicada en la pantalla de       *
* selección con respecto a las fechas de las condiciones.              *
*----------------------------------------------------------------------*
FORM validacion_fecha.
*Se diferencian los casos dependiendo del radiobotton pulsado
  SORT i_aux_cond ASCENDING BY datab.
  LOOP AT i_aux_cond.
    CLEAR i_condiciones.
*vigente
    IF r_ekko-bstyp = 'A'.
      i_condiciones-ebelp = i_aux_cond-ebelp.
      i_condiciones-datab = i_aux_cond-datab.
      i_condiciones-knumh = i_aux_cond-knumh.
      APPEND i_condiciones.
      EXIT.
    ELSE.
      IF p_rb_pvi = 'X'.
        IF i_aux_cond-datab <= p_fecha AND
                i_aux_cond-datbi >= p_fecha.
          i_condiciones-ebelp = i_aux_cond-ebelp.
          i_condiciones-datab = i_aux_cond-datab.
          i_condiciones-knumh = i_aux_cond-knumh.
          APPEND i_condiciones.
          EXIT.
        ENDIF.

*vigentes y futuros
      ELSEIF p_rb_pvf = 'X'.
        IF d_flag = 'X'. "Después de la 1ª fecha correcta, introduzco
          " todas las demás en i_condiciones
          i_condiciones-ebelp = i_aux_cond-ebelp.
          i_condiciones-datab = i_aux_cond-datab.
          i_condiciones-knumh = i_aux_cond-knumh.
          APPEND i_condiciones.
        ELSE.
*SI SON FUTUROS Y ES LA PRIMER PRECIO
*antes                      <=
          IF i_aux_cond-datab <= p_fecha AND
             i_aux_cond-datbi >= p_fecha.
            i_condiciones-ebelp = i_aux_cond-ebelp.
            i_condiciones-datab = i_aux_cond-datab.
            i_condiciones-knumh = i_aux_cond-knumh.
            APPEND i_condiciones.
            d_flag = 'X'.
            "Tras el primer resultado positivo, marco flag.
*
          ELSE.
            IF i_aux_cond-datab > p_fecha.
              i_condiciones-ebelp = i_aux_cond-ebelp.
              i_condiciones-datab = i_aux_cond-datab.
              i_condiciones-knumh = i_aux_cond-knumh.
              APPEND i_condiciones.
              d_flag = 'X'.
              "Tras el primer resultado positivo, marco flag.
            ENDIF.
          ENDIF.
        ENDIF.
      ELSEIF p_rb_his = 'X'.
        i_condiciones-ebelp = i_aux_cond-ebelp.
        i_condiciones-datab = i_aux_cond-datab.
        i_condiciones-datbi = i_aux_cond-datbi.
        i_condiciones-knumh = i_aux_cond-knumh.
        APPEND i_condiciones.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                               " VALIDACION_FECHA
