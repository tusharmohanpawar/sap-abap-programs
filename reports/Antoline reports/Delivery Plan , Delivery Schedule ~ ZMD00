************************************************************************
*                  LOGICA DEL PROGRAMA
************************************************************************
*----------------------------------------------------------------------*
* VALIDACIONES DE PARAMETROS
*----------------------------------------------------------------------*
AT SELECTION-SCREEN.
*Validación de fecha de última modificación de la posición
  IF p_aedat IS INITIAL.
    d_fecha_mod = '%'.
  ELSE.
    d_fecha_mod = '*'.
  ENDIF.
*Validación del nº de documento
  SELECT COUNT(*) INTO d_num FROM ekko WHERE ebeln IN p_ebeln
                            AND   loekz = space. "Indicador de borrado
  IF sy-subrc <> 0.
    MESSAGE ID 'SE' TYPE 'E' NUMBER '451'.
*  ELSE.
*    IF D_NUM > 1.
*      MESSAGE ID 'ZP' TYPE 'W' NUMBER '999' WITH TEXT-019.
*    ENDIF.
  ENDIF.

* Comprobamos que los pedidos a imprimir no necesitan ser liberados.
  SELECT * FROM ekko
      WHERE ebeln IN p_ebeln.
*   Pedido sujeto a estr. de liberación
    IF NOT ekko-frggr IS INITIAL.
*     Comprobamos que el estatus no es el de bloqueado (X).
      IF ekko-frgke = 'X'.
        MESSAGE ID 'M8' TYPE 'E' NUMBER '407' WITH ekko-ebeln.
      ENDIF.
    ENDIF.
  ENDSELECT.

*----------------------------------------------------------------------*
* INICIALIZACION ANTES DE PEDIR LOS PARAMETROS
*----------------------------------------------------------------------*
INITIALIZATION.
  p_rb_pvi = 'X'.

  p_fecha = sy-datum.
  DATA: d_uname LIKE sy-uname.
  MOVE sy-uname TO d_uname.
*buscamos u numero de personal
  SELECT SINGLE * FROM usr21 WHERE bname = d_uname.
  IF sy-subrc = 0.
    SELECT SINGLE * FROM adr6 WHERE addrnumber = usr21-addrnumber AND
    persnumber = usr21-persnumber.
    IF sy-subrc = 0.
      SELECT SINGLE * FROM pa0105 WHERE usrid_long =  adr6-smtp_addr
      AND subty = '0010' AND begda <= sy-datum
         AND endda >= sy-datum.
      IF sy-subrc = 0.
        MOVE pa0105-pernr TO numerop.
      ENDIF.
    ENDIF.
    IF numerop = 0.
      SELECT * FROM adcp WHERE addrnumber = usr21-addrnumber AND
      persnumber = usr21-persnumber.
        MOVE adcp-roomnumber TO numerop.
      ENDSELECT.
    ENDIF.
    CALL FUNCTION 'SUSR_USER_PARAMETERS_GET'
      EXPORTING
        user_name       = sy-uname
*       WITH_TEXT       =
      TABLES
        user_parameters = ls_para.
*         EXCEPTIONS
*           USER_NAME_NOT_EXIST       = 1
*           OTHERS                    = 2
    .
    IF sy-subrc = 0.
      LOOP AT ls_para WHERE parid = 'PER'.
        numerop  = ls_para-parva.
      ENDLOOP.
    ENDIF.

  ENDIF.
*----------------------------------------------------------------------*
* START-OF-SELECTION
*----------------------------------------------------------------------*
START-OF-SELECTION.
  num = 0.

  REFRESH i_linea.

  SELECT * FROM ekko WHERE ebeln IN p_ebeln
                     AND loekz = space.
    CLEAR r_ekko.
    SELECT SINGLE * FROM lfa1 WHERE lifnr = ekko-lifnr.
    r_ekko-ebeln = ekko-ebeln.
    r_ekko-ihrez = ekko-ihrez.
    r_ekko-verkf = ekko-verkf.
    r_ekko-kdate = ekko-kdate."Plazo de entrega para pedidos cerrados
    r_ekko-lifnr = ekko-lifnr.
    r_ekko-bstyp = ekko-bstyp. "Plan de entrega o pedido cerrado, L ó F
    r_ekko-bedat = ekko-bedat.
    r_ekko-waers = ekko-waers.
    r_ekko-inco1 = ekko-inco1.
    r_ekko-inco2 = ekko-inco2.
    r_ekko-zterm = ekko-zterm.
    r_ekko-spras = ekko-spras.
    r_ekko-knumv = ekko-knumv. "Condición en el caso de pedido cerrado
    r_ekko-angnr = ekko-angnr.
    r_ekko-unsez = ekko-unsez.
    r_ekko-bukrs = ekko-bukrs.
    r_ekko-name1 = lfa1-name1.
    r_ekko-memory = ekko-memory.
    IF ekko-bstyp = 'F'.
      r_ekko-frggr  = ekko-frggr .
      r_ekko-frgrl  = ekko-frgrl.
      ekko-revno = 0.
    ENDIF.
    r_ekko-revno = ekko-revno.
    PERFORM seleccion_posiciones.
*ABIERTOS
    IF r_ekko-bstyp <> 'F'.
      PERFORM seleccion_condiciones.
      PERFORM datos_posiciones_seleccion.
    ELSE.                                "Pedido cerrado
      PERFORM seleccion_condiciones_ped.
      PERFORM datos_posiciones_seleccion_ped.
    ENDIF.
    PERFORM datos_proveedor.

  ENDSELECT.

  PERFORM statuspedido.
  PERFORM impresion_linea.


*&---------------------------------------------------------------------*
*&      Form  CABECERA_DATOS
*&---------------------------------------------------------------------*
* Cabecera de la pantalla de selección de condiciones a imprimir       *
*&---------------------------------------------------------------------*
*&      Form  SELECCION_POSICIONES
*&---------------------------------------------------------------------*
*  Selección de posiciones del plan de entrega o del pedido cerrado    *
* indicado en la pantalla de selección.
*----------------------------------------------------------------------*
FORM seleccion_posiciones.
  REFRESH i_ekpo.
  SELECT * FROM ekpo WHERE ebeln = r_ekko-ebeln
                       AND ( aedat => p_aedat
                        OR  aedat LIKE d_fecha_mod )
                       AND loekz = space.
    CLEAR i_ekpo.
    i_ekpo-ebeln = ekpo-ebeln.
    i_ekpo-ebelp = ekpo-ebelp.
    i_ekpo-banfn = ekpo-banfn.
    i_ekpo-bnfpo = ekpo-bnfpo.

    i_ekpo-inco1 = ekpo-inco1.
    i_ekpo-inco2 = ekpo-inco2.


    i_ekpo-matnr = ekpo-matnr.
    i_ekpo-fplnr = ekpo-fplnr .
    i_ekpo-txz01 = ekpo-txz01.
    i_ekpo-matkl = ekpo-matkl.
    i_ekpo-netpr = ekpo-netpr.         "Precio neto de la posición
    i_ekpo-retpo = ekpo-retpo.
    i_ekpo-peinh = ekpo-peinh.
    i_ekpo-ktmng = ekpo-ktmng.         " Cantidad entrega
    i_ekpo-menge = ekpo-menge.         " Cantidad pedido cerrado
