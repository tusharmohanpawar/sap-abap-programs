*----------------------------------------------------------------------*
FORM statuspedido .
  LOOP AT i_linea.
    indice = sy-tabix.
    i_linea-status = ' '.

    IF i_linea-revno = space AND ( i_linea-bstyp = 'F' OR i_linea-bstyp = 'A' ).
      i_linea-revno = '00000000'.
    ENDIF.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = i_linea-revno
      IMPORTING
        output = i_linea-revno.
*esto para todos los pedidos
    CONCATENATE i_linea-ebeln i_linea-revno INTO vfnum.

*ahora buscamos el wf
    SELECT  * FROM  zhrwfah WHERE wfapli = 'WF_POO' AND  wfnum = vfnum
    ORDER BY aedtm hora_graba ASCENDING.
    ENDSELECT.
    IF sy-subrc = 0.
      CASE zhrwfah-decision.
        WHEN 'CAN'.
          i_linea-status = '@11@'.
        WHEN 'INI'.
          i_linea-status = '@0A@'.
*EN CURSO
        WHEN 'APP' OR 'APC'.
          i_linea-status = '@09@'.

        WHEN 'APT'.
          i_linea-status = '@08@'.
          IF  i_linea-frgrl = 'X'.
            i_linea-status = '@1B@'.
          ENDIF.

      ENDCASE.
    ENDIF.
    i_linea-wfnum = vfnum.
* si el status del pedido no es el correcto corregimos.

    MODIFY i_linea INDEX indice.
  ENDLOOP.
