FORM buscar_vbfa .


  DATA: it_vbfa TYPE vbfa OCCURS 0 WITH HEADER LINE.
  DATA: lin LIKE sy-tabix.


    LOOP AT i_listado ASSIGNING field-symbol(<lf_listado>) .
      CLEAR lin.
      SELECT * FROM vbfa INTO TABLE it_vbfa
               WHERE vbelv = <lf_listado>-vbeln.
        IF sy-subrc = 0.
          DESCRIBE TABLE it_vbfa LINES lin.
          <lf_listado>-cant_vbfa = lin.

          IF <lf_listado>-cant_vbfa >= 99999.
             append value #(  color = value #( col  = 6 int = 0 inv = 0 )  ) to
              <lf_listado>-cell_color.
          ENDIF.

        ENDIF.
    ENDLOOP.

