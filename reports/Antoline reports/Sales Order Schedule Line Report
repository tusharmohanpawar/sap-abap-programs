*&---------------------------------------------------------------------*
*&      Form  check_s_auart
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_F_AUART  text
*----------------------------------------------------------------------*
FORM check_s_auart.
  IF f_vbtyp <> 'N'.
    f_auart = '2'.
    IF s_auart IS INITIAL.
      f_auart = '0'.
    ELSE.
      LOOP AT s_auart.
        IF s_auart-low CS 'LK' AND
           s_auart-sign = 'I' AND s_auart-option = 'EQ'.
        ELSEIF s_auart-low CS 'LZ' AND
               s_auart-sign = 'I' AND s_auart-option = 'EQ'.
        ELSE.
          f_auart = 'N'.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.
ENDFORM.                    " check_s_auart


*&---------------------------------------------------------------------*
*&      Form  check_s_vbtyp
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_F_VBTYP  text
*----------------------------------------------------------------------*
FORM check_s_vbtyp.
  f_vbtyp = '1'.
  IF s_vbtyp IS INITIAL.
    f_vbtyp = '0'.
  ELSE.
    LOOP AT s_vbtyp.
      IF s_vbtyp-low  = 'E' AND s_vbtyp-high = 'F' AND
         s_vbtyp-sign = 'I' AND s_vbtyp-option = 'BT'.
      ELSEIF s_vbtyp-low = 'E' AND
             s_vbtyp-sign = 'I' AND s_vbtyp-option = 'EQ'.
      ELSEIF s_vbtyp-low = 'F' AND
             s_vbtyp-sign = 'I' AND s_vbtyp-option = 'EQ'.
      ELSE.
        f_vbtyp = 'N'.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " check_s_vbtyp


