  READ TABLE i_listado INDEX rs_selfield-tabindex.


  CASE r_ucomm.

    WHEN '&IC1'. " Click sobre algun plan de entregas

      CASE rs_selfield-sel_tab_field.

        WHEN '1-VBELN'. "CLICK SOBRE PLAN ENTREGAS
          IF i_listado-vbeln NE ' '.
            SET PARAMETER ID 'LPN' FIELD i_listado-vbeln.
            SET PARAMETER ID 'VPO' FIELD i_listado-posnr.
