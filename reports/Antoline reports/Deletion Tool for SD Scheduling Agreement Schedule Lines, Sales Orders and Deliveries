*&---------------------------------------------------------------------*
*&      Form  BORRAR_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form borrar_datos .
  data: primer(1),
        sin_datos(1),
        mode(1).

  mode = p_mode.
  refresh: bdcdata, i_log, messtab.
  clear: bdcdata.
  i_repartos[] = i_vbbe[].
  refresh i_vbbe_aux.
  clear i_vbbe_aux.
  loop at i_vbbe where check = 'X'.
    i_vbbe_aux-vbeln = i_vbbe-vbeln.
    i_vbbe_aux-posnr = i_vbbe-posnr.
    i_vbbe_aux-vbtyp = i_vbbe-vbtyp.
    i_vbbe_aux-abart = i_vbbe-abart.
    collect i_vbbe_aux.
  endloop.
  primer = ''.
  loop at i_vbbe_aux.
    w_vbbe = i_vbbe_aux.
    case i_vbbe_aux-vbtyp.
      when 'E' or 'F'.
        perform borrado_plan_entregas using primer sin_datos.
        primer = 'X'.
        at end of vbeln.
          if sin_datos = ''.
            primer = ''.
            perform bdc_dynpro      using 'SAPMV45A' '4001'.
            perform bdc_field       using 'BDC_OKCODE'
                                          '=SICH'.
            call transaction 'VA32' using bdcdata mode  mode messages into messtab.
            perform log.
            refresh: bdcdata.
            clear: bdcdata.
            read table messtab with key msgtyp = 'E'.
            if sy-subrc ne 0.
              delete i_vbbe where vbeln = w_vbbe-vbeln and posnr = w_vbbe-posnr and check = 'X'.
            endif.
          endif.
        endat.
      when 'C' or 'I'.
        perform borrado_pedido using mode.
      when 'J'.
        perform borrado_entrega using mode.
      when others.
        perform mensaje.
    endcase.
  endloop.

* Sacamos el log
  if i_log[] is not initial.
    call screen '0100' starting at 50 10
            ending   at 150 25.

  endif.

endform.                    " BORRAR_DATOS
*&---------------------------------------------------------------------*
*&      Form  BORRADO_PLAN_ENTREGAS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form borrado_plan_entregas using primer sin_datos.
  sin_datos = ''.
* Debemos de borrar tanto los que tengan el ABART = 1 como los ABART = 2
  case i_vbbe_aux-abart.
    when '1'.
      perform borrar_plan_entregas using '1' i_vbbe_aux-vbeln i_vbbe_aux-posnr i_vbbe_aux-prgbz i_vbbe-ezeit primer.
    when '2'.
      perform borrar_plan_entregas using '2' i_vbbe_aux-vbeln i_vbbe_aux-posnr i_vbbe_aux-prgbz i_vbbe-ezeit primer.
    when others.
      sin_datos = 'X'.
      i_log-linea = text-004.
      append i_log.
      clear i_log.
  endcase.
endform.                    " BORRADO_PLAN_ENTREGAS
*&---------------------------------------------------------------------*
*&      Form  BORRADO_PEDIDO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form borrado_pedido using mode.
  data: w_vbak        like vbak,
        w_vbap        like vbap,
        lv_omeng      like vbbe-omeng,
        txt_omeng(15)." type string.
* Miramos el bloqueo de entrega
  select single * from vbak into w_vbak where vbeln = i_vbbe_aux-vbeln.

  select single * from vbap into w_vbap where vbeln = i_vbbe_aux-vbeln and posnr = i_vbbe_aux-posnr.

  loop at i_vbbe where vbeln = i_vbbe_aux-vbeln and posnr = i_vbbe_aux-posnr and check = 'X'.
    lv_omeng = lv_omeng + i_vbbe-omeng.
  endloop.
  if lv_omeng = w_vbap-kwmeng.
* Borramos el pedido
    perform bdc_dynpro      using 'SAPMV45A' '0102'.
    perform bdc_field       using 'BDC_CURSOR'
                                  'VBAK-VBELN'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '/00'.
    perform bdc_field       using 'VBAK-VBELN'
                                   i_vbbe_aux-vbeln.

    if w_vbak-lifsk ne ''.
      perform bdc_dynpro      using 'SAPMV45A' '4001'.
      perform bdc_field       using 'BDC_OKCODE'
                                    '=HEAD'.
      perform bdc_field       using 'BDC_CURSOR'
                                    'RV45A-MABNR(01)'.

      perform bdc_dynpro      using 'SAPMV45A' '4002'.
      perform bdc_field       using 'BDC_OKCODE'
                                    '=T\02'.
      perform bdc_field       using 'BDC_CURSOR'
                                    'VBAK-AUDAT'.

      perform bdc_dynpro      using 'SAPMV45A' '4002'.
      perform bdc_field       using 'BDC_OKCODE'
                                    '/EBACK'.
      perform bdc_field       using 'BDC_CURSOR'
                                    'VBAK-LIFSK'.
      perform bdc_field       using 'VBAK-LIFSK'
                                    ''.
    endif.
    perform bdc_dynpro      using 'SAPMV45A' '4001'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '/ELOES'.
  else.
* Si las cantidades son diferentes modificamos la cantidad del pedido
    perform bdc_dynpro      using 'SAPMV45A' '0102'.
    perform bdc_field       using 'BDC_CURSOR'
                                  'VBAK-VBELN'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '/00'.
    perform bdc_field       using 'VBAK-VBELN'
                                  i_vbbe_aux-vbeln.

    perform bdc_dynpro      using 'SAPMV45A' '4001'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=POPO'.

    perform bdc_dynpro      using 'SAPMV45A' '0251'.
    perform bdc_field       using 'BDC_CURSOR'
                                  'RV45A-POSNR'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=POSI'.
    perform bdc_field       using 'RV45A-POSNR'
                                   i_vbbe_aux-posnr.

    perform bdc_dynpro      using 'SAPMV45A' '4001'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=SICH'.
    perform bdc_field       using 'BDC_CURSOR'
                                  'RV45A-KWMENG(01)'.
    write lv_omeng to txt_omeng unit i_vbbe-meins.
*   REPLACE '.' WITH ',' INTO txt_omeng.
    perform bdc_field       using 'RV45A-KWMENG(01)'
                                  txt_omeng.
  endif.

  call transaction 'VA02' using bdcdata mode mode messages into messtab.
  perform log.
  refresh: bdcdata.
  clear: bdcdata.
  read table messtab with key msgtyp = 'E'.
  if sy-subrc ne 0.
    delete i_vbbe where vbeln = w_vbbe-vbeln and posnr = w_vbbe-posnr and check = 'X'.
  endif.
endform.                    " BORRADO_PEDIDO
*&---------------------------------------------------------------------*
*&      Form  BORRADO_ENTREGA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form borrado_entrega using mode.
  data: w_lips    like lips,
        w_likp    like likp,
        answer(1),
        w_comwa	  like vbco3,
        t_vbplp   type table of vbplp with header line.
  select single * from lips into w_lips where vbeln = i_vbbe_aux-vbeln and posnr = i_vbbe_aux-posnr.
  if sy-subrc = 0.
    select single * from likp into w_likp where vbeln = w_lips-vbeln.
    if sy-subrc = 0.
      read table i_vbbe with key vbeln = i_vbbe_aux-vbeln
                                 posnr = i_vbbe_aux-posnr
                                 check = 'X'.
      if w_likp-lfdat = i_vbbe-mbdat.
* Comprobamos si la entrega tiene embalajes
        w_comwa-packd = 'X'.
        w_comwa-vbeln = w_lips-vbeln.
        call function 'ZSD_DELIVERY_VIEW'
          exporting
            comwa = w_comwa
*         IMPORTING
*           VBPLA_WA       =
          tables
*           VBDKL =
*           VBDPL =
*           VBPLK =
            vbplp = t_vbplp
*           VBPLS =
*           SERNOS         =
*           RETURN         =
*           ZSD001         =
          .

        read table t_vbplp index 1.
        if sy-subrc = 0.
          call function 'POPUP_TO_CONFIRM'
            exporting
              text_question  = text-007
            importing
              answer         = answer
*         TABLES
*             PARAMETER      =
            exceptions
              text_not_found = 1
              others         = 2.
          if answer = '1'.
* Tiene embalaje por lo que tenemos que borrar los embalajes primero
            perform borrar_embalaje using w_lips-vbeln.
          endif.
        endif.

        call function 'POPUP_TO_CONFIRM'
          exporting
            text_question  = text-005
          importing
            answer         = answer
*         TABLES
*           PARAMETER      =
          exceptions
            text_not_found = 1
            others         = 2.
        if answer = '1'.
* Borramos la entrega
          perform bdc_dynpro      using 'SAPMV50A' '4004'.
          perform bdc_field       using 'BDC_CURSOR'
                                        'LIKP-VBELN'.
          perform bdc_field       using 'BDC_OKCODE'
                                        '/00'.
          perform bdc_field       using 'LIKP-VBELN'
                                         w_likp-vbeln.

          perform bdc_dynpro      using 'SAPMV50A' '1000'.
          perform bdc_field       using 'BDC_OKCODE'
                                        '/ELOES_T'.

          call transaction 'VL02N' using bdcdata mode mode messages into messtab.
          perform log.
          refresh: bdcdata.
          clear: bdcdata.
          read table messtab with key msgtyp = 'E'.
          if sy-subrc ne 0.
            delete i_vbbe where vbeln = w_vbbe-vbeln and posnr = w_vbbe-posnr and check = 'X'.
          endif.
        endif.
      else.
        i_log-linea = text-003.
        append i_log.
        clear i_log.
      endif.
    endif.
  endif.
endform.                    " BORRADO_ENTREGA
