*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form seleccion.
  data: lv_prgrs like vbep-prgrs,
        lv_vkorg LIKE tvko-vkorg.

  select * from vbbe into corresponding fields of table i_vbbe where vbeln in s_vbeln AND posnr IN s_posnr and werks = p_werks and mbdat in s_mbdat and kunnr in s_kunnr and matnr in s_matnr.
* ABG Inc 312176 05.10.2020
  IF s_kdmat[] IS NOT INITIAL.
    LOOP AT i_vbbe.
      SELECT SINGLE vkorg FROM tvko INTO lv_vkorg WHERE bukrs = i_vbbe-werks.
      IF sy-subrc = 0.

        SELECT SINGLE * FROM knmt WHERE vkorg = lv_vkorg
                                    AND kunnr = i_vbbe-kunnr
                                    AND matnr = i_vbbe-matnr
                                    AND kdmat IN s_kdmat.
        IF sy-subrc NE 0.
          DELETE i_vbbe.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.
* ABG Inc 312176 05.10.2020
  loop at i_vbbe.
    select single abart prgrs edatu ezeit from vbep into (i_vbbe-abart, lv_prgrs, i_vbbe-edatu, i_vbbe-ezeit) where vbeln = i_vbbe-vbeln and posnr = i_vbbe-posnr and etenr = i_vbbe-etenr.
    select single prgbz from tprg into i_vbbe-prgbz where prgrs = lv_prgrs and spras = sy-langu.
    if i_vbbe-auart is initial.
      select single auart from vbak into i_vbbe-auart where vbeln = i_vbbe-vbeln.
    endif.
*-------------WSDEVERP-1654--------24/01/2025------------------
 select single abrdt from vblb into i_vbbe-ab_abrdt where vbeln = i_vbbe-vbeln and posnr = i_vbbe-posnr and abrli  = 0 and  abart = '2'.

 select single abrdt from vblb into i_vbbe-erdat where vbeln = i_vbbe-vbeln and posnr = i_vbbe-posnr and abrli  = 0 and  abart = '1'.

*-------------WSDEVERP-1654--------24/01/2025------FIN---------
    modify i_vbbe.
  endloop.


endform.                    " SELECCION
