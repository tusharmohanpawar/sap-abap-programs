*&---------------------------------------------------------------------*
*&      Form  BORRAR_PLAN_ENTREGAS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
form borrar_plan_entregas using p_abart p_vbeln p_posnr p_prgbz p_ezeit p_primer.
  data: tipo_reparto(10),
        lv_fecha(10),"         type string,
        week             like scal-week,
        prgrs            like tprg-prgrs.
  if p_primer = ''.
    perform bdc_dynpro      using 'SAPMV45A' '0125'.

    perform bdc_field       using 'BDC_OKCODE'
                                  '/00'.
    perform bdc_field       using 'VBAK-VBELN'
                                   p_vbeln.
  endif.
  perform bdc_dynpro      using 'SAPMV45A' '4001'.
  perform bdc_field       using 'BDC_OKCODE'
                                '=POPO'.

  perform bdc_dynpro      using 'SAPMV45A' '0251'.
  perform bdc_field       using 'BDC_OKCODE'
                                '=POSI'.

  perform bdc_field       using 'RV45A-POSNR'
                                 p_posnr.

  if p_abart = '1'.  "orden entrega por suministro.
    tipo_reparto = '=PLEI'.
  else.              "OFH
    tipo_reparto = '=PFEI'.
  endif.

  perform bdc_dynpro      using 'SAPMV45A' '4001'.
  perform bdc_field       using 'BDC_OKCODE'
                                 tipo_reparto.

  perform bdc_field       using 'BDC_CURSOR'
                                'VBAP-POSNR(01)'.
  perform bdc_field       using 'RV45A-VBAP_SELKZ(01)'
                                'X'.
  loop at i_repartos where vbeln = p_vbeln and posnr = p_posnr and check = 'X' and abart = p_abart.
    perform bdc_dynpro      using 'SAPMV45A' '4003'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=EIPO'. "posicionar

    perform bdc_dynpro      using 'SAPMV45A' '0252'.
    perform bdc_field       using 'BDC_CURSOR'
                                  'RV45A-ETDAT'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=POSI'. "posicionar
    perform bdc_field       using 'RV45A-PRGBZ'
                                   i_repartos-prgbz.
    case  i_repartos-prgbz.
      when 'D' OR 'T'.
        prgrs = 1.
      when'W'.
        prgrs = 2.
      when 'M'.
        prgrs = 3.
    endcase.


    call function 'PERIOD_AND_DATE_CONVERT_OUTPUT'
      exporting
        internal_date   = i_repartos-edatu
        internal_period = prgrs
      importing
        external_date   = lv_fecha
      exceptions
        date_invalid    = 1
        periode_invalid = 2
        others          = 3.


    perform bdc_field       using 'RV45A-ETDAT'
                                   lv_fecha.
    perform bdc_field       using 'VBEP-EZEIT'
                                   i_repartos-ezeit."p_ezeit. Inc 457128
    perform bdc_dynpro      using 'SAPMV45A' '4003'.
    perform bdc_field       using 'BDC_OKCODE'
                                  '=EILO'.
  endloop.
  perform bdc_dynpro      using 'SAPMV45A' '4003'.
  perform bdc_field       using 'BDC_OKCODE'
                                '=BACK'.
endform.                    " BORRAR_PLAN_ENTREGAS
