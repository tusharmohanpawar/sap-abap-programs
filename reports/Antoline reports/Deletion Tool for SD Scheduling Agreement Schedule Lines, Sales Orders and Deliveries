  data: begin of ls_para occurs 30.
      include    structure usparam.
  data: end of  ls_para.
  call function 'SUSR_USER_PARAMETERS_GET'
    exporting
      user_name       = sy-uname
    tables
      user_parameters = ls_para.
  if sy-subrc = 0.
    read table  ls_para with key parid = 'ZTI'.
    if sy-subrc <> 0 or ls_para-parva = space.
      loop at screen.
        if screen-name = 'P_MODE' or screen-name = '%_P_MODE_%_APP_%-TEXT'.
          screen-invisible = 1.
          screen-input = 0.
          screen-active = 0.
          modify screen.
        endif.
      endloop.
    endif.
  endif.

